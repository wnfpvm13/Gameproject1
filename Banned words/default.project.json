{
  "name": "BannedWords",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "BannedWords": {
        "$className": "Folder",
        "Config": { "$path": "src/shared/Config.luau" },
        "Judge": { "$path": "src/shared/Judge.luau" }
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "BannedWords": {
        "$className": "Folder",
        "Main": { "$path": "src/server/Main.server.luau" },
        "RoundService": { "$path": "src/server/RoundService.luau" },
        "SeatService": { "$path": "src/server/SeatService.luau" },
        "WordBank": { "$path": "src/server/WordBank.luau" }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "BannedWordsClient": {
          "$path": "src/client/Main.client.luau",
          "Hud": { "$path": "src/client/Hud.luau" },
          "Billboards": { "$path": "src/client/Billboards.luau" },
          "Speech": { "$path": "src/client/Speech.luau" }
        }
      }
    },
    "VoiceChatService": {
      "$properties": { "UseAudioApi": "Enabled" }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true
    }
  }
}
