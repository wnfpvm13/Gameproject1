do local s = Instance.new("ModuleScript"); s.Name = "SeatService"; s.Source = [====[--!strict
-- Chairs in a ring around the lounge centre: seat participants (spread evenly), keep them seated during a round,
-- and launch whoever says a word: up and outward over the ring, then "펑" (hidden + killed at the top of the arc).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("BannedWords"):WaitForChild("Config"))

local SeatService = {}

local DEFAULT_JUMP_HEIGHT = 7.2
local LAUNCH_UP = 80 -- studs/s upward (top of the arc after ~0.4 s, about 16 studs high)
local LAUNCH_OUT = 16 -- studs/s away from the centre

local assigned: { [Seat]: Humanoid } = {}
local locked = false

local function map(): Instance
	return workspace:WaitForChild("LoungeMap")
end

-- Seats ordered by SeatIndex (1..N clockwise around the ring).
function SeatService.getSeats(): { Seat }
	local seats = {}
	for _, chair in map():WaitForChild("Chairs"):GetChildren() do
		local seat = chair:FindFirstChildWhichIsA("Seat")
		if seat then
			table.insert(seats, seat)
		end
	end
	table.sort(seats, function(a, b)
		return (a:GetAttribute("SeatIndex") or 0) < (b:GetAttribute("SeatIndex") or 0)
	end)
	return seats
end

function SeatService.center(): Vector3
	local marker = map():FindFirstChild("Center") :: BasePart?
	return if marker then marker.Position else Vector3.zero
end

local function sit(seat: Seat, humanoid: Humanoid)
	local character = humanoid.Parent :: Model
	character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
	seat:Sit(humanoid)
end

-- Only the assigned humanoid may occupy a chair; anyone else is ejected, and a locked participant is re-seated.
local function watch(seat: Seat)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant
		local owner = assigned[seat]
		if occupant and occupant ~= owner then
			occupant.Sit = false
		elseif not occupant and owner and locked and owner.Health > 0 then
			task.defer(function()
				if assigned[seat] == owner and locked and owner.Parent then
					sit(seat, owner)
				end
			end)
		end
	end)
end

function SeatService.init()
	for _, seat in SeatService.getSeats() do
		seat.Disabled = true
		watch(seat)
	end
end

-- Spread n players evenly around the ring (2 players sit opposite each other). Returns the seat per player.
function SeatService.seatPlayers(players: { Player }): { [Player]: Seat }
	local seats = SeatService.getSeats()
	local result: { [Player]: Seat } = {}
	local n = math.min(#players, #seats)
	for i = 1, n do
		local player = players[i]
		local seat = seats[math.floor((i - 1) * #seats / n) + 1]
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if seat and humanoid and humanoid.Health > 0 then
			assigned[seat] = humanoid
			seat.Disabled = false
			humanoid.UseJumpPower = false
			humanoid.JumpHeight = 0
			sit(seat, humanoid)
			result[player] = seat
		end
	end
	locked = true
	return result
end

function SeatService.releaseAll()
	locked = false
	for seat, humanoid in assigned do
		if humanoid.Parent then
			humanoid.JumpHeight = DEFAULT_JUMP_HEIGHT
			humanoid.Sit = false
		end
		seat.Disabled = true
	end
	table.clear(assigned)
end

local function hide(character: Model)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end
end

-- Up and outward from the chair; at LAUNCH_POP_TIME the body vanishes (clients play the "펑") and dies.
function SeatService.launch(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (character and humanoid and root) then
		return
	end
	for seat, owner in assigned do
		if owner == humanoid then
			assigned[seat] = nil
			seat.Disabled = true
			-- The seat weld must be gone before the impulse, or the chair absorbs most of it.
			local weld = seat:FindFirstChild("SeatWeld")
			if weld then
				weld:Destroy()
			end
		end
	end
	humanoid.Sit = false
	humanoid.PlatformStand = true
	root:SetNetworkOwner(nil)

	task.spawn(function()
		RunService.Heartbeat:Wait()
		local outward = root.Position - SeatService.center()
		outward = Vector3.new(outward.X, 0, outward.Z)
		outward = if outward.Magnitude > 0.1 then outward.Unit else Vector3.new(0, 0, 1)
		root.AssemblyLinearVelocity = outward * LAUNCH_OUT + Vector3.new(0, LAUNCH_UP, 0)
		root.AssemblyAngularVelocity = Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
		task.wait(Config.LAUNCH_POP_TIME)
		if humanoid.Parent then
			root.Anchored = true
			hide(character)
			humanoid.Health = 0
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	for seat, humanoid in assigned do
		if humanoid.Parent == player.Character then
			assigned[seat] = nil
			seat.Disabled = true
		end
	end
end)

return SeatService
]====]; s.Parent = n4 end
do local s = Instance.new("ModuleScript"); s.Name = "VoiceService"; s.Source = [====[--!strict
-- Voice routing.
-- 1. Flat volume: default voice creates each character's AudioEmitter on the server with a 7-80 stud rolloff;
--    the flat curve set here replicates to every listener (src/client/FlatVoice.luau covers client-made emitters).
-- 2. Ghosts and spectators are silent to the table: during a round they know every word, so their
--    AudioDeviceInput is only audible to other ghosts/spectators (design V2 §6.2).
local Players = game:GetService("Players")

local VoiceService = {}

local FLAT_CURVE = { [0] = 1, [2000] = 1 }

local speakers: { [number]: boolean }? = nil -- userIds allowed to talk to the table; nil = no round, everyone open

local function flatten(child: Instance)
	if child:IsA("AudioEmitter") then
		child:SetDistanceAttenuation(FLAT_CURVE)
	end
end

local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		flatten(child)
	end
	character.ChildAdded:Connect(flatten)
end

local function inputOf(player: Player): AudioDeviceInput?
	return player:FindFirstChildOfClass("AudioDeviceInput")
end

local function apply()
	local spectatorIds = {}
	for _, player in Players:GetPlayers() do
		if speakers and not speakers[player.UserId] then
			table.insert(spectatorIds, player.UserId)
		end
	end
	for _, player in Players:GetPlayers() do
		local input = inputOf(player)
		if input then
			if speakers == nil or speakers[player.UserId] then
				input.AccessType = Enum.AccessModifierType.Deny
				input:SetUserIdAccessList({}) -- nobody denied: the whole server hears
			else
				input.AccessType = Enum.AccessModifierType.Allow
				input:SetUserIdAccessList(spectatorIds) -- only fellow spectators hear
			end
		end
	end
end

-- Round on: only `userIds` (alive participants) are heard by everyone. nil = round over, everyone open.
function VoiceService.setSpeakers(userIds: { number }?)
	if userIds then
		local set = {}
		for _, id in userIds do
			set[id] = true
		end
		speakers = set
	else
		speakers = nil
	end
	apply()
end

function VoiceService.start()
	local function watchPlayer(player: Player)
		if player.Character then
			watchCharacter(player.Character)
		end
		player.CharacterAdded:Connect(watchCharacter)
		player.ChildAdded:Connect(function(child)
			if child:IsA("AudioDeviceInput") then
				apply()
			end
		end)
	end
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(function(player)
		watchPlayer(player)
		apply() -- a newcomer is a spectator until the next round
	end)
end

return VoiceService
]====]; s.Parent = n4 end
do local s = Instance.new("ModuleScript"); s.Name = "WordService"; s.Source = [====[--!strict
-- Forbidden words: first word at the start, then one more for everyone alive at WORD_STEPS (max 3 words),
-- and what each viewer may see. Nobody ever receives their own words while alive.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))
local Net = require(script.Parent.Parent:WaitForChild("Net"))
local WordBank = require(script.Parent.Parent:WaitForChild("content"):WaitForChild("WordBank"))

local WordService = {}

local function addWord(p: Match.Participant, kind: "noun" | "habit", effectiveAt: number, rng: Random): boolean
	local entry = WordBank.draw(kind, Match.reservedTexts(), rng)
	if not entry then
		return false
	end
	table.insert(p.words, { text = entry.word, aliases = entry.aliases, effectiveAt = effectiveAt })
	return true
end

-- One noun per participant, none overlapping another.
function WordService.assignFirst(rng: Random)
	for _, p in Match.participants do
		addWord(p, "noun", 0, rng)
	end
end

-- What `viewer` sees: { [userId] = { words = {...} | nil (own, while alive), count = n } }.
-- Words become visible at their effective time, so nobody can steer toward a word before it counts.
function WordService.payloadFor(viewer: Player)
	local now = Match.now()
	local result = {}
	for player, p in Match.participants do
		local visible = {}
		for _, word in p.words do
			if word.effectiveAt <= now then
				table.insert(visible, word.text)
			end
		end
		local hidden = player == viewer and p.alive and Match.phase ~= "Result"
		result[tostring(player.UserId)] = { words = if hidden then nil else visible, count = #visible }
	end
	return result
end

function WordService.send(player: Player)
	Net.to(player, "Words", WordService.payloadFor(player))
end

function WordService.sendAll()
	for _, player in Players:GetPlayers() do
		WordService.send(player)
	end
end

-- Runs alongside the talk: warns, then adds a word to everyone alive. `stillTalking()` stops it,
-- `onAdded()` runs after each new word (the host re-checks its cards).
-- A burst of eliminations (2+ in WORD_DELAY_WINDOW) pushes the step back, also after the warning, up to WORD_DELAY_MAX.
function WordService.runSchedule(talkSeconds: number, stillTalking: () -> boolean, onAdded: () -> (), rng: Random)
	local start = Match.now()
	for index, fraction in Config.WORD_STEPS do
		local wordCount = index + 1
		local effectiveAt = start + talkSeconds * fraction
		local delayed = 0
		local warned = false
		local lastCheck = os.clock()
		while true do
			if not stillTalking() then
				return
			end
			local burst = Match.recentLaunches(Config.WORD_DELAY_WINDOW) >= 2
			if burst and delayed < Config.WORD_DELAY_MAX and Match.now() >= effectiveAt - Config.WORD_WARNING then
				local step = os.clock() - lastCheck
				delayed += step
				effectiveAt += step
				if warned and math.floor(delayed) ~= math.floor(delayed - step) then
					Net.toAll("WordWarn", { at = effectiveAt, count = wordCount }) -- the countdown moves back (1/s)
				end
			end
			lastCheck = os.clock()
			if effectiveAt > Match.endsAt - Config.WORD_WARNING then
				if warned then
					Net.toAll("WordWarn", { at = 0, count = wordCount }) -- cancelled
				end
				return -- too close to the end to matter
			end
			if not warned and Match.now() >= effectiveAt - Config.WORD_WARNING then
				warned = true
				Net.toAll("WordWarn", { at = effectiveAt, count = wordCount })
			end
			if Match.now() >= effectiveAt then
				break -- checked above in this same step: still talking, no burst delay pending
			end
			task.wait(0.25)
		end
		local kind: "noun" | "habit" = if wordCount == 3 and rng:NextNumber() < Config.HABIT_WORD_CHANCE then "habit" else "noun"
		for _, p in Match.participants do
			if p.alive then
				addWord(p, kind, effectiveAt, rng)
			end
		end
		WordService.sendAll()
		onAdded()
		Net.notice(string.format("금칙어가 %d개가 됐어요! 머리 위를 다시 확인하세요", wordCount))
	end
end

return WordService
