do local s = Instance.new("ModuleScript"); s.Name = "Speech"; s.Source = [====[--!strict
-- Transcribes the local player's own mic. Roblox only runs AudioSpeechToText on clients, so every client
-- transcribes itself and the server judges. Voice starts disconnected (since 2026-01): AudioDeviceInput.Active
-- stays false until the player connects voice from the in-experience settings menu.
local Players = game:GetService("Players")

local Speech = {}

export type Status = "NoVoice" | "Disconnected" | "Muted" | "Listening" | "Speaking"

local input: AudioDeviceInput? = nil
local stt: AudioSpeechToText? = nil
local statusListeners: { (Status) -> () } = {}
local textListeners: { (string) -> () } = {}

function Speech.status(): Status
	if not input then
		return "NoVoice"
	elseif not input.Active then
		return "Disconnected"
	elseif input.Muted then
		return "Muted"
	elseif stt and stt.VoiceDetected then
		return "Speaking"
	end
	return "Listening"
end

local function emitStatus()
	local s = Speech.status()
	for _, fn in statusListeners do
		fn(s)
	end
end

function Speech.onStatus(fn: (Status) -> ())
	table.insert(statusListeners, fn)
	fn(Speech.status())
end

function Speech.onText(fn: (string) -> ())
	table.insert(textListeners, fn)
end

function Speech.start(parent: Instance)
	local player = Players.LocalPlayer
	input = player:WaitForChild("AudioDeviceInput", 30) :: AudioDeviceInput?
	if not input then
		emitStatus()
		return
	end
	local recognizer = Instance.new("AudioSpeechToText")
	recognizer.Enabled = true
	recognizer.Parent = parent
	stt = recognizer
	local wire = Instance.new("Wire")
	wire.SourceInstance = input
	wire.TargetInstance = recognizer
	wire.Parent = recognizer

	recognizer:GetPropertyChangedSignal("Text"):Connect(function()
		local text = recognizer.Text
		if text == "" then
			return
		end
		recognizer.Text = ""
		for _, fn in textListeners do
			fn(text)
		end
	end)
	recognizer:GetPropertyChangedSignal("VoiceDetected"):Connect(emitStatus)
	input:GetPropertyChangedSignal("Active"):Connect(emitStatus)
	input:GetPropertyChangedSignal("Muted"):Connect(emitStatus)
	emitStatus()
end

return Speech
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "ShowCamera"; s.Source = [====[--!strict
-- Fixed panel-show camera: while a round runs, everyone looks at the chair row from over the pool,
-- so every face and forbidden word is on one screen.
local ShowCamera = {}

local DEFAULT_FOV = 70
local active = false

local function point(): BasePart?
	local map = workspace:FindFirstChild("PoolMap")
	return map and map:FindFirstChild("ShowCamera") :: BasePart?
end

function ShowCamera.set(on: boolean)
	local camera = workspace.CurrentCamera
	local marker = point()
	if on and marker then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = marker.CFrame
		camera.FieldOfView = marker:GetAttribute("FieldOfView") or DEFAULT_FOV
	elseif active then
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = DEFAULT_FOV
	end
	active = on and marker ~= nil
end

function ShowCamera.reapply()
	if active then
		ShowCamera.set(true)
	end
end

return ShowCamera
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "FlatVoice"; s.Source = [====[--!strict
-- Everyone hears everyone at the same volume, wherever they are on the map (owner decision 2026-10-17).
-- Default voice (UseAudioApi) wires each AudioDeviceInput into an AudioEmitter inside the character with a
-- quadratic 7-80 stud rolloff; audibility is computed on the listening client, so flattening the curve here is enough.
local Players = game:GetService("Players")

local FlatVoice = {}

local FLAT_CURVE = { [0] = 1, [2000] = 1 }

local function flatten(emitter: Instance)
	if emitter:IsA("AudioEmitter") then
		emitter:SetDistanceAttenuation(FLAT_CURVE)
	end
end

local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		flatten(child)
	end
	character.ChildAdded:Connect(flatten)
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
end

function FlatVoice.start()
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
end

return FlatVoice
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "Fx"; s.Source = [====[--!strict
-- Elimination effects (KBS 위험한 초대 flying-chair style): buzzer, red screen flash, splash when the body hits the water.
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("BannedWords"):WaitForChild("Config"))

local Fx = {}

local flash: Frame
local buzzer: Sound

function Fx.init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "BannedWordsFx"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Parent = gui

	buzzer = Instance.new("Sound")
	buzzer.Name = "Buzzer"
	buzzer.SoundId = Config.SOUND_BUZZER
	buzzer.Volume = 0.6
	buzzer.Parent = SoundService
end

local function redFlash()
	flash.BackgroundTransparency = 0.55
	TweenService:Create(flash, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
end

local function splashAt(position: Vector3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = position
	anchor.Parent = workspace

	local drops = Instance.new("ParticleEmitter")
	drops.Color = ColorSequence.new(Color3.fromRGB(220, 245, 255))
	drops.LightEmission = 0.3
	drops.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	drops.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	drops.Lifetime = NumberRange.new(0.7, 1.2)
	drops.Speed = NumberRange.new(22, 38)
	drops.SpreadAngle = Vector2.new(28, 28)
	drops.Acceleration = Vector3.new(0, -70, 0)
	drops.EmissionDirection = Enum.NormalId.Top
	drops.Rate = 0
	drops.Parent = anchor
	drops:Emit(70)

	local sound = Instance.new("Sound")
	sound.SoundId = Config.SOUND_SPLASH
	sound.Volume = 0.9
	sound.RollOffMaxDistance = 400
	sound.Parent = anchor
	sound:Play()

	task.delay(4, function()
		anchor:Destroy()
	end)
end

-- Called when anyone is launched: buzzer + red flash now, splash where the body lands.
function Fx.elimination(player: Player?)
	buzzer:Play()
	redFlash()
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local map = workspace:FindFirstChild("PoolMap")
	local center = map and map:FindFirstChild("PoolCenter") :: BasePart?
	local waterY = if center then center.Position.Y else -1.5
	task.delay(Config.LAUNCH_FLIGHT_TIME, function()
		local p = if root.Parent then root.Position else Vector3.zero
		splashAt(Vector3.new(p.X, waterY, p.Z))
	end)
end

return Fx
