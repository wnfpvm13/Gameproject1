do local s = Instance.new("ModuleScript"); s.Name = "HostPanel"; s.Source = [====[--!strict
-- What the assistant host shows: a topic card on the left edge (clear of the mobile thumbstick bottom-left and
-- the chat top-left), an event banner and the new-word countdown over the centre table (the emptiest part of
-- the seated view). The theme and my role are in the status board (Hud).
local TweenService = game:GetService("TweenService")

local Style = require(script.Parent:WaitForChild("Style"))

local HostPanel = {}

local EVENT_SECONDS = 7

local topicCard: Frame
local topicL: TextLabel
local eventL: TextLabel
local warnL: TextLabel
local warnAt = 0
local warnCount = 0

function HostPanel.build()
	local gui = Style.gui()

	topicCard = Style.panel(gui, Style.CARD, 0.05, 14)
	topicCard.AnchorPoint = Vector2.new(0, 0.5)
	topicCard.Position = UDim2.new(0, 16, 0.5, 0)
	topicCard.Size = UDim2.new(0.26, 0, 0, 84)
	topicCard.Visible = false
	Style.limit(topicCard, Vector2.new(220, 0), Vector2.new(360, 120))
	local title = Style.label(topicCard, Style.BOLD, 16, Color3.fromRGB(200, 90, 40))
	title.Position = UDim2.fromScale(0.06, 0.06)
	title.Size = UDim2.fromScale(0.88, 0.3)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "이야깃거리"
	topicL = Style.label(topicCard, Style.BOLD, 22, Style.INK)
	topicL.Position = UDim2.fromScale(0.06, 0.38)
	topicL.Size = UDim2.fromScale(0.88, 0.56)
	topicL.TextXAlignment = Enum.TextXAlignment.Left

	eventL = Style.label(gui, Style.HEAVY, 30, Style.AMBER)
	eventL.AnchorPoint = Vector2.new(0.5, 0.5)
	eventL.Position = UDim2.fromScale(0.5, 0.62)
	eventL.Size = UDim2.new(0.7, 0, 0, 44)
	eventL.TextStrokeTransparency = 0.3
	eventL.TextTransparency = 1
	eventL.TextStrokeTransparency = 1

	warnL = Style.label(gui, Style.HEAVY, 36, Style.RED)
	warnL.AnchorPoint = Vector2.new(0.5, 0.5)
	warnL.Position = UDim2.fromScale(0.5, 0.71)
	warnL.Size = UDim2.new(0.7, 0, 0, 48)
	warnL.TextStrokeTransparency = 0.3
end

function HostPanel.showTopic(text: string)
	topicL.Text = text
	topicCard.Visible = true
end

function HostPanel.showEvent(text: string)
	eventL.Text = "📢 " .. text
	eventL.TextTransparency = 0
	eventL.TextStrokeTransparency = 0.3
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, EVENT_SECONDS)
	TweenService:Create(eventL, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end

function HostPanel.warnWord(at: number, count: number)
	warnAt = at
	warnCount = count
end

-- Every frame: the new-word countdown.
function HostPanel.tick(now: number)
	local left = warnAt - now
	warnL.Text = if left > 0 then string.format("%d초 뒤 금칙어가 %d개로 늘어나요!", math.ceil(left), warnCount) else ""
end

-- A card on screen now contains a word in play (a new word was added): take it down.
function HostPanel.hide(which: string)
	if which == "topic" then
		topicCard.Visible = false
	else
		eventL.TextTransparency = 1
		eventL.TextStrokeTransparency = 1
	end
end

function HostPanel.clear()
	topicCard.Visible = false
	eventL.TextTransparency = 1
	eventL.TextStrokeTransparency = 1
	warnAt = 0
end

return HostPanel
]====]; s.Parent = n6 end
do local s = Instance.new("ModuleScript"); s.Name = "Hud"; s.Source = [====[--!strict
-- Status board at the top centre: phase + message (+ my role), timer, survivors, and how many words I have
-- (never which). Kept short (64 px) so the far side of the ring stays visible under it.
local Style = require(script.Parent:WaitForChild("Style"))

local Hud = {}

local PHASE_TITLE = {
	Lobby = "대기 중",
	Countdown = "곧 시작",
	Assign = "금칙어 배정",
	Talk = "대화 중",
	Result = "결과",
}

local statusL: TextLabel
local timerL: TextLabel
local aliveL: TextLabel
local mineL: TextLabel

function Hud.build()
	local top = Style.panel(Style.gui(), Style.PANEL, 0.2, 14)
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 8)
	top.Size = UDim2.new(0.5, 0, 0, 64)
	Style.limit(top, Vector2.new(320, 0), Vector2.new(580, 200))

	statusL = Style.label(top, Style.BOLD, 22, Style.WHITE)
	statusL.Position = UDim2.fromScale(0.04, 0.06)
	statusL.Size = UDim2.fromScale(0.92, 0.46)
	timerL = Style.label(top, Style.BOLD, 22, Style.AMBER)
	timerL.Position = UDim2.fromScale(0.04, 0.55)
	timerL.Size = UDim2.fromScale(0.28, 0.38)
	timerL.TextXAlignment = Enum.TextXAlignment.Left
	mineL = Style.label(top, Style.BOLD, 20, Style.AMBER)
	mineL.Position = UDim2.fromScale(0.32, 0.55)
	mineL.Size = UDim2.fromScale(0.36, 0.38)
	aliveL = Style.label(top, Style.REGULAR, 20, Style.GREY)
	aliveL.Position = UDim2.fromScale(0.68, 0.55)
	aliveL.Size = UDim2.fromScale(0.28, 0.38)
	aliveL.TextXAlignment = Enum.TextXAlignment.Right
end

function Hud.setStatus(phase: string, message: string, myRole: string?)
	local text = (PHASE_TITLE[phase] or phase) .. (if message ~= "" then " · " .. message else "")
	if myRole then
		text ..= " · 내 역할: " .. myRole
	end
	statusL.Text = text
end

function Hud.setTimer(seconds: number?)
	if not seconds then
		timerL.Text = ""
		return
	end
	local s = math.max(0, math.ceil(seconds))
	timerL.Text = string.format("%d:%02d", s // 60, s % 60)
	timerL.TextColor3 = if s <= 30 then Style.RED else Style.AMBER
end

function Hud.setAlive(alive: number, total: number)
	aliveL.Text = if total > 0 then string.format("생존 %d / %d", alive, total) else ""
end

-- count = 0 hides it (not playing).
function Hud.setMyWords(count: number)
	mineL.Text = if count > 0 then string.format("내 금칙어 ??? × %d", count) else ""
end

return Hud
]====]; s.Parent = n6 end
do local s = Instance.new("ModuleScript"); s.Name = "MicPanel"; s.Source = [====[--!strict
-- Voice connection and mic test lines (rows 0 and 1 under the status board), plus the earphone tip.
-- Both are empty while I play with a working mic, so nothing covers the ring.
local Style = require(script.Parent:WaitForChild("Style"))

local MicPanel = {}

local voiceL: TextLabel
local testL: TextLabel

function MicPanel.build()
	voiceL = Style.line(0, Style.RED)
	testL = Style.line(1, Style.AMBER)
end

function MicPanel.setVoice(status: string)
	if status == "NoVoice" then
		voiceL.Text = "음성 채팅을 쓸 수 없는 계정이에요 (만 13세 이상 + 연령 인증 필요)"
	elseif status == "Disconnected" then
		voiceL.Text = "음성 채팅 연결 필요 · 왼쪽 위 ≡ 메뉴(또는 ESC) → 설정 → 음성 채팅 연결"
	elseif status == "Muted" then
		voiceL.Text = "마이크가 꺼져 있어요"
	else
		voiceL.Text = ""
	end
end

-- What the player should do next to take a seat. `inMyRound` hides it while I'm playing.
function MicPanel.setTest(status: string, micTested: boolean, inMyRound: boolean, readyCount: number?)
	local text, done = "", false
	if inMyRound then
		text = ""
	elseif status == "NoVoice" then
		text = "음성 채팅을 쓸 수 없는 계정이라 관전만 할 수 있어요"
	elseif status == "Disconnected" then
		text = "음성을 연결하면 다음 판부터 참가할 수 있어요"
	elseif status == "Muted" then
		text = "마이크를 켜 주세요"
	elseif not micTested then
		text = "마이크 테스트 · 아무 말이나 해 보세요"
	else
		done = true
		local ready = if readyCount then string.format("준비 완료! (준비된 사람 %d명)", readyCount) else "준비 완료!"
		-- Speakers can feed other people's voices back into my mic, and others say my words on purpose.
		text = ready .. " · 이어폰을 쓰면 억울한 탈락을 막을 수 있어요"
	end
	testL.Text = text
	testL.TextColor3 = if done then Style.GREEN else Style.AMBER
end

return MicPanel
]====]; s.Parent = n6 end
do local s = Instance.new("ModuleScript"); s.Name = "ReactionBar"; s.Source = [====[--!strict
-- Emoji reaction buttons for ghosts and spectators (bottom centre). The server rate-limits and broadcasts them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Style = require(script.Parent:WaitForChild("Style"))

local ReactionBar = {}

local bar: Frame

function ReactionBar.build(onPick: (number) -> ())
	bar = Instance.new("Frame")
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -20)
	bar.Size = UDim2.new(0, 64 * #Config.REACTIONS, 0, 56)
	bar.BackgroundTransparency = 1
	bar.Visible = false
	bar.Parent = Style.gui()
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = bar
	for index, emoji in Config.REACTIONS do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0, 56, 0, 56)
		b.BackgroundColor3 = Style.PANEL
		b.BackgroundTransparency = 0.25
		b.Text = emoji
		b.TextScaled = true
		b.FontFace = Style.BOLD
		b.TextColor3 = Style.WHITE
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = b
		b.Activated:Connect(function()
			onPick(index)
		end)
		b.Parent = bar
	end
end

function ReactionBar.setVisible(visible: boolean)
	bar.Visible = visible
end

return ReactionBar
