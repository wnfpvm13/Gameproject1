			barStartAt = barStartAt, period = Config.BOTTLE_PERIOD, ids = ids(players), stood = counts(),
			endsAt = barStartAt + Config.BOTTLE_THROW_SECONDS })
		if not ctx.wait(Config.BOTTLE_LEAD_SECONDS) then
