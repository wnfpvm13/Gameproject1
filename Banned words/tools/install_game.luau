do local s = Instance.new("ModuleScript"); s.Name = "Timeline"; s.Source = [====[--!strict
-- The round's clock (docs/DESIGN_V3.md §2): ROUND_SECONDS of main game, a time budget for missions (a mission that
-- would not fit in the time left is not started; when none fits, the final starts), and when the final is due: when the time
-- is up, or as soon as FINAL_AT_ALIVE or fewer are left in a round begun with more than that (3 -> rounds of 4+).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))

local Timeline = {}

local startedAt = 0
local startedWith = 0

-- The main game starts now with `players` participants.
function Timeline.begin(players: number)
	startedAt = os.clock()
	startedWith = players
end

function Timeline.left(): number
	return math.max(0, Config.ROUND_SECONDS - (os.clock() - startedAt))
end

-- Whether so few are left that the final starts at once (only in a round begun with more than FINAL_AT_ALIVE).
function Timeline.fewLeft(alive: number): boolean
	return startedWith > Config.FINAL_AT_ALIVE and alive <= Config.FINAL_AT_ALIVE
end

-- Whether the main game is over and the final should start, with `alive` participants left.
function Timeline.finalDue(alive: number): boolean
	return Timeline.left() <= 0 or Timeline.fewLeft(alive)
end

return Timeline
]====]; s.Parent = n5 end
do local s = Instance.new("ModuleScript"); s.Name = "VoiceService"; s.Source = [====[--!strict
-- Voice routing.
-- 1. Flat volume: default voice creates each character's AudioEmitter on the server with a 7-80 stud rolloff;
--    the flat curve set here replicates to every listener (src/client/FlatVoice.luau covers client-made emitters).
-- 2. Players who are out and spectators are silent to the table: during a round their AudioDeviceInput is only
--    audible to each other (docs/DESIGN_V3.md §13; with banned words they know every word).
-- 3. Chat participants are heard by nobody during their round, even if their voice connects meanwhile (§7: speaking
--    would get around the chat judging).
-- 4. The floor (bundle 6b, §5.1): while someone has it, only they and the presenter are heard by everyone; the other
--    alive participants are heard by nobody. Out players and spectators keep their own group.
local Players = game:GetService("Players")

local VoiceService = {}

local FLAT_CURVE = { [0] = 1, [2000] = 1 }

local speakers: { [number]: boolean }? = nil -- userIds allowed to talk to the table; nil = no round, everyone open
local silenced: { [number]: boolean } = {} -- userIds nobody hears (chat participants of the round)
local floor: { [number]: boolean }? = nil -- while someone has the floor: the userIds still heard by everyone

local function flatten(child: Instance)
	if child:IsA("AudioEmitter") then
		child:SetDistanceAttenuation(FLAT_CURVE)
	end
end

local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		flatten(child)
	end
	character.ChildAdded:Connect(flatten)
end

local function inputOf(player: Player): AudioDeviceInput?
	return player:FindFirstChildOfClass("AudioDeviceInput")
end

local function apply()
	local spectatorIds = {}
	for _, player in Players:GetPlayers() do
		if speakers and not speakers[player.UserId] then
			table.insert(spectatorIds, player.UserId)
		end
	end
	for _, player in Players:GetPlayers() do
		local input = inputOf(player)
		if input then
			local otherHasFloor = speakers ~= nil and speakers[player.UserId] and floor ~= nil and not floor[player.UserId]
			if silenced[player.UserId] or otherHasFloor then
				input.AccessType = Enum.AccessModifierType.Allow
				input:SetUserIdAccessList({}) -- nobody allowed: nobody hears (a chat participant, or someone else's floor)
			elseif speakers == nil or speakers[player.UserId] then
				input.AccessType = Enum.AccessModifierType.Deny
				input:SetUserIdAccessList({}) -- nobody denied: the whole server hears
			else
				input.AccessType = Enum.AccessModifierType.Allow
				input:SetUserIdAccessList(spectatorIds) -- only fellow spectators hear
			end
		end
	end
end

-- Round on: only `userIds` (alive participants) are heard by everyone. nil = round over, everyone open.
function VoiceService.setSpeakers(userIds: { number }?)
	if userIds then
		local set = {}
		for _, id in userIds do
			set[id] = true
		end
		speakers = set
	else
		speakers = nil
	end
	apply()
end

-- The floor: `userIds` (the one speaking and the presenter) are heard by everyone, the other alive participants by
-- nobody; nil gives everyone their voice back.
function VoiceService.setFloor(userIds: { number }?)
	if userIds then
		local set = {}
		for _, id in userIds do
			set[id] = true
		end
		floor = set
	else
		floor = nil
	end
	apply()
end

-- The chat participants of the round being played (an empty list when it is over).
function VoiceService.setSilenced(userIds: { number })
	table.clear(silenced)
	for _, id in userIds do
		silenced[id] = true
	end
	apply()
end

function VoiceService.start()
	local function watchPlayer(player: Player)
		if player.Character then
			watchCharacter(player.Character)
		end
		player.CharacterAdded:Connect(watchCharacter)
		player.ChildAdded:Connect(function(child)
			if child:IsA("AudioDeviceInput") then
				apply()
			end
		end)
	end
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(function(player)
		watchPlayer(player)
		apply() -- a newcomer is a spectator until the next round
	end)
end

return VoiceService
]====]; s.Parent = n5 end
do local s = Instance.new("ModuleScript"); s.Name = "WordService"; s.Source = [====[--!strict
-- Banned words (V3, docs/DESIGN_V3.md §6; bundle 5a): one word per participant, a speech habit (진짜, 대박 ...) with
-- HABIT_WORD_CHANCE drawn for each player on their own (a kind shared by everyone could be read off the others'
-- heads), never overlapping another word in play. A word is replaced after it was said, or by the presenter's re-draw;
-- a new word also avoids `avoid` (the running mission's screen texts, the talk's topic). What each viewer may see:
-- everyone's words, except an alive participant's own (shown as hidden). Words exist only during the banned-word talk
-- (bundle 6a: RoundService assigns them in its prep stage and clears them after it); this module only keeps them in
-- Match.participants.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Judge = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Judge"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))
local Net = require(script.Parent.Parent:WaitForChild("Net"))
local WordBank = require(script.Parent.Parent:WaitForChild("content"):WaitForChild("WordBank"))

local WordService = {}

local DRAW_TRIES = 20 -- words tried before giving up on one that avoids the screen texts

-- The words in play except `player`'s own (theirs is being replaced).
local function takenBy(except: Player?): { string }
	local list = {}
	for player, p in Match.participants do
		if player ~= except then
			for _, word in p.words do
				table.insert(list, word.text)
			end
		end
	end
	return list
end

-- A word for one player: their own kind draw, not overlapping `taken`, not inside any `avoid` text.
local function draw(taken: { string }, avoid: { string }?, rng: Random): WordBank.Entry?
	local kind: "noun" | "habit" = if rng:NextNumber() < Config.HABIT_WORD_CHANCE then "habit" else "noun"
	local blocked = table.clone(taken)
	for _ = 1, DRAW_TRIES do
		local entry = WordBank.draw(kind, blocked, rng)
		if not entry then
			return nil
		end
		local clean = true
		local texts: { string } = avoid or {}
		local forms = table.clone(entry.aliases)
		table.insert(forms, entry.word)
		for _, text in texts do
			for _, form in forms do
				if string.find(Judge.normalize(text), Judge.normalize(form), 1, true) then
					clean = false
				end
			end
		end
		if clean then
			return entry
		end
		table.insert(blocked, entry.word) -- try another
	end
	return nil
end

-- The talk's prep stage: one word for each alive participant, none inside `avoid` (the topic) when that can be done
-- (any old words are dropped). They count from `startJudging` on.
function WordService.assign(rng: Random, avoid: { string }?)
	for _, p in Match.participants do
		table.clear(p.words)
	end
	for _, p in Match.participants do
		if p.alive then
			local entry = draw(takenBy(nil), avoid, rng) or draw(takenBy(nil), nil, rng)
			if entry then
				table.insert(p.words, { text = entry.word, aliases = entry.aliases, effectiveAt = math.huge })
			end
		end
	end
end

-- The talk begins: every word counts from `at` (Match.now()).
function WordService.startJudging(at: number)
	for _, p in Match.participants do
		for _, word in p.words do
			word.effectiveAt = at
		end
	end
end

-- `player` gets a new word (said theirs, or the presenter re-drew it). Returns false if none could be drawn (the old
-- one stays).
function WordService.replace(player: Player, avoid: { string }?, rng: Random): boolean
	local p = Match.participants[player]
	if not p then
		return false
	end
	local old = {}
	for _, word in p.words do
		table.insert(old, word.text)
	end
	local taken = takenBy(player)
	for _, text in old do
		table.insert(taken, text) -- never the same word again
	end
	-- If nothing avoids the screen texts, a new word still beats keeping the one just said.
	local entry = draw(taken, avoid, rng) or draw(taken, nil, rng)
	if not entry then
		return false
	end
	table.clear(p.words)
	table.insert(p.words, { text = entry.word, aliases = entry.aliases, effectiveAt = Match.now() })
	return true
end

-- Everyone's words go (after the talk, between rounds).
function WordService.clear()
	for _, p in Match.participants do
		table.clear(p.words)
	end
end

-- What `viewer` sees: { [userId] = { words = {...} | nil (own, while playing), count = n } }.
function WordService.payloadFor(viewer: Player)
	local result = {}
	for player, p in Match.participants do
		local visible = {}
		for _, word in p.words do
			table.insert(visible, word.text)
		end
		local hidden = player == viewer and p.alive and Match.phase ~= "Result" and #visible > 0 -- (no word: nothing to hide)
		result[tostring(player.UserId)] = { words = if hidden then nil else visible, count = #visible }
	end
	return result
end

function WordService.send(player: Player)
	Net.to(player, "Words", WordService.payloadFor(player))
end

function WordService.sendAll()
	for _, player in Players:GetPlayers() do
		WordService.send(player)
	end
end

return WordService
]====]; s.Parent = n5 end
