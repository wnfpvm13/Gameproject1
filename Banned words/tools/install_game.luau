do local s = Instance.new("ModuleScript"); s.Name = "VoiceService"; s.Source = [====[--!strict
-- Voice routing.
-- 1. Flat volume: default voice creates each character's AudioEmitter on the server with a 7-80 stud rolloff;
--    the flat curve set here replicates to every listener (src/client/FlatVoice.luau covers client-made emitters).
-- 2. Ghosts and spectators are silent to the table: during a round they know every word, so their
--    AudioDeviceInput is only audible to other ghosts/spectators (design V2 §6.2).
local Players = game:GetService("Players")

local VoiceService = {}

local FLAT_CURVE = { [0] = 1, [2000] = 1 }

local speakers: { [number]: boolean }? = nil -- userIds allowed to talk to the table; nil = no round, everyone open

local function flatten(child: Instance)
	if child:IsA("AudioEmitter") then
		child:SetDistanceAttenuation(FLAT_CURVE)
	end
end

local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		flatten(child)
	end
	character.ChildAdded:Connect(flatten)
end

local function inputOf(player: Player): AudioDeviceInput?
	return player:FindFirstChildOfClass("AudioDeviceInput")
end

local function apply()
	local spectatorIds = {}
	for _, player in Players:GetPlayers() do
		if speakers and not speakers[player.UserId] then
			table.insert(spectatorIds, player.UserId)
		end
	end
	for _, player in Players:GetPlayers() do
		local input = inputOf(player)
		if input then
			if speakers == nil or speakers[player.UserId] then
				input.AccessType = Enum.AccessModifierType.Deny
				input:SetUserIdAccessList({}) -- nobody denied: the whole server hears
			else
				input.AccessType = Enum.AccessModifierType.Allow
				input:SetUserIdAccessList(spectatorIds) -- only fellow spectators hear
			end
		end
	end
end

-- Round on: only `userIds` (alive participants) are heard by everyone. nil = round over, everyone open.
function VoiceService.setSpeakers(userIds: { number }?)
	if userIds then
		local set = {}
		for _, id in userIds do
			set[id] = true
		end
		speakers = set
	else
		speakers = nil
	end
	apply()
end

function VoiceService.start()
	local function watchPlayer(player: Player)
		if player.Character then
			watchCharacter(player.Character)
		end
		player.CharacterAdded:Connect(watchCharacter)
		player.ChildAdded:Connect(function(child)
			if child:IsA("AudioDeviceInput") then
				apply()
			end
		end)
	end
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(function(player)
		watchPlayer(player)
		apply() -- a newcomer is a spectator until the next round
	end)
end

return VoiceService
]====]; s.Parent = n4 end
do local s = Instance.new("ModuleScript"); s.Name = "VoteService"; s.Source = [====[--!strict
-- Short mission votes (V2.1): open for a few seconds, alive participants may vote (and change their vote) whether
-- or not they spoke; counts stay hidden until it closes. One option with the most votes wins; a tie or no votes
-- is "undecided" (a neutral follow-up, never a penalty). Talk and judging go on during the vote.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))
local Net = require(script.Parent.Parent:WaitForChild("Net"))

local VoteService = {}

type Option = { id: string, text: string }
type Ballot = { voteKey: string, options: { Option }, endsAt: number, votes: { [Player]: string } }

local current: Ballot? = nil
local lastClosed: any = nil -- { payload, at = os.clock() } for late joiners
local pendingKey: string? = nil -- closed and counted, result not shown yet
local serial = 0

local function isOption(ballot: Ballot, id: any): boolean
	for _, option in ballot.options do
		if option.id == id then
			return true
		end
	end
	return false
end

local function openPayload(ballot: Ballot)
	local options = {}
	for _, option in ballot.options do
		table.insert(options, { id = option.id, text = option.text })
	end
	return { kind = "open", voteKey = ballot.voteKey, options = options, endsAt = ballot.endsAt }
end

local function onVote(player: Player, voteKey: any, optionId: any)
	local ballot = current
	if not ballot or voteKey ~= ballot.voteKey or Match.phase ~= "Talk" or not Match.isAlive(player) or not isOption(ballot, optionId) then
		return
	end
	if Match.now() > ballot.endsAt then
		return
	end
	ballot.votes[player] = optionId
end

function VoteService.start()
	Net.listen("Vote", onVote)
	Players.PlayerRemoving:Connect(function(player)
		if current then
			current.votes[player] = nil -- leaving before the close: the vote no longer counts
		end
	end)
end

local function noop() end

-- Blocks until the vote closes (or the talk ends). Returns the winning option id (or "undecided") and a function
-- that shows the result to everyone (the host calls it when nothing else is on screen; counts are fixed already).
function VoteService.run(spec: { id: string, options: { Option }, seconds: number }, stillTalking: () -> boolean): (string, () -> ())
	serial += 1
	local ballot: Ballot = {
		voteKey = string.format("%d:%d:%s", Match.roundId, serial, spec.id),
		options = spec.options,
		endsAt = Match.now() + spec.seconds,
		votes = {},
	}
	current = ballot
	lastClosed = nil
	Net.toAll("VoteState", openPayload(ballot))
	while Match.now() < ballot.endsAt and stillTalking() and current == ballot do
		task.wait(math.min(0.2, math.max(0, ballot.endsAt - Match.now())))
	end
	if current ~= ballot or not stillTalking() then
		-- The round stopped (or was cleared) during the vote: no result, nothing changes.
		if current == ballot then
			current = nil
			Net.toAll("VoteState", { kind = "cancel", voteKey = ballot.voteKey })
		end
		return "undecided", noop
	end
	current = nil
	pendingKey = ballot.voteKey
	Net.toAll("VoteState", { kind = "pending", voteKey = ballot.voteKey })

	-- Counted right at the close: only votes of players alive at this moment.
	local counts: { [string]: number } = {}
	for _, option in ballot.options do
		counts[option.id] = 0
	end
	for player, optionId in ballot.votes do
		if Match.isAlive(player) then
			counts[optionId] += 1
		end
	end
	local best, bestCount, tie = "undecided", 0, false
	for _, option in ballot.options do
		local n = counts[option.id]
		if n > bestCount then
			best, bestCount, tie = option.id, n, false
		elseif n == bestCount and n > 0 then
			tie = true
		end
	end
	local outcome = if tie or bestCount == 0 then "undecided" else best
	local result = {
		kind = "closed",
		voteKey = ballot.voteKey,
		outcome = outcome,
		counts = counts,
		options = openPayload(ballot).options,
	}
	local function announce()
		if pendingKey ~= ballot.voteKey then
			return -- cleared meanwhile (round over)
		end
		pendingKey = nil
		result.expiresAt = Match.now() + Config.VOTE_RESULT_SECONDS
		lastClosed = { payload = result, at = os.clock() }
		Net.toAll("VoteState", result)
	end
	return outcome, announce
end

-- Late joiners: the open vote, a vote waiting for its result, or a result that is still on everyone's screen.
function VoteService.send(player: Player)
	if current then
		Net.to(player, "VoteState", openPayload(current))
	elseif pendingKey then
		Net.to(player, "VoteState", { kind = "pending", voteKey = pendingKey })
	elseif lastClosed and os.clock() - lastClosed.at < Config.VOTE_RESULT_SECONDS then
		Net.to(player, "VoteState", lastClosed.payload)
	end
end

function VoteService.clear()
	current = nil
	pendingKey = nil
	lastClosed = nil
	Net.toAll("VoteState", { kind = "clear" })
end

return VoteService
]====]; s.Parent = n4 end
do local s = Instance.new("ModuleScript"); s.Name = "WordService"; s.Source = [====[--!strict
-- Forbidden words: first word at the start, then one more for everyone alive at WORD_STEPS (max 3 words),
-- and what each viewer may see. Nobody ever receives their own words while alive.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))
local Net = require(script.Parent.Parent:WaitForChild("Net"))
local WordBank = require(script.Parent.Parent:WaitForChild("content"):WaitForChild("WordBank"))

local WordService = {}

local function addWord(p: Match.Participant, kind: "noun" | "habit", effectiveAt: number, rng: Random): boolean
	local entry = WordBank.draw(kind, Match.wordsInPlay(), rng)
	if not entry then
		return false
	end
	table.insert(p.words, { text = entry.word, aliases = entry.aliases, effectiveAt = effectiveAt })
	return true
end

-- One noun per participant, none overlapping another.
function WordService.assignFirst(rng: Random)
	for _, p in Match.participants do
		addWord(p, "noun", 0, rng)
	end
end

-- What `viewer` sees: { [userId] = { words = {...} | nil (own, while alive), count = n } }.
-- Words become visible at their effective time, so nobody can steer toward a word before it counts.
function WordService.payloadFor(viewer: Player)
	local now = Match.now()
	local result = {}
	for player, p in Match.participants do
		local visible = {}
		for _, word in p.words do
			if word.effectiveAt <= now then
				table.insert(visible, word.text)
			end
		end
		local hidden = player == viewer and p.alive and Match.phase ~= "Result"
		result[tostring(player.UserId)] = { words = if hidden then nil else visible, count = #visible }
	end
	return result
end

function WordService.send(player: Player)
	Net.to(player, "Words", WordService.payloadFor(player))
end

function WordService.sendAll()
	for _, player in Players:GetPlayers() do
		WordService.send(player)
	end
end

-- Runs alongside the talk: warns, then adds a word to everyone alive. `stillTalking()` stops it.
-- Nothing else reacts to a new word (a card changing right then would hint at it).
-- A burst of eliminations (2+ in WORD_DELAY_WINDOW) pushes the step back, also after the warning, up to WORD_DELAY_MAX.
function WordService.runSchedule(talkSeconds: number, stillTalking: () -> boolean, rng: Random)
	local start = Match.now()
	for index, fraction in Config.WORD_STEPS do
		local wordCount = index + 1
		local effectiveAt = start + talkSeconds * fraction
		local delayed = 0
		local warned = false
		local lastCheck = os.clock()
		while true do
			if not stillTalking() then
				return
			end
			local burst = Match.recentLaunches(Config.WORD_DELAY_WINDOW) >= 2
			if burst and delayed < Config.WORD_DELAY_MAX and Match.now() >= effectiveAt - Config.WORD_WARNING then
				local step = os.clock() - lastCheck
				delayed += step
				effectiveAt += step
				if warned and math.floor(delayed) ~= math.floor(delayed - step) then
					Net.toAll("WordWarn", { at = effectiveAt, count = wordCount }) -- the countdown moves back (1/s)
				end
			end
			lastCheck = os.clock()
			Match.nextWordWarnAt = if warned then math.huge else os.clock() + (effectiveAt - Config.WORD_WARNING - Match.now())
			if effectiveAt > Match.endsAt - Config.WORD_WARNING then
				Match.nextWordWarnAt = math.huge
				if warned then
					Net.toAll("WordWarn", { at = 0, count = wordCount }) -- cancelled
				end
				return -- too close to the end to matter
			end
			if not warned and Match.now() >= effectiveAt - Config.WORD_WARNING then
				warned = true
				Net.toAll("WordWarn", { at = effectiveAt, count = wordCount })
			end
			if warned then
				Match.holdHost(effectiveAt - Match.now() + Config.HOLD_AFTER_WORD) -- the countdown has the stage
			end
			if Match.now() >= effectiveAt then
				break -- checked above in this same step: still talking, no burst delay pending
			end
			task.wait(0.25)
		end
		Match.nextWordWarnAt = math.huge
		for _, p in Match.participants do
			if p.alive then
				-- Drawn per player: one kind for everyone would let anyone read theirs off the others' heads.
				local kind: "noun" | "habit" = if wordCount == 3 and rng:NextNumber() < Config.HABIT_WORD_CHANCE then "habit" else "noun"
				addWord(p, kind, effectiveAt, rng)
			end
		end
		WordService.sendAll()
		Net.notice(string.format("금칙어가 %d개가 됐어요! 머리 위를 다시 확인하세요", wordCount))
	end
end

return WordService
]====]; s.Parent = n4 end
