do local s = Instance.new("ModuleScript"); s.Name = "Nunchi"; s.Source = [====[--!strict
-- Nunchi (docs/DESIGN_V3.md §5.2; bundle 6c): the Korean counting game with the seat bells. The bells of everyone on
-- the ground open; each ring takes the next number (1, 2, 3 ...). Rings within NUNCHI_WINDOW of the first ring of a
-- number clash: they all fly and it ends once that window is over (so three at once all clash). With no clash, once
-- all but one of those still in have rung (and the window after the last ring is over), the one who never rang flies;
-- if they rang in that last moment after all, the last to ring is the last. NUNCHI_IDLE_SECONDS without a ring (or
-- NUNCHI_MAX_SECONDS in all) ends it too: everyone still in who has not rung flies (and missed an answer: the AFK
-- rule). Fewer than NUNCHI_MIN_PLAYERS left in the middle: it ends with no penalty. Ring times are the server's (ping
-- plays a part, known and accepted).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))

-- MissionRunner.MissionCtx (missions cannot require services, so the shape is repeated here).
type Ctx = {
	final: boolean,
	players: () -> { Player },
	rng: Random,
	fail: (players: { Player }, key: string, subjective: boolean?) -> (),
	show: (text: string) -> (),
	cancelled: () -> boolean,
	stopped: () -> boolean,
	wait: (seconds: number) -> boolean,
	reveal: (seconds: number) -> (),
	flying: (player: Player) -> boolean,
	answers: (answered: { Player }, missed: { Player }) -> (),
	screen: (payload: { [string]: any }?) -> (),
	ask: (payload: { [string]: any }, choices: number, seconds: number, from: { Player }) -> { [Player]: number },
	canFling: (player: Player) -> boolean,
	presenterPick: (options: { { id: string, title: string, recommended: boolean } }, seconds: number, kind: string?) -> string?,
	lever: () -> (),
	talk: (stage: string, topic: string?) -> (),
	presenterReroll: (seconds: number) -> boolean,
	bell: (from: { Player }, seconds: number, firstOnly: boolean,
		enough: (({ Player }, { [Player]: number }, { { player: Player, at: number } }) -> boolean)?, repeatEvery: number?)
		-> ({ Player }, { [Player]: number }, { { player: Player, at: number } }),
	screenTo: (player: Player, payload: { [string]: any }?) -> (),
	floor: (player: Player?) -> (),
	presenterVerdict: (answer: string, seconds: number) -> string?,
	score: (player: Player, amount: number) -> (),
	askText: (payload: { [string]: any }, seconds: number, from: { Player }) -> { [Player]: string },
	heads: (words: { [Player]: string }?, known: { [Player]: boolean }?) -> (),
	chat: (handler: ((Player, string) -> ())?) -> (),
}

local Nunchi = {
	id = "nunchi",
	title = Config.TEXT.NUNCHI_TITLE,
	brief = Config.TEXT.NUNCHI_BRIEF, -- (the briefing before it)
	expectedSeconds = Config.NUNCHI_MAX_SECONDS + Config.MINIGAME_RESULT_SECONDS,
	expectedFor = nil :: ((players: number) -> number)?,
	maxPerRound = Config.GAME_PER_ROUND :: number?,
	minPlayers = Config.NUNCHI_MIN_PLAYERS :: number?,
	maxPlayers = nil :: number?,
	needsPresenter = nil :: boolean?,
}

local function ids(list: { Player }): { number }
	local out = {}
	for _, player in list do
		table.insert(out, player.UserId)
	end
	return out
end

-- The first clash in `rung` (the rings within NUNCHI_WINDOW of the first ring of one number) and that first ring's
-- time, or nil.
function Nunchi.clash(rung: { Player }, times: { [Player]: number }): ({ Player }?, number?)
	local k = 1
	while k < #rung do
		local first = rung[k]
		local group = { first }
		local j = k + 1
		while j <= #rung and times[rung[j]] - times[first] <= Config.NUNCHI_WINDOW do
			table.insert(group, rung[j])
			j += 1
		end
		if #group > 1 then
			return group, times[first]
		end
		k += 1
	end
	return nil, nil
end

local function names(list: { Player }): string
	local out = {}
	for _, player in list do
		table.insert(out, player.DisplayName)
	end
	return table.concat(out, ", ")
end

function Nunchi.available(final: boolean): boolean
	return not final
end

-- Returns false when too few were on the ground to start.
function Nunchi.run(ctx: Ctx): boolean?
	local from = {}
	for _, player in ctx.players() do
		if not ctx.flying(player) then
			table.insert(from, player)
		end
	end
	if #from < Config.NUNCHI_MIN_PLAYERS then
		return false
	end
	ctx.show(Config.TEXT.NUNCHI_START)
	local startedAt = Match.now()
	ctx.screen({ kind = "nunchi", endsAt = startedAt + Config.NUNCHI_MAX_SECONDS })
	local function present(): { Player } -- who of those who began is still in (not out, not flying)
		local list = {}
		for _, player in from do
			if table.find(ctx.players(), player) and not ctx.flying(player) then
				table.insert(list, player)
			end
		end
		return list
	end
	local function lastAtOf(rung: { Player }, times: { [Player]: number }): number
		return if #rung > 0 then times[rung[#rung]] else startedAt
	end
	local function allButOne(rung: { Player }): boolean
		local here = present()
		local rangHere = 0
		for _, player in here do
			if table.find(rung, player) then
				rangHere += 1
			end
		end
		return rangHere >= #here - 1
	end
	local function settled(rung: { Player }, times: { [Player]: number }): boolean
		local now = Match.now()
		local clash, firstAt = Nunchi.clash(rung, times)
		if clash and firstAt then
			return now - firstAt > Config.NUNCHI_WINDOW -- (the clash window is over: everyone in it is in the clash)
		end
		if #present() < Config.NUNCHI_MIN_PLAYERS then
			return true
		end
		local quiet = now - lastAtOf(rung, times)
		return (allButOne(rung) and quiet > Config.NUNCHI_WINDOW) or quiet >= Config.NUNCHI_IDLE_SECONDS
	end
	local rung, times = ctx.bell(from, Config.NUNCHI_MAX_SECONDS, false, settled)
	if ctx.cancelled() then
		return nil
	end
	local clash = Nunchi.clash(rung, times)
	local here = present()
	if not clash and #here < Config.NUNCHI_MIN_PLAYERS then
		ctx.screen(nil)
		return nil -- (too few left in the middle: no penalty)
	end
	local still = {} -- who is still in and never rang
	for _, player in here do
		if not table.find(rung, player) then
			table.insert(still, player)
		end
	end
	local quiet = Match.now() - lastAtOf(rung, times)
	local timedOut = quiet >= Config.NUNCHI_IDLE_SECONDS or Match.now() - startedAt >= Config.NUNCHI_MAX_SECONDS
	local losers: { Player } = {}
	local text = ""
	local missed: { Player } = {}
	if clash then
		losers, text = clash, string.format(Config.TEXT.NUNCHI_CLASH, names(clash))
	elseif #still == 1 and not timedOut then
		losers, text = still, string.format(Config.TEXT.NUNCHI_LAST, names(still))
	elseif #still == 0 and #rung > 0 then
		local lastOne = rung[#rung] -- (rang in the very last moment: the last to ring is the last)
		losers, text = { lastOne }, string.format(Config.TEXT.NUNCHI_LAST, lastOne.DisplayName)
	else
		losers, text, missed = still, string.format(Config.TEXT.NUNCHI_IDLE, names(still)), still
	end
	local shown = table.clone(rung)
	for _, player in losers do
		if not table.find(shown, player) then
			table.insert(shown, player) -- (after the rings: those who never rang)
		end
	end
	ctx.screen({ kind = "nunchiResult", ids = ids(shown), rang = #rung, losers = ids(losers) })
	if text ~= "" then
		ctx.show(text)
	end
	ctx.answers(rung, missed) -- (before the fail: a launched player's miss would not count)
	ctx.fail(losers, "nunchi") -- (also with nobody: the answers above are counted with it)
	ctx.reveal(Config.MINIGAME_RESULT_SECONDS)
	return nil
end

return Nunchi
]====]; s.Parent = n4 end
do local s = Instance.new("ModuleScript"); s.Name = "OXQuiz"; s.Source = [====[--!strict
-- O/X 퀴즈 (bundle 8c, owner 2026-10-24): OX_QUESTIONS statements in a row, each shown OX_INTRO_SECONDS before the
-- O / X buttons work for OX_SECONDS (on the quiz's own screen). After the last one, whoever got the most wrong flies
-- (a statement not answered counts as wrong; ties all; nobody when everyone got every one right). A statement asked
-- while someone was launched or gone does not count for them, and only those still here and on the ground at the end
-- are judged and shown. Who answered none missed an answer (the AFK rule). Statements never repeat until every clean
-- one was asked, and one containing a banned word in play is skipped.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))
local OXBank = require(script.Parent.Parent:WaitForChild("content"):WaitForChild("OXBank"))

-- MissionRunner.MissionCtx (missions cannot require services, so the shape is repeated here).
type Ctx = {
	final: boolean,
	players: () -> { Player },
	rng: Random,
	fail: (players: { Player }, key: string, subjective: boolean?) -> (),
	show: (text: string) -> (),
	cancelled: () -> boolean,
	stopped: () -> boolean,
	wait: (seconds: number) -> boolean,
	reveal: (seconds: number) -> (),
	flying: (player: Player) -> boolean,
	answers: (answered: { Player }, missed: { Player }) -> (),
	screen: (payload: { [string]: any }?) -> (),
	ask: (payload: { [string]: any }, choices: number, seconds: number, from: { Player }) -> { [Player]: number },
	canFling: (player: Player) -> boolean,
	presenterPick: (options: { { id: string, title: string, recommended: boolean } }, seconds: number, kind: string?) -> string?,
	lever: () -> (),
	talk: (stage: string, topic: string?) -> (),
	presenterReroll: (seconds: number) -> boolean,
	bell: (from: { Player }, seconds: number, firstOnly: boolean,
		enough: (({ Player }, { [Player]: number }, { { player: Player, at: number } }) -> boolean)?, repeatEvery: number?,
		quiet: boolean?)
		-> ({ Player }, { [Player]: number }, { { player: Player, at: number } }),
	screenTo: (player: Player, payload: { [string]: any }?) -> (),
	floor: (player: Player?) -> (),
	presenterVerdict: (answer: string, seconds: number) -> string?,
	score: (player: Player, amount: number) -> (),
	askText: (payload: { [string]: any }, seconds: number, from: { Player }) -> { [Player]: string },
	heads: (words: { [Player]: string }?, known: { [Player]: boolean }?) -> (),
	chat: (handler: ((Player, string) -> ())?) -> (),
}

local OXQuiz = {
	id = "oxQuiz",
	title = Config.TEXT.OX_TITLE,
	brief = string.format(Config.TEXT.OX_BRIEF, Config.OX_QUESTIONS), -- (the briefing before it)
	expectedSeconds = Config.OX_QUESTIONS * (Config.OX_INTRO_SECONDS + Config.OX_SECONDS + Config.OX_REVEAL_SECONDS)
		+ Config.MINIGAME_RESULT_SECONDS,
	expectedFor = nil :: ((players: number) -> number)?,
	maxPerRound = Config.GAME_PER_ROUND :: number?,
	minPlayers = nil :: number?,
	maxPlayers = nil :: number?,
	needsPresenter = nil :: boolean?,
}

local used: { [OXBank.Statement]: boolean } = {}

-- `count` different statements free of the words in play: the ones not asked yet first; once those run out, the asked
-- ones come back for the rest. Fewer if the bank has fewer clean ones. Exposed for the tests.
function OXQuiz.draw(count: number, rng: Random): { OXBank.Statement }
	local words = Match.wordsInPlay()
	local clean, fresh = {}, {}
	for _, statement in OXBank do
		local hit = false
		for _, word in words do
			hit = hit or string.find(statement.s, word, 1, true) ~= nil
		end
		if not hit then
			table.insert(clean, statement)
			if not used[statement] then
				table.insert(fresh, statement)
			end
		end
	end
	local out: { OXBank.Statement } = {}
	local function take(from: { OXBank.Statement })
		while #out < count and #from > 0 do
			local statement = table.remove(from, rng:NextInteger(1, #from)) :: OXBank.Statement
			used[statement] = true
			table.insert(out, statement)
		end
	end
	take(fresh)
	if #out < count then -- (every clean one was asked: they come back, except the ones just taken)
		local again = {}
		for _, statement in clean do
			if not table.find(out, statement) then
				used[statement] = nil
				table.insert(again, statement)
			end
		end
		take(again)
	end
	return out
end

function OXQuiz.available(final: boolean): boolean
	return not final and #OXBank > 0
end

-- Who flies from the wrong counts: the most wrong (ties all), nobody when nobody got any wrong. Pure, for the tests.
function OXQuiz.losers(players: { Player }, wrong: { [Player]: number }): { Player }
	local most = 0
	for _, player in players do
		most = math.max(most, wrong[player] or 0)
	end
	local out = {}
	if most > 0 then
		for _, player in players do
			if (wrong[player] or 0) == most then
				table.insert(out, player)
			end
		end
	end
	return out
end

-- Returns false when nothing could be asked (no clean statement).
function OXQuiz.run(ctx: Ctx): boolean?
	local statements = OXQuiz.draw(Config.OX_QUESTIONS, ctx.rng)
	if #statements == 0 then
		return false
	end
	local players = {}
	for _, player in ctx.players() do
		if not ctx.flying(player) then
			table.insert(players, player)
		end
	end
	-- (still here, alive and on the ground)
	local function present(): { Player }
		local list = {}
		for _, player in players do
			if table.find(ctx.players(), player) and not ctx.flying(player) then
				table.insert(list, player)
			end
		end
		return list
	end
	local wrong: { [Player]: number } = {}
	local touched: { [Player]: boolean } = {}
	local asked: { [Player]: boolean } = {}
	local choices = { Config.TEXT.OX_O, Config.TEXT.OX_X }
	ctx.show(Config.TEXT.OX_START)
	for i, statement in statements do
		local question = string.format(Config.TEXT.OX_QUESTION, i, #statements, statement.s)
		local shown = { kind = "quiz", final = false, question = question, choices = choices }
		ctx.screen(shown)
		if not ctx.wait(Config.OX_INTRO_SECONDS) then
			return nil
		end
		local from = present()
		local answers = ctx.ask(shown, #choices, Config.OX_SECONDS, from)
		if ctx.cancelled() then
			return nil
		end
		local right = if statement.o then 1 else 2
		local still = present()
		for _, player in from do
			if not table.find(still, player) then
				continue -- (launched or gone meanwhile: this one does not count for them)
			end
			asked[player] = true
			local choice = answers[player]
			if choice then
				touched[player] = true
			end
			if choice ~= right then
				wrong[player] = (wrong[player] or 0) + 1
			end
		end
		ctx.screen({ kind = "quizResult", final = false, question = question, choices = choices, answer = right })
		if not ctx.wait(Config.OX_REVEAL_SECONDS) then
			return nil
		end
	end
	local judged, pressed, never = {}, {}, {}
	for _, player in present() do
		if asked[player] then
			table.insert(judged, player)
			table.insert(if touched[player] then pressed else never, player)
		end
	end
	local losers = OXQuiz.losers(judged, wrong)
	local ids, counts, loserIds = {}, {}, {}
	for _, player in judged do
		table.insert(ids, player.UserId)
		table.insert(counts, wrong[player] or 0)
	end
	for _, player in losers do
		table.insert(loserIds, player.UserId)
	end
	ctx.screen({ kind = "oxResult", ids = ids, wrong = counts, losers = loserIds, total = #statements })
	local names = {}
	for _, player in losers do
		table.insert(names, player.DisplayName)
	end
	ctx.show(if #losers > 0 then string.format(Config.TEXT.OX_RESULT, table.concat(names, ", ")) else Config.TEXT.OX_ALL_RIGHT)
	ctx.answers(pressed, never) -- (before the fail: a launched player's miss would not count)
	ctx.fail(losers, "ox")
	ctx.reveal(Config.MINIGAME_RESULT_SECONDS)
	return nil
end

return OXQuiz
]====]; s.Parent = n4 end
do local s = Instance.new("ModuleScript"); s.Name = "OneWord"; s.Source = [====[--!strict
-- "Say what you like" (docs/DESIGN_V3.md §5: bundle 4b's "a word to everyone", owner 2026-10-23: topics mostly about
-- yourself, the presenter picks on screen and the podium lever is pulled; bells and the floor since bundle 6b). First
-- the bells of everyone on the ground are open for BELL_ORDER_SECONDS. Then up to ONE_WORD_MAX_PERFORMERS take turns:
-- those who performed least first, among equals who rang first (in the order they rang), then the rest at random.
-- Each gets a topic (ONE_WORD_PREP_SECONDS to read it and swap it once), then has the floor (only they and the presenter
-- are heard, alive players see only their chat) for ONE_WORD_SECONDS (chat participants type for
-- ONE_WORD_CHAT_SECONDS). Then the presenter picks the one to launch (the saddest word) within PRESENTER_JUDGE_SECONDS;
-- with no pick everyone votes (VoteRules). Without a presenter it is played only with VOTE_MIN_VOTERS alive (else the
-- vote could not happen). The launch is subjective: in public servers it never takes a last life and hits a player at
-- most SUBJECTIVE_FLINGS times a round, so those players are not offered. Who flew during the performances or skipped
-- their turn is not offered (§4).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("BannedWords")
local Config = require(shared:WaitForChild("Config"))
local VoteRules = require(shared:WaitForChild("VoteRules"))
local Match = require(script.Parent.Parent:WaitForChild("Match"))
local OneWordTopics = require(script.Parent.Parent:WaitForChild("content"):WaitForChild("OneWordTopics"))

-- MissionRunner.MissionCtx (missions cannot require services, so the shape is repeated here).
type Option = { id: string, title: string, recommended: boolean }
type Ctx = {
	final: boolean,
	players: () -> { Player },
	rng: Random,
	fail: (players: { Player }, key: string, subjective: boolean?) -> (),
	show: (text: string) -> (),
	cancelled: () -> boolean,
	stopped: () -> boolean,
	wait: (seconds: number) -> boolean,
	reveal: (seconds: number) -> (),
	flying: (player: Player) -> boolean,
	answers: (answered: { Player }, missed: { Player }) -> (),
	screen: (payload: { [string]: any }?) -> (),
	ask: (payload: { [string]: any }, choices: number, seconds: number, from: { Player }) -> { [Player]: number },
	canFling: (player: Player) -> boolean,
	presenterPick: (options: { Option }, seconds: number, kind: string?) -> string?,
	lever: () -> (),
	talk: (stage: string, topic: string?) -> (),
	presenterReroll: (seconds: number) -> boolean,
	bell: (from: { Player }, seconds: number, firstOnly: boolean,
		enough: (({ Player }, { [Player]: number }, { { player: Player, at: number } }) -> boolean)?, repeatEvery: number?)
		-> ({ Player }, { [Player]: number }, { { player: Player, at: number } }),
	screenTo: (player: Player, payload: { [string]: any }?) -> (),
	floor: (player: Player?) -> (),
	presenterVerdict: (answer: string, seconds: number) -> string?,
	score: (player: Player, amount: number) -> (),
	askText: (payload: { [string]: any }, seconds: number, from: { Player }) -> { [Player]: string },
	heads: (words: { [Player]: string }?, known: { [Player]: boolean }?) -> (),
	chat: (handler: ((Player, string) -> ())?) -> (),
}

local OneWord = {
	id = "oneWord",
	title = Config.TEXT.ONE_WORD_TITLE,
	brief = Config.TEXT.ONE_WORD_BRIEF, -- (the briefing before it)
	-- The time budget counts the longest run: the bells, everyone swaps the topic and types by chat, then a vote and the
	-- result.
	expectedSeconds = Config.BELL_ORDER_SECONDS
		+ Config.ONE_WORD_MAX_PERFORMERS * (2 * Config.ONE_WORD_PREP_SECONDS + Config.ONE_WORD_CHAT_SECONDS)
		+ Config.PRESENTER_JUDGE_SECONDS + Config.VOTE_SECONDS + Config.ONE_WORD_RESULT_SECONDS,
	expectedFor = nil :: ((players: number) -> number)?,
	maxPerRound = Config.GAME_PER_ROUND :: number?,
	minPlayers = Config.ONE_WORD_MIN_PLAYERS :: number?,
	maxPlayers = nil :: number?,
	needsPresenter = nil :: boolean?,
}

-- Turns performed this round (the least go first; DESIGN §5 "이번 판에 안 해 본 사람 우선"); weak keys, so players
-- who left drop out.
local performed: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local performedRound = -1 -- the round `performed` counts

local function ids(list: { Player }): { number }
	local out = {}
	for _, player in list do
		table.insert(out, player.UserId)
	end
	return out
end

-- Up to ONE_WORD_MAX_PERFORMERS alive players on the ground: those who performed least first; among equals who rang
-- the bell first (`rung`, first to last), then the others at random.
local function choosePerformers(ctx: Ctx, rung: { Player }): { Player }
	local pool = {}
	local order: { [Player]: number } = {}
	for _, player in ctx.players() do
		if not ctx.flying(player) then
			table.insert(pool, player)
			local rank = table.find(rung, player)
			order[player] = if rank then rank else #rung + 1 + ctx.rng:NextNumber()
		end
	end
	table.sort(pool, function(a, b)
		local na, nb = performed[a] or 0, performed[b] or 0
		if na ~= nb then
			return na < nb
		end
		return order[a] < order[b]
	end)
	local list = {}
	for i = 1, math.min(#pool, Config.ONE_WORD_MAX_PERFORMERS) do
		table.insert(list, pool[i])
	end
	return list
end

local heard: { [string]: boolean } = {} -- topics given on this server (review 2026-10-25: they came back soon)

-- A topic not given yet in this run and free of the banned words in play (nil if none is left); one not heard yet on
-- this server first (when every free one was, they may come again).
local function pickTopic(ctx: Ctx, given: { [string]: boolean }): string?
	local words = Match.wordsInPlay()
	local free, fresh = {}, {}
	for _, topic in OneWordTopics do
		local clean = not given[topic]
		for _, word in words do
			clean = clean and string.find(topic, word, 1, true) == nil
		end
		if clean then
			table.insert(free, topic)
			if not heard[topic] then
				table.insert(fresh, topic)
			end
		end
	end
	if #free == 0 then
		return nil
	end
	if #fresh == 0 then
		table.clear(heard) -- (a new cycle for everything; this game's own topics stay out through `given`)
		fresh = free
	end
	local topic = fresh[ctx.rng:NextInteger(1, #fresh)]
	given[topic] = true
	heard[topic] = true
	return topic
end

local function stillIn(ctx: Ctx, player: Player): boolean
	return table.find(ctx.players(), player) ~= nil
end

-- What this run saw: who took their turn, who flew meanwhile (they are not offered as targets).
type Seen = { done: { [Player]: boolean }, flew: { [Player]: boolean } }

local function noteFlights(ctx: Ctx, performers: { Player }, seen: Seen)
	for _, player in performers do
		if ctx.flying(player) then
			seen.flew[player] = true
		end
	end
end

-- Waits `seconds` (false if cancelled), noting flights; ends early when the performer is gone.
local function watchWait(ctx: Ctx, seconds: number, performers: { Player }, performer: Player, seen: Seen): boolean
	local untilAt = os.clock() + seconds
	while os.clock() < untilAt do
		noteFlights(ctx, performers, seen)
		if not stillIn(ctx, performer) then
			return not ctx.cancelled()
		end
		if not ctx.wait(math.min(0.25, untilAt - os.clock())) then
			return false
		end
	end
	noteFlights(ctx, performers, seen)
	return true
end

-- One performer's turn. Returns false if the mission was cancelled.
local function turn(ctx: Ctx, performers: { Player }, index: number, given: { [string]: boolean }, seen: Seen): boolean
	local performer = performers[index]
	if not stillIn(ctx, performer) or ctx.flying(performer) then
		noteFlights(ctx, performers, seen)
		return not ctx.cancelled() -- gone or flying: the turn is skipped
	end
	local topic = pickTopic(ctx, given)
	if not topic then
		return not ctx.cancelled()
	end
	performed[performer] = (performed[performer] or 0) + 1
	seen.done[performer] = true
	local p = Match.participants[performer]
	local chat = p ~= nil and p.chat
	local function screen(phase: string, swapped: boolean, endsAt: number?)
		ctx.screen({ kind = "oneWord", ids = ids(performers), current = index, topic = topic, phase = phase,
			swapped = swapped, chat = chat, endsAt = endsAt })
	end
	ctx.show(string.format(Config.TEXT.ONE_WORD_TURN, performer.DisplayName, topic))
	-- Reading time; the performer may swap the topic once (their answer 1 = "swap").
	local swap = ctx.ask({ kind = "oneWord", ids = ids(performers), current = index, topic = topic, phase = "prep",
		swapped = false, chat = chat }, 1, Config.ONE_WORD_PREP_SECONDS, { performer })
	if ctx.cancelled() then
		return false
	end
	noteFlights(ctx, performers, seen)
	if swap[performer] then
		topic = pickTopic(ctx, given) or topic
		ctx.show(string.format(Config.TEXT.ONE_WORD_TURN, performer.DisplayName, topic))
		screen("prep", true, Match.now() + Config.ONE_WORD_PREP_SECONDS)
		if not watchWait(ctx, Config.ONE_WORD_PREP_SECONDS, performers, performer, seen) then
			return false
		end
	end
	local seconds = if chat then Config.ONE_WORD_CHAT_SECONDS else Config.ONE_WORD_SECONDS
	screen("talk", true, Match.now() + seconds)
	ctx.floor(performer)
	local going = watchWait(ctx, seconds, performers, performer, seen)
	ctx.floor(nil)
	return going
end

-- Who flies: the presenter's pick, else a vote; nil for nobody. `eligible()` gives the targets still allowed now
-- (they are looked at again after each wait: someone may leave or fly meanwhile).
local function judge(ctx: Ctx, eligible: () -> { Player }): (Player?, boolean)
	local targets = eligible()
	if #targets == 0 then
		return nil, false
	end
	ctx.screen({ kind = "oneWordJudge", ids = ids(targets) })
	ctx.show(Config.TEXT.JUDGE_WAIT)
	local options: { Option } = {}
	for _, player in targets do
		table.insert(options, { id = tostring(player.UserId), title = player.DisplayName, recommended = false })
	end
	local picked = ctx.presenterPick(options, Config.PRESENTER_JUDGE_SECONDS)
	if ctx.cancelled() then
		return nil, false
	end
	targets = eligible()
	if picked then
		for _, player in targets do
			if tostring(player.UserId) == picked then
				return player, true
			end
		end
	end
	if #targets == 0 then
		return nil, false
	end
	local voters = {}
	for _, player in ctx.players() do
		if not ctx.flying(player) then
			table.insert(voters, player)
		end
	end
	if not VoteRules.canVote(#voters) then
		return nil, false
	end
	ctx.show(Config.TEXT.JUDGE_TO_VOTE)
	local answers = ctx.ask({ kind = "vote", ids = ids(targets) }, VoteRules.choices(#targets), Config.VOTE_SECONDS, voters)
	if ctx.cancelled() then
		return nil, false
	end
	-- Voters who left or went out meanwhile no longer count (the voters are the alive participants, §5).
	local stillVoting = {}
	for _, player in voters do
		if stillIn(ctx, player) then
			table.insert(stillVoting, player)
		end
	end
	local index = VoteRules.decide(answers, targets, stillVoting)
	local winner = if index then targets[index] else nil
	if winner and not table.find(eligible(), winner) then
		return nil, false -- the winner left or flew during the vote
	end
	return winner, false
end

-- Without a presenter only when a vote can decide (VOTE_MIN_VOTERS alive).
local function playable(alive: number): boolean
	return Match.presenter ~= nil or VoteRules.canVote(alive)
end

function OneWord.available(final: boolean): boolean
	return not final and #OneWordTopics > 0 and playable(#Match.aliveList())
end

-- Returns false when it could not start (no presenter and too few for a vote, or too few on the ground).
function OneWord.run(ctx: Ctx): boolean?
	if not playable(#ctx.players()) then
		return false
	end
	local ground = {}
	for _, player in ctx.players() do
		if not ctx.flying(player) then
			table.insert(ground, player)
		end
	end
	if #ground < Config.ONE_WORD_MIN_PLAYERS then
		return false
	end
	if performedRound ~= Match.roundId then
		performedRound = Match.roundId
		table.clear(performed)
	end
	ctx.show(Config.TEXT.ONE_WORD_START)
	ctx.screen({ kind = "oneWordBell", endsAt = Match.now() + Config.BELL_ORDER_SECONDS })
	local rung = ctx.bell(ground, Config.BELL_ORDER_SECONDS, false)
	if ctx.cancelled() then
		return nil
	end
	local performers = choosePerformers(ctx, rung)
	if #performers < Config.ONE_WORD_MIN_PLAYERS then
		return nil -- (people flew or left during the bells: it was started, so it counts)
	end
	local given: { [string]: boolean } = {}
	local seen: Seen = { done = {}, flew = {} }
	-- Flights are noted all through the mission (also while the presenter chooses and during the vote).
	local running = true
	task.spawn(function()
		while running and not ctx.cancelled() do -- (an error in the mission still ends it with the round)
			noteFlights(ctx, performers, seen)
			task.wait(0.25)
		end
	end)
	local function finish(result: boolean?): boolean?
		running = false
		return result
	end
	for index = 1, #performers do
		if not turn(ctx, performers, index, given, seen) then
			return finish(nil)
		end
	end
	if not next(seen.done) then
		return finish(false) -- nobody could take a turn (no topic left)
	end
	local function eligible(): { Player }
		noteFlights(ctx, performers, seen)
		local targets = {}
		for _, player in performers do
			if seen.done[player] and not seen.flew[player] and stillIn(ctx, player) and ctx.canFling(player) then
				table.insert(targets, player)
			end
		end
		return targets
	end
	local target, byPresenter = judge(ctx, eligible)
	if ctx.cancelled() then
		return finish(nil)
	end
	if target and ctx.canFling(target) then
		if byPresenter then
			ctx.lever()
			if not ctx.wait(Config.LEVER_SECONDS) then
				return finish(nil)
			end
		end
		ctx.show(string.format(Config.TEXT.FLUNG, target.DisplayName))
		ctx.fail({ target }, "fling", true)
	else
		ctx.show(Config.TEXT.NOBODY_FLUNG)
	end
	ctx.reveal(Config.ONE_WORD_RESULT_SECONDS)
	return finish(nil)
end

return OneWord
