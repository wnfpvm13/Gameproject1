function Hearts.text(lives: number, max: number): string
	local full = math.clamp(lives, 0, max)
	local parts = {}
	if full > 0 then
		table.insert(parts, string.format('<font color="%s">%s</font>', FULL, string.rep(GLYPH, full)))
