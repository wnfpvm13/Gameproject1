do local s = Instance.new("ModuleScript"); s.Name = "Hud"; s.Source = [====[--!strict
-- Status board at the top centre: phase + message, timer, my lives (hearts) and survivors. Kept short (64 px) so the
-- chair row under it stays visible.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Hearts = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Hearts"))
local Style = require(script.Parent:WaitForChild("Style"))

local Hud = {}

local PHASE_TITLE = {
	Lobby = "대기 중",
	Countdown = "곧 시작",
	Assign = "자리 배정",
	Play = "본 경기", -- not "게임": a word-bank word, and players read this aloud
	Final = "결승",
	Result = "결과",
}

local statusL: TextLabel
local timerL: TextLabel
local aliveL: TextLabel
local livesL: TextLabel

function Hud.build()
	local top = Style.panel(Style.gui(), Style.PANEL, 0.2, 14)
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 8)
	top.Size = UDim2.new(0.5, 0, 0, 64)
	Style.limit(top, Vector2.new(320, 0), Vector2.new(580, 200))

	statusL = Style.label(top, Style.BOLD, 22, Style.WHITE)
	statusL.Position = UDim2.fromScale(0.04, 0.06)
	statusL.Size = UDim2.fromScale(0.92, 0.46)
	timerL = Style.label(top, Style.BOLD, 22, Style.AMBER)
	timerL.Position = UDim2.fromScale(0.04, 0.55)
	timerL.Size = UDim2.fromScale(0.28, 0.38)
	timerL.TextXAlignment = Enum.TextXAlignment.Left
	livesL = Style.label(top, Style.BOLD, 22, Style.WHITE)
	livesL.Position = UDim2.fromScale(0.32, 0.55)
	livesL.Size = UDim2.fromScale(0.36, 0.38)
	livesL.RichText = true
	aliveL = Style.label(top, Style.REGULAR, 20, Style.GREY)
	aliveL.Position = UDim2.fromScale(0.68, 0.55)
	aliveL.Size = UDim2.fromScale(0.28, 0.38)
	aliveL.TextXAlignment = Enum.TextXAlignment.Right
end

function Hud.setStatus(phase: string, message: string)
	statusL.Text = (PHASE_TITLE[phase] or phase) .. (if message ~= "" then " · " .. message else "")
end

function Hud.setTimer(seconds: number?)
	if not seconds then
		timerL.Text = ""
		return
	end
	local s = math.max(0, math.ceil(seconds))
	timerL.Text = string.format("%d:%02d", s // 60, s % 60)
	timerL.TextColor3 = if s <= 30 then Style.RED else Style.AMBER
end

function Hud.setAlive(alive: number, total: number)
	aliveL.Text = if total > 0 then string.format("생존 %d / %d", alive, total) else ""
end

-- nil hides it (not playing this round); `role` shows instead of the hearts (the presenter).
function Hud.setMyLives(lives: number?, max: number, role: string?)
	livesL.Text = if role then role elseif lives then "내 목숨 " .. Hearts.text(lives, max) else ""
end

return Hud
]====]; s.Parent = n7 end
do local s = Instance.new("ModuleScript"); s.Name = "MicPanel"; s.Source = [====[--!strict
-- Getting ready (docs/DESIGN_V3.md §2, §7): the voice connection and mic test lines (rows 0 and 1 under the status
-- board), and a "join by chat" button (row 2) for accounts without voice that may chat (owner 2026-10-23: voice
-- accounts join by voice only). All of it is empty while I play, so nothing covers the chair row (a voice player
-- still sees a muted mic warning).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Style = require(script.Parent:WaitForChild("Style"))

local MicPanel = {}

export type Ready = {
	status: string, -- Speech.status(): NoVoice / Disconnected / Muted / Listening / Speaking
	micTested: boolean,
	inMyRound: boolean, -- I play in the round being played
	readyCount: number?, -- players ready to play (voice or chat)
	chatAccess: string, -- from the server, to me only: checking / yes / no / voice / error
	chatMode: boolean, -- I join by chat (server attribute BW_ChatMode)
}

local TEXT = Config.TEXT
local voiceL: TextLabel
local testL: TextLabel
local chatButton: TextButton
local chatMode = false

-- onChat(on): the player pressed the chat button (join by chat, or stop).
function MicPanel.build(onChat: (boolean) -> ())
	voiceL = Style.line(0, Style.RED)
	testL = Style.line(1, Style.AMBER)
	chatButton = Instance.new("TextButton")
	chatButton.Name = "ChatJoin"
	chatButton.AnchorPoint = Vector2.new(0.5, 0)
	chatButton.Position = UDim2.new(0.5, 0, 0, Style.row(2) + 2)
	chatButton.Size = UDim2.fromOffset(240, 34)
	chatButton.BackgroundColor3 = Style.PANEL
	chatButton.BackgroundTransparency = 0.15
	chatButton.FontFace = Style.BOLD
	chatButton.TextSize = 18
	chatButton.TextColor3 = Style.AMBER
	chatButton.Visible = false
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = chatButton
	chatButton.Parent = Style.gui()
	chatButton.Activated:Connect(function()
		onChat(not chatMode)
	end)
end

-- The server found no voice on this account (chat checked instead): "connect voice" would ask for the impossible.
local function noVoiceAccount(r: Ready): boolean
	return r.chatAccess == "yes" or r.chatAccess == "no" or r.chatAccess == "error"
end

local function voiceLine(r: Ready): string
	if r.chatMode then
		return "" -- playing by chat: no voice nagging
	elseif r.status == "NoVoice" or (r.status == "Disconnected" and noVoiceAccount(r)) then
		return TEXT.VOICE_NONE
	elseif r.status == "Disconnected" then
		return TEXT.VOICE_CONNECT
	elseif r.status == "Muted" then
		return TEXT.VOICE_MUTED
	end
	return ""
end

-- Without a connected voice: what the chat check says I can do.
local function withoutVoice(r: Ready): string
	if r.chatAccess == "yes" then
		return TEXT.OR_CHAT
	elseif r.chatAccess == "checking" then
		return TEXT.CHAT_CHECKING
	elseif r.chatAccess == "error" then
		return TEXT.CHAT_CHECK_FAILED
	elseif r.chatAccess == "no" then
		return TEXT.NO_VOICE_NO_CHAT
	end
	return TEXT.CONNECT_TO_PLAY -- a voice account: connect voice
end

-- What the player should do next to take a seat (and whether that is done).
local function nextStep(r: Ready): (string, boolean)
	if r.inMyRound then
		return "", false
	elseif r.chatMode then
		return TEXT.CHAT_JOINED, true
	elseif r.status == "NoVoice" or r.status == "Disconnected" then
		return withoutVoice(r), false
	elseif r.status == "Muted" then
		return TEXT.MIC_ON, false
	elseif not r.micTested then
		return TEXT.MIC_TEST, false
	end
	local ready = if r.readyCount then string.format(TEXT.READY_COUNT, r.readyCount) else TEXT.READY
	return ready .. " · " .. TEXT.HEADSET_TIP, true
end

function MicPanel.set(r: Ready)
	chatMode = r.chatMode
	voiceL.Text = voiceLine(r)
	local text, done = nextStep(r)
	testL.Text = text
	testL.TextColor3 = if done then Style.GREEN else Style.AMBER
	local noVoice = r.status == "NoVoice" or r.status == "Disconnected"
	chatButton.Visible = not r.inMyRound and (r.chatMode or (r.chatAccess == "yes" and noVoice))
	chatButton.Text = if r.chatMode then TEXT.CHAT_CANCEL else TEXT.CHAT_JOIN
end

return MicPanel
]====]; s.Parent = n7 end
do local s = Instance.new("ModuleScript"); s.Name = "MissionPanel"; s.Source = [====[--!strict
-- The mission card in the middle of the screen (docs/DESIGN_V3.md §5; bundle 4a):
--   - quiz: the question, four answer buttons (only for players who may answer) and the seconds left; afterwards the
--     right answer turns green and my wrong pick red;
--   - roulette (owner 2026-10-23: a 2D wheel): the names on a ring and a pointer that spins and slows down onto the
--     name the server picked; with two players a coin flips between the two names instead;
--   - a word to everyone (bundle 4b): whose turn, the topic, the seconds left, and for the performer a "swap topic"
--     button while they read it; then "the presenter is choosing", or a vote: the performers, "nobody" and "I could
--     not hear" (my own name cannot be picked);
--   - the banned-word talk (bundle 6a): one slim line under the status board, "topic · seconds left" (the middle of the
--     screen stays free: the players read each other's words over their heads there);
--   - the bells (bundle 6b): "ring to speak first" before "say what you like", and the bell quiz: the question, then
--     who is answering (the right answer comes as a quiz result).
-- It only shows what it is told and reports the button pressed; the server checks every answer.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Style = require(script.Parent:WaitForChild("Style"))

local MissionPanel = {}

local TWO_PI = 2 * math.pi
local RING_RADIUS = 112 -- pixels from the wheel centre to the names (up to RING_FULL names; more push it out)
local RING_FULL = 6
local PILL_WIDTH = 104
local SPIN_TURNS = 4 -- whole turns before the pointer stops
local COIN_SIZE = 170
local MAX_BUTTONS = Config.ONE_WORD_MAX_PERFORMERS + 2 -- a vote: the performers, "nobody", "could not hear"
local TEXT = Config.TEXT
local SLICE_COLORS = { Color3.fromRGB(40, 92, 170), Color3.fromRGB(62, 66, 92) } -- name pills, alternating

local card: Frame
local cardScale: UIScale
local title: TextLabel
local timer: TextLabel
local note: TextLabel
local swapButton: TextButton
local answerGrid: Frame
local buttons: { TextButton } = {}
local wheel: Frame
local pointer: Frame
local disc: Frame
local needle: Frame
local arrow: TextLabel
local coin: TextLabel
local ringPills: { Frame } = {}
local onAnswer: (number, number) -> () = function(_id, _choice) end

local state = {
	kind = "none",
	endsAt = 0,
	canAnswer = false,
	question = "",
	id = 0, -- the open question's number (sent back with the answer)
	myPick = nil :: number?,
	myId = 0,
	voteIds = {} :: { number }, -- a vote's candidates (my own name cannot be picked)
	-- roulette
	names = {} :: { string },
	pick = 1,
	startsAt = 0,
	spinSeconds = 1,
	topicLine = "", -- the banned-word talk's topic line (the seconds are added every frame)
}
local CARD_POSITION = UDim2.fromScale(0.5, 0.56) -- a little low: the status board sits above
local TALK_POSITION = UDim2.new(0.5, 0, 0, Style.row(4)) -- the talk's slim line: under the status board and the
-- getting-ready lines (rows 1-3), above the chair row

local function answerButton(index: number): TextButton
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = Style.PANEL
	b.BackgroundTransparency = 0.1
	b.FontFace = Style.BOLD
	b.TextScaled = true
	b.TextColor3 = Style.WHITE
	b.AutoButtonColor = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = b
	local size = Instance.new("UITextSizeConstraint")
	size.MaxTextSize = 22
	size.Parent = b
	b.LayoutOrder = index
	b.Activated:Connect(function()
		local open = state.endsAt > 0 and workspace:GetServerTimeNow() < state.endsAt -- (not while the question shows first)
		local mine = state.kind == "vote" and state.voteIds[index] == state.myId
		if (state.kind == "quiz" or state.kind == "vote") and state.canAnswer and open and not state.myPick and not mine then
			state.myPick = index
			onAnswer(state.id, index)
			for i, other in buttons do
				other.BackgroundColor3 = if i == index then Style.AMBER else Style.PANEL
				other.TextColor3 = if i == index then Style.PANEL else Style.GREY -- (answered: nothing else can be pressed)
				other.AutoButtonColor = false
			end
		end
	end)
	b.Parent = answerGrid
	return b
end

-- onPick(questionId, choice): I pressed an answer button.
function MissionPanel.build(onPick: (number, number) -> ())
	onAnswer = onPick
	card = Style.panel(Style.gui(), Style.PANEL, 0.2, 16)
	card.Name = "MissionCard"
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = CARD_POSITION
	card.Size = UDim2.fromScale(0.5, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.Visible = false
	Style.limit(card, Vector2.new(320, 0), Vector2.new(580, 600))
	cardScale = Instance.new("UIScale") -- shrinks the card on short screens (tick)
	cardScale.Parent = card
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 12)
	pad.PaddingBottom = UDim.new(0, 14)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = card
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 10)
	layout.Parent = card

	timer = Style.label(card, Style.BOLD, 20, Style.AMBER)
	timer.Size = UDim2.new(1, 0, 0, 22)
	timer.LayoutOrder = 0
	title = Style.label(card, Style.BOLD, 26, Style.WHITE)
	title.Size = UDim2.new(1, 0, 0, 64)
	title.LayoutOrder = 1
	note = Style.label(card, Style.REGULAR, 18, Style.GREY)
	note.Size = UDim2.new(1, 0, 0, 22)
	note.LayoutOrder = 2

	answerGrid = Instance.new("Frame")
	answerGrid.BackgroundTransparency = 1
	answerGrid.Size = UDim2.fromScale(1, 0)
	answerGrid.AutomaticSize = Enum.AutomaticSize.Y
	answerGrid.LayoutOrder = 3
	answerGrid.Parent = card
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -4, 0, 52)
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = answerGrid
	for i = 1, MAX_BUTTONS do
		buttons[i] = answerButton(i)
	end

	swapButton = Instance.new("TextButton")
	swapButton.Size = UDim2.fromOffset(200, 40)
	swapButton.BackgroundColor3 = Style.AMBER
	swapButton.FontFace = Style.BOLD
	swapButton.TextSize = 20
	swapButton.TextColor3 = Style.PANEL
	swapButton.Text = TEXT.ONE_WORD_SWAP
	swapButton.LayoutOrder = 4
	swapButton.Visible = false
	local swapCorner = Instance.new("UICorner")
	swapCorner.CornerRadius = UDim.new(0, 10)
	swapCorner.Parent = swapButton
	swapButton.Parent = card
	swapButton.Activated:Connect(function()
		if state.kind == "oneWord" and state.id > 0 and workspace:GetServerTimeNow() < state.endsAt then
			swapButton.Visible = false
			onAnswer(state.id, 1)
		end
	end)

	-- The wheel: a round disc with an amber rim, the names as pills on a ring, a needle from the hub.
	wheel = Instance.new("Frame")
	wheel.BackgroundTransparency = 1
	wheel.Size = UDim2.fromOffset(2 * RING_RADIUS + 120, 2 * RING_RADIUS + 50)
	wheel.LayoutOrder = 5
	wheel.Parent = card
	disc = Style.panel(wheel, Color3.fromRGB(26, 32, 46), 0, 1000)
	disc.AnchorPoint = Vector2.new(0.5, 0.5)
	disc.Position = UDim2.fromScale(0.5, 0.5)
	disc.Size = UDim2.fromOffset(2 * RING_RADIUS + 44, 2 * RING_RADIUS + 44)
	local rim = Instance.new("UIStroke")
	rim.Color = Style.AMBER
	rim.Thickness = 4
	rim.Parent = disc
	pointer = Instance.new("Frame")
	pointer.BackgroundTransparency = 1
	pointer.AnchorPoint = Vector2.new(0.5, 0.5)
	pointer.Position = UDim2.fromScale(0.5, 0.5)
	pointer.Size = UDim2.fromOffset(2 * RING_RADIUS, 2 * RING_RADIUS)
	pointer.ZIndex = 3
	pointer.Parent = wheel
	needle = Style.panel(pointer, Style.AMBER, 0, 3)
	needle.AnchorPoint = Vector2.new(0.5, 1)
	needle.Position = UDim2.fromScale(0.5, 0.5)
	needle.Size = UDim2.fromOffset(6, RING_RADIUS - 40)
	needle.ZIndex = 3
	arrow = Style.label(pointer, Style.BOLD, 30, Style.AMBER)
	arrow.Text = "▲"
	arrow.AnchorPoint = Vector2.new(0.5, 1)
	arrow.Position = UDim2.new(0.5, 0, 0.5, -(RING_RADIUS - 40) + 6)
	arrow.Size = UDim2.fromOffset(30, 26)
	arrow.ZIndex = 3
	local hub = Style.panel(wheel, Style.AMBER, 0, 100)
	hub.AnchorPoint = Vector2.new(0.5, 0.5)
	hub.Position = UDim2.fromScale(0.5, 0.5)
	hub.Size = UDim2.fromOffset(26, 26)
	hub.ZIndex = 4

	coin = Style.label(card, Style.BOLD, 30, Style.PANEL)
	coin.BackgroundColor3 = Style.AMBER
	coin.BackgroundTransparency = 0
	coin.Size = UDim2.fromOffset(COIN_SIZE, COIN_SIZE)
	coin.LayoutOrder = 6
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(1, 0)
	round.Parent = coin
end

-- Sizes the wheel for a ring of this radius (more names need a wider ring so the pills do not overlap).
local function sizeWheel(radius: number)
	wheel.Size = UDim2.fromOffset(2 * radius + PILL_WIDTH + 16, 2 * radius + 50)
	disc.Size = UDim2.fromOffset(2 * radius + 44, 2 * radius + 44)
	pointer.Size = UDim2.fromOffset(2 * radius, 2 * radius)
	needle.Size = UDim2.fromOffset(6, radius - 40)
	arrow.Position = UDim2.new(0.5, 0, 0.5, -(radius - 40) + 6)
end

local function setRing(names: { string })
	-- Neighbouring pills sit 2*r*sin(pi/n) apart; keep that at least the pill width once there are many names.
	local radius = math.max(RING_RADIUS, (PILL_WIDTH + 6) / (2 * math.sin(math.pi / math.max(#names, RING_FULL))))
	sizeWheel(radius)
	for _, pill in ringPills do
		pill:Destroy()
	end
	table.clear(ringPills)
	for i, name in names do
		local angle = (i - 1) / #names * TWO_PI -- clockwise from the top
		local pill = Style.panel(wheel, SLICE_COLORS[(i - 1) % 2 + 1], 0, 14)
		pill.AnchorPoint = Vector2.new(0.5, 0.5)
		pill.Position = UDim2.new(0.5, math.sin(angle) * radius, 0.5, -math.cos(angle) * radius)
		pill.Size = UDim2.fromOffset(PILL_WIDTH, 30)
		pill.ZIndex = 2
		local label = Style.label(pill, Style.BOLD, 18, Style.WHITE)
		label.Size = UDim2.new(1, -8, 1, -4)
		label.Position = UDim2.fromOffset(4, 2)
		label.Text = name
		label.ZIndex = 2
		table.insert(ringPills, pill)
	end
end

local function easeOut(t: number): number
	return 1 - (1 - t) ^ 3
end

-- Colours one answer button: open (can be pressed), mine (my pick), or neither.
local function paint(b: TextButton, open: boolean, picked: boolean)
	b.AutoButtonColor = open
	b.BackgroundColor3 = if picked then Style.AMBER else Style.PANEL
	b.TextColor3 = if picked then Style.PANEL elseif open then Style.WHITE else Style.GREY
end

-- What the server says the mission shows now. `canAnswer`: I am alive and on the ground (my buttons work);
-- `names`: the payload's players (`ids`) by name, in the server's order; `myId`: my UserId.
function MissionPanel.show(payload: { [string]: any }, canAnswer: boolean, names: { string }, myId: number)
	local kind = payload.kind
	local quizLike = kind == "quiz" or kind == "quizResult"
	local newQuestion = if quizLike then payload.question ~= state.question
		elseif kind == "vote" then payload.id ~= nil and payload.id ~= state.id
		else true
	if newQuestion then
		state.myPick = nil -- a new question (a quiz comes twice: before and once the buttons work), a new vote, or none
	end
	state.question = if quizLike then payload.question else ""
	state.id = payload.id or 0
	state.kind = kind
	state.endsAt = payload.endsAt or 0
	state.canAnswer = canAnswer
	state.myId = myId
	local bells = kind == "oneWordBell" or kind == "bellQuiz"
	card.Visible = quizLike or kind == "roulette" or kind == "oneWord" or kind == "oneWordJudge" or kind == "vote"
		or kind == "talk" or bells
	answerGrid.Visible = quizLike or kind == "vote"
	title.Visible = quizLike or kind == "oneWord" or kind == "oneWordJudge" or kind == "vote" or kind == "talk" or bells
	timer.Visible = quizLike or kind == "oneWord" or kind == "vote" or bells
	note.Visible = kind == "oneWord" or kind == "bellQuiz"
	local slim = kind == "talk"
	card.AnchorPoint = if slim then Vector2.new(0.5, 0) else Vector2.new(0.5, 0.5)
	card.Position = if slim then TALK_POSITION else CARD_POSITION
	title.TextSize = if slim then 22 else 26
	title.Size = UDim2.new(1, 0, 0, if slim then 30 else 64)
	swapButton.Visible = false
	wheel.Visible = kind == "roulette" and #names > 2
	coin.Visible = kind == "roulette" and #names <= 2
	if quizLike then
		title.Text = payload.question
		local choices = payload.choices :: { string }
		for i, b in buttons do
			b.Visible = choices[i] ~= nil
			b.Text = choices[i] or ""
			local open = kind == "quiz" and canAnswer and payload.endsAt ~= nil and not state.myPick
			if kind == "quizResult" then
				local right = i == payload.answer
				b.AutoButtonColor = false
				b.BackgroundColor3 = if right then Style.GREEN elseif i == state.myPick then Style.RED else Style.PANEL
				b.TextColor3 = if right or i == state.myPick then Style.PANEL else Style.GREY
			else
				paint(b, open, i == state.myPick)
			end
		end
	elseif kind == "vote" then
		title.Text = TEXT.JUDGE_VOTE
		state.voteIds = payload.ids or {}
		local labels = table.clone(names)
		table.insert(labels, TEXT.VOTE_NONE)
		table.insert(labels, TEXT.VOTE_ABSTAIN)
		for i, b in buttons do
			b.Visible = labels[i] ~= nil
			b.Text = labels[i] or ""
			local mine = state.voteIds[i] == myId
			paint(b, canAnswer and not state.myPick and not mine, i == state.myPick)
		end
	elseif kind == "oneWord" then
		local current = payload.current or 1
		title.Text = string.format(TEXT.ONE_WORD_TURN, names[current] or "?", payload.topic or "")
		note.Text = if payload.phase == "prep" then TEXT.ONE_WORD_PREP elseif payload.chat then TEXT.ONE_WORD_BY_CHAT else ""
		local ids = payload.ids or {}
		swapButton.Visible = payload.phase == "prep" and not payload.swapped and payload.id ~= nil and ids[current] == myId
	elseif kind == "oneWordJudge" then
		title.Text = TEXT.JUDGE_WAIT
	elseif kind == "oneWordBell" then
		title.Text = TEXT.ONE_WORD_BELL
	elseif kind == "bellQuiz" then
		title.Text = payload.question or ""
		note.Text = if payload.stage == "answer" then string.format(TEXT.BELL_QUIZ_ANSWERING, names[1] or "?")
			else TEXT.BELL_QUIZ_WAIT
	elseif kind == "talk" then
		state.topicLine = (if payload.stage == "prep" then TEXT.TALK_SOON .. " · " else "")
			.. string.format(TEXT.TALK_TOPIC, payload.topic or "")
		title.Text = state.topicLine
	elseif kind == "roulette" then
		title.Text = ""
		state.names = names
		state.pick = payload.pick
		state.startsAt = payload.startsAt or workspace:GetServerTimeNow()
		state.spinSeconds = payload.spinSeconds or 1
		if #names > 2 then
			setRing(names)
		end
	end
	MissionPanel.tick(workspace:GetServerTimeNow())
end

-- Every frame (server time): the quiz countdown, the spinning pointer or the flipping coin, and the card's size.
function MissionPanel.tick(now: number)
	if card.Visible then
		-- Keep the card within 80% of the screen height and 90% of its width (a big wheel on a small phone screen).
		local camera = workspace.CurrentCamera
		local scale = math.max(cardScale.Scale, 0.01)
		local height = card.AbsoluteSize.Y / scale
		local width = math.max(card.AbsoluteSize.X, if wheel.Visible then wheel.AbsoluteSize.X + 28 else 0) / scale
		if camera and height > 0 and width > 0 then
			local view = camera.ViewportSize
			cardScale.Scale = math.min(1, view.Y * 0.8 / height, view.X * 0.9 / width)
		end
	end
	if state.kind == "talk" then
		timer.Text = ""
		title.Text = string.format("%s · %d", state.topicLine, math.max(0, math.ceil(state.endsAt - now)))
	elseif state.kind == "quiz" or state.kind == "vote" or state.kind == "oneWord" or state.kind == "oneWordBell"
		or state.kind == "bellQuiz" then
		timer.Text = if state.endsAt > 0 then tostring(math.max(0, math.ceil(state.endsAt - now))) else ""
	elseif state.kind == "roulette" then
		timer.Text = ""
		local t = math.clamp((now - state.startsAt) / state.spinSeconds, 0, 1)
		local count = #state.names
		if count > 2 then
			local target = SPIN_TURNS * 360 + (state.pick - 1) / count * 360
			local angle = target * easeOut(t)
			pointer.Rotation = angle
			local nearest = math.round((angle % 360) / 360 * count) % count + 1
			for i, pill in ringPills do
				local lit = i == nearest
				pill.BackgroundColor3 = if lit then Style.AMBER else SLICE_COLORS[(i - 1) % 2 + 1]
				local label = pill:FindFirstChildOfClass("TextLabel")
				if label then
					label.TextColor3 = if lit then Style.PANEL else Style.WHITE
				end
			end
		elseif count > 0 then
			-- The coin flips (its width follows the turn), showing each name in turn, slower and slower, and lands on
			-- the pick.
			local phase = easeOut(t) * (SPIN_TURNS * 4 + 1) * math.pi
			local flips = math.floor(phase / math.pi + 0.5)
			local shown = if t >= 1 then state.pick else ((state.pick - 1 + flips + 1) % count) + 1
			coin.Text = state.names[shown]
			coin.Size = UDim2.fromOffset(if t >= 1 then COIN_SIZE else math.max(8, COIN_SIZE * math.abs(math.cos(phase))), COIN_SIZE)
		end
	else
		timer.Text = ""
	end
end

return MissionPanel
]====]; s.Parent = n7 end
do local s = Instance.new("ModuleScript"); s.Name = "PresenterPanel"; s.Source = [====[--!strict
-- The presenter's controls (docs/DESIGN_V3.md §8; bundle 3, owner 2026-10-23):
--   - the "volunteer to present" button (row 3 under the status board), for anyone not playing the round;
--   - while I present: the mission menu (right side, open between games; recommended missions marked), the same menu
--     for "who flies" after a one-word mission (bundle 4b: tap a name, then "날려!"), the sound buttons (bottom
--     centre), and during the banned-word talk the word list (left side, bundles 5a/6a): every alive player with their
--     word; in the prep stage "다시 뽑기" per player (private servers) or "전원 다시 뽑기" (public servers) and
--     "▶ 바로 시작", in the talk "🔔 들었다" per player;
--   - a banned word caught in chat (bundle 5b): a red banner at the top, "name · 'word' · seconds left" and "🛟 구제".
-- It only shows what it is told and reports presses; the server checks every one of them.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Style = require(script.Parent:WaitForChild("Style"))

local PresenterPanel = {}

export type Option = { id: string, title: string, recommended: boolean }

local TEXT = Config.TEXT
local volunteerButton: TextButton
local menuFrame: Frame
local menuTitle: TextLabel
local menuList: Frame
local flingButton: TextButton
local soundBar: Frame
local wordFrame: Frame
local wordList: ScrollingFrame
local wordActions: Frame -- the prep stage's buttons under the list
local rerollAllButton: TextButton
local wordKey = "" -- what the list shows now (rebuilt only when it changes)
local rescueFrame: Frame
local rescueRows: { { label: TextLabel, endsAt: number, text: string } } = {}
local onRescue: (number) -> () = function(_userId) end
local onWordAction: (string, number) -> () = function(_mode, _userId) end
local volunteered = false
local menuEndsAt = 0
local menuKind = "pick"
local menuNote = "" -- the "verdict" menu's right answer
local selected: string? = nil -- the name tapped in a "judge" menu
local onPickMission: (string) -> () = function(_id) end

local function button(parent: Instance, text: string, width: number, height: number): TextButton
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(width, height)
	b.BackgroundColor3 = Style.PANEL
	b.BackgroundTransparency = 0.15
	b.FontFace = Style.BOLD
	b.TextSize = 18
	b.TextColor3 = Style.WHITE
	b.Text = text
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = b
	b.Parent = parent
	return b
end

export type WordRow = { userId: number, name: string, word: string }

-- onVolunteer(on), onPick(missionId), onSound(index), onWord(mode, userId) ("reroll" / "heard" with a player,
-- "rerollAll" / "start" with 0), onRescueHit(userId): the player pressed one of the controls.
function PresenterPanel.build(onVolunteer: (boolean) -> (), onPick: (string) -> (), onSound: (number) -> (),
	onWord: (string, number) -> (), onRescueHit: (number) -> ())
	onPickMission = onPick
	onWordAction = onWord
	onRescue = onRescueHit
	volunteerButton = button(Style.gui(), TEXT.VOLUNTEER, 240, 34)
	volunteerButton.Name = "Volunteer"
	volunteerButton.AnchorPoint = Vector2.new(0.5, 0)
	volunteerButton.Position = UDim2.new(0.5, 0, 0, Style.row(3) + 12) -- under the chat button (row 2, 34 px)
	volunteerButton.TextColor3 = Style.AMBER
	volunteerButton.Visible = false
	volunteerButton.ZIndex = 5 -- (the presenter's step-down stays reachable over a tall mission card)
	volunteerButton.Activated:Connect(function()
		onVolunteer(not volunteered)
	end)

	menuFrame = Style.panel(Style.gui(), Style.PANEL, 0.15, 14)
	menuFrame.Name = "MissionMenu"
	menuFrame.AnchorPoint = Vector2.new(1, 0.5)
	menuFrame.Position = UDim2.new(1, -16, 0.5, 0)
	menuFrame.Size = UDim2.fromOffset(260, 0)
	menuFrame.AutomaticSize = Enum.AutomaticSize.Y
	menuFrame.Visible = false
	menuFrame.ZIndex = 5 -- (over the mission card)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = menuFrame
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = menuFrame
	menuTitle = Style.label(menuFrame, Style.BOLD, 20, Style.AMBER)
	menuTitle.Size = UDim2.new(1, 0, 0, 26)
	menuTitle.LayoutOrder = 0
	menuList = Instance.new("Frame")
	menuList.BackgroundTransparency = 1
	menuList.Size = UDim2.fromScale(1, 0)
	menuList.AutomaticSize = Enum.AutomaticSize.Y
	menuList.LayoutOrder = 1
	menuList.Parent = menuFrame
	local listLayout = Instance.new("UIListLayout")
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = menuList
