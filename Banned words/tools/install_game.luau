do local s = Instance.new("ModuleScript"); s.Name = "Bell"; s.Source = [====[--!strict
-- My seat bell (docs/DESIGN_V3.md §5.1, §9; bundle 6b): a ProximityPrompt on my own chair's bell only (E, gamepad X,
-- touch; the chairs stand 5 studs apart, so a prompt on every bell would reach the neighbours' too). It is enabled
-- while the server has my bell open; a press asks the server to ring it (the server checks everything). Also finds any
-- player's bell, by the chair their character sits on, for the ding and the light. The prompt draws nothing (Custom
-- style, review 2026-10-25: its "E 벨" box sat over the seated players); E still rings, and the screen bell button
-- shows the key.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))

local Bell = {}

local PROMPT_DISTANCE = 10 -- studs (a seated player is about 2.5 studs from their bell)

local prompt: ProximityPrompt? = nil
local promptOn: BasePart? = nil
local onRing: () -> () = function() end

-- The bell model next to the chair `player` sits on (map contract: PoolHall.Chairs.ChairNN.Bell), or nil.
function Bell.bellOf(player: Player): Model?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hall = workspace:FindFirstChild("PoolHall")
	local chairs = hall and hall:FindFirstChild("Chairs")
	if not (humanoid and chairs) then
		return nil
	end
	for _, chair in chairs:GetChildren() do
		local seat = chair:FindFirstChild("Seat")
		if seat and seat:IsA("Seat") and seat.Occupant == humanoid then
			local bell = chair:FindFirstChild("Bell")
			return if bell and bell:IsA("Model") then bell else nil
		end
	end
	return nil
end

-- ring(): I pressed my bell (prompt or the screen button).
function Bell.start(ring: () -> ())
	onRing = ring
end

-- Whether I may ring now (my bell is open and I sit on my chair): the prompt goes to my chair's bell and is enabled.
function Bell.set(canRing: boolean)
	local bell = if canRing then Bell.bellOf(Players.LocalPlayer) else nil
	local button = bell and bell.PrimaryPart
	if button ~= promptOn then
		if prompt then
			prompt:Destroy()
			prompt = nil
		end
		promptOn = button
		if button then
			local p = Instance.new("ProximityPrompt")
			p.ActionText = Config.TEXT.BELL_BUTTON
			p.KeyboardKeyCode = Enum.KeyCode.E
			p.HoldDuration = 0
			p.MaxActivationDistance = PROMPT_DISTANCE
			p.RequiresLineOfSight = false
			p.Style = Enum.ProximityPromptStyle.Custom
			p.Triggered:Connect(function()
				onRing()
			end)
			p.Parent = button
			prompt = p
		end
	end
	if prompt then
		prompt.Enabled = canRing
	end
end

return Bell
]====]; s.Parent = n6 end
do local s = Instance.new("ModuleScript"); s.Name = "Billboards"; s.Source = [====[--!strict
-- Head bubbles: name and lives (hearts) for every participant on the chairs, me included (the presenter's bubble says
-- "진행자" instead of hearts), and from bundle 5 the banned words above them: each other participant's visible words
-- (a new one flashes) and "???" for my own.
-- The V3 pool hall is white, so word cards carry a thick navy outline and the name sits on a navy pill.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local shared = ReplicatedStorage:WaitForChild("BannedWords")
local Config = require(shared:WaitForChild("Config"))
local Hearts = require(shared:WaitForChild("Hearts"))

local Billboards = {}

local WORD_FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
local NAME_FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
local WIDTH = 4.6 -- studs; the flying chairs are 5 studs apart
local ROW = 1.4 -- studs per word row (review 2026-10-25: 1.0 was too small to read from the show camera)
local NAME_ROW = 0.9
local HEART_ROW = 0.8
-- (the HUD's sticker look, owner 2026-10-25: paper and dark outlines; 2026-10-24 the name pill was black)
-- (the same values as UI/Style's KEY, INK and PAPER: a world tag may not require the HUD's Style, deps rule)
local CARD_COLOR = Color3.fromRGB(255, 255, 255)
local NEW_COLOR = Color3.fromRGB(255, 212, 59)
local OUTLINE = Color3.fromRGB(34, 35, 38)
local NAME_PILL = Color3.fromRGB(255, 251, 240)
local NAME_INK = Color3.fromRGB(34, 35, 38)
local HIDDEN = "???" -- my own words while I play

local GROW_SECONDS = 0.15 -- hit(): the pop grows, then settles back
local SETTLE_SECONDS = 0.35

export type View = {
	show: { number }, -- userIds that get a bubble
	words: { [string]: { words: { string }?, count: number } }, -- nil words = hidden (my own)
	lives: { [string]: number },
	maxLives: number,
	presenter: number?, -- the presenter's userId (their bubble shows the presenter tag)
}

type Bubble = { gui: BillboardGui, size: UDim2, hearts: TextLabel, words: { string }, layout: string }
local bubbles: { [number]: Bubble } = {}
local dying: { [number]: boolean } = {} -- bubbles of players just out, kept until their pop is over
local lastView: View? = nil -- drawn again when a pop is over (the round may show that player again by then)

local function removeBubble(userId: number)
	local bubble = bubbles[userId]
	if not bubble then
		return
	end
	-- Give the default name tag back once the bubble (which carried the name) is gone.
	local character = bubble.gui.Parent and bubble.gui.Parent.Parent
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	end
	bubble.gui:Destroy()
	bubbles[userId] = nil
end

local function wordRow(parent: Instance, text: string, order: number, fresh: boolean): Frame
	local row = Instance.new("Frame")
	row.Name = "Word" .. order
	row.LayoutOrder = order
	row.Size = UDim2.new(1, 0, 1, 0) -- resized by the caller
	row.BackgroundColor3 = if fresh then NEW_COLOR else CARD_COLOR
	row.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.25, 0)
	corner.Parent = row
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = OUTLINE
	stroke.Parent = row
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = WORD_FONT
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(30, 30, 36)
	label.Text = text
	label.Parent = row
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.Parent = label
	if fresh then
		task.delay(3, function()
			if row.Parent then
				TweenService:Create(row, TweenInfo.new(0.6), { BackgroundColor3 = CARD_COLOR }):Play()
			end
		end)
	end
	return row
end

-- (Re)builds one bubble: word rows (none, or "???" for hidden words), the name pill, the hearts. `previous` = the
-- words shown before, so a newly added word flashes.
local function build(player: Player, words: { string }, caption: string, previous: { string }?): Bubble?
	local head = player.Character and player.Character:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local wordsHeight = #words * ROW
	local total = wordsHeight + NAME_ROW + HEART_ROW
	local gui = Instance.new("BillboardGui")
	gui.Name = "WordBubble"
	gui.Size = UDim2.fromScale(WIDTH, total)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 1.6 + total / 2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 150
	gui.LightInfluence = 0

	if #words > 0 then
		local list = Instance.new("Frame")
		list.Name = "Words"
		list.BackgroundTransparency = 1
		list.Size = UDim2.fromScale(1, wordsHeight / total)
		list.Parent = gui
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0.04, 0)
		layout.Parent = list
		for i, text in words do
			local fresh = previous ~= nil and text ~= HIDDEN and not table.find(previous, text)
			local row = wordRow(list, text, i, fresh)
			row.Size = UDim2.new(1, 0, 1 / #words, -2)
		end
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Caption"
	nameLabel.BackgroundColor3 = NAME_PILL
	nameLabel.BackgroundTransparency = 0
	nameLabel.Position = UDim2.fromScale(0.1, wordsHeight / total + 0.02)
	nameLabel.Size = UDim2.fromScale(0.8, NAME_ROW / total - 0.02)
	nameLabel.FontFace = NAME_FONT
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = NAME_INK
	nameLabel.Text = caption
	nameLabel.Parent = gui
	local pillCorner = Instance.new("UICorner")
	pillCorner.CornerRadius = UDim.new(0.5, 0)
	pillCorner.Parent = nameLabel
	local pillEdge = Instance.new("UIStroke")
	pillEdge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	pillEdge.Thickness = 2
	pillEdge.Color = OUTLINE
	pillEdge.Parent = nameLabel
	local namePad = Instance.new("UIPadding")
	namePad.PaddingTop = UDim.new(0.12, 0)
	namePad.PaddingBottom = UDim.new(0.12, 0)
	namePad.PaddingLeft = UDim.new(0.06, 0)
	namePad.PaddingRight = UDim.new(0.06, 0)
	namePad.Parent = nameLabel

	local hearts = Instance.new("TextLabel")
	hearts.Name = "Hearts"
	hearts.BackgroundTransparency = 1
	hearts.Position = UDim2.fromScale(0.15, (wordsHeight + NAME_ROW) / total)
	hearts.Size = UDim2.fromScale(0.7, HEART_ROW / total)
	hearts.FontFace = NAME_FONT
	hearts.TextScaled = true
	hearts.RichText = true
	hearts.TextStrokeColor3 = OUTLINE
	hearts.TextStrokeTransparency = 0
	hearts.Parent = gui

	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	gui.Adornee = head
	gui.Parent = head
	return { gui = gui, size = gui.Size, hearts = hearts, words = table.clone(words), layout = "" }
end

-- Draws exactly the bubbles in view.show (plus the ones of players just out, until their pop is over). A bubble is
-- rebuilt only when its words or name changed; new lives just change its hearts (so a running pop goes on).
-- Returns how many studs the tallest tag's word rows add (the chat bubbles go up by as much, ChatLook).
function Billboards.render(view: View): number
	lastView = view
	local tallest = 0
	local keep: { [number]: boolean } = {}
	for userId in dying do
		keep[userId] = true
	end
	for _, userId in view.show do
		local player = Players:GetPlayerByUserId(userId)
		local head = player and player.Character and player.Character:FindFirstChild("Head")
		if player and head and not dying[userId] then
			keep[userId] = true
			local key = tostring(userId)
			local entry = view.words[key]
			local words = if not entry then {} elseif entry.words then entry.words else { HIDDEN }
			tallest = math.max(tallest, #words * ROW)
			local caption = player.DisplayName
			local layout = table.concat(words, "|") .. "#" .. caption
			local bubble: Bubble? = bubbles[userId]
			if not bubble or bubble.layout ~= layout or bubble.gui.Parent ~= head then
				local previous = if bubble then bubble.words else nil
				removeBubble(userId)
				bubble = build(player, words, caption, previous)
				if bubble then
					bubble.layout = layout
					bubbles[userId] = bubble
				end
			end
			if bubble then
				bubble.hearts.Text = if userId == view.presenter
					then Config.TEXT.PRESENTER_TAG
					else Hearts.text(view.lives[key] or 0, view.maxLives)
			end
		end
	end
	for userId in bubbles do
		if not keep[userId] then
			removeBubble(userId)
		end
	end
	return tallest
end

-- Lost a life: the hearts show the lives left and the bubble pops. The bubble of a player who is out stays until the
-- pop is over; then the latest view is drawn again (it goes, unless the round still shows them, e.g. in the result).
function Billboards.hit(userId: number, lives: number, maxLives: number, out: boolean)
	local bubble = bubbles[userId]
	if not bubble then
		return
	end
	bubble.hearts.Text = Hearts.text(lives, maxLives)
	local gui = bubble.gui
	local size = bubble.size
	local grow = TweenService:Create(gui, TweenInfo.new(GROW_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(size.X.Scale * 1.35, size.Y.Scale * 1.35),
	})
	grow.Completed:Once(function()
		if gui.Parent then
			TweenService:Create(gui, TweenInfo.new(SETTLE_SECONDS, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = size }):Play()
		end
	end)
	grow:Play()
	if out then
		dying[userId] = true
		task.delay(GROW_SECONDS + SETTLE_SECONDS + 0.2, function()
			dying[userId] = nil
			if lastView then
				Billboards.render(lastView)
			end
		end)
	end
end

return Billboards
]====]; s.Parent = n6 end
do local s = Instance.new("ModuleScript"); s.Name = "Bottles"; s.Source = [====[--!strict
-- 물병 세우기's bottles (bundle 8b, owner 2026-10-24): while the game runs every player in it gets a little round
-- table in front of their chair (toward the show camera, beside their knees; the gaps between chairs hold the bells)
-- with a water bottle on it, and each throw flips the bottle: it jumps, turns over twice and lands standing or on its
-- side (a player who joins mid-game gets them at the next screen). Everything is drawn on this client only (the server says who stood); nothing collides or can be touched.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Bottles = {}

local TABLE_HEIGHT = 1.5 -- studs above the floor to the table top
local TABLE_RADIUS = 0.75
local BOTTLE_SIZE = Vector3.new(0.6, 1.5, 0.6)
local IN_FRONT = 2.6 -- studs in front of the seat (toward the camera)
local TO_THE_LEFT = 0.9 -- and a little to the seated player's left (their right hand is on the bell)
local JUMP = 2.2 -- studs the bottle rises while it flips
local FLIP_SECONDS = 0.8
local TURNS = 2 -- whole turns in the air

local folder: Folder? = nil
local bottles: { [number]: { part: BasePart, rest: CFrame } } = {} -- userId -> its bottle and resting place

local function part(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	if shape then
		p.Shape = shape
	end
	p.Parent = folder
	return p
end

-- The floor height under `point` (the carpet), or `fallback`.
local function floorAt(point: Vector3, fallback: number, ignore: { Instance }): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(point + Vector3.new(0, 4, 0), Vector3.new(0, -12, 0), params)
	return if hit then hit.Position.Y else fallback
end

-- A table and a standing bottle for each of `userIds` who sits on a chair now.
function Bottles.setup(userIds: { number })
	Bottles.clear()
	local f = Instance.new("Folder")
	f.Name = "BW_Bottles"
	f.Parent = workspace
	folder = f
	local ignore: { Instance } = { f }
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	for _, userId in userIds do
		local player = Players:GetPlayerByUserId(userId)
		local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if seat then
			local chair = seat.Parent
			if chair then
				table.insert(ignore, chair)
			end
			-- (the seat faces the camera: its -Z; its -X is the seated player's left)
			local spot = seat.CFrame * CFrame.new(-TO_THE_LEFT, 0, -IN_FRONT)
			local floor = floorAt(spot.Position, seat.Position.Y - 2, ignore)
			local top = floor + TABLE_HEIGHT
			local flat = CFrame.new(spot.Position.X, 0, spot.Position.Z)
			part("Leg", Vector3.new(TABLE_HEIGHT, 0.25, 0.25), flat * CFrame.new(0, floor + TABLE_HEIGHT / 2, 0)
				* CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(220, 224, 230), Enum.Material.Metal, Enum.PartType.Cylinder)
			part("Top", Vector3.new(0.15, TABLE_RADIUS * 2, TABLE_RADIUS * 2), flat * CFrame.new(0, top, 0)
				* CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(250, 250, 250), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
			local rest = flat * CFrame.new(0, top + 0.075 + BOTTLE_SIZE.Y / 2, 0)
			local bottle = part("Bottle", BOTTLE_SIZE, rest, Color3.fromRGB(120, 200, 255), Enum.Material.Glass)
			bottle.Transparency = 0.1 -- (see-through glass vanished against the white deck in the Studio check)
			local cap = part("Cap", Vector3.new(0.3, 0.18, 0.3), rest * CFrame.new(0, BOTTLE_SIZE.Y / 2 + 0.09, 0),
				Color3.fromRGB(40, 110, 220), Enum.Material.SmoothPlastic)
			local weld = Instance.new("WeldConstraint") -- (the cap follows the bottle's CFrame changes)
			weld.Part0 = bottle
			weld.Part1 = cap
			weld.Parent = bottle
			cap.Anchored = false
			bottles[userId] = { part = bottle, rest = rest }
		end
	end
end

-- A throw: `userId`'s bottle jumps, turns over TURNS times and lands standing (`standing`) or on its side. Drawn frame
-- by frame (a tween takes the shortest way round and would not turn twice).
function Bottles.flip(userId: number, standing: boolean)
	local entry = bottles[userId]
	if not entry then
		return
	end
	local bottle, rest = entry.part, entry.rest
	local fallen = rest * CFrame.new(0, -BOTTLE_SIZE.Y / 2 + BOTTLE_SIZE.X / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	local started = os.clock()
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - started) / FLIP_SECONDS)
		if bottles[userId] ~= entry then
			connection:Disconnect() -- (cleared meanwhile)
			return
		end
		if t >= 1 then
			connection:Disconnect()
			bottle.CFrame = if standing then rest else fallen
			return
		end
		local height = 4 * JUMP * t * (1 - t) -- (up and down again)
		local turn = TURNS * 2 * math.pi * t
		bottle.CFrame = rest * CFrame.new(0, height, 0) * CFrame.Angles(turn, 0, 0)
	end)
end

-- Back to standing for the next throw.
function Bottles.reset()
	for _, entry in bottles do
		entry.part.CFrame = entry.rest
	end
end

function Bottles.clear()
	if folder then
		folder:Destroy()
		folder = nil
	end
	table.clear(bottles)
end

return Bottles
]====]; s.Parent = n6 end
do local s = Instance.new("ModuleScript"); s.Name = "ChatLook"; s.Source = [====[--!strict
-- Chat participants' messages stand out (docs/DESIGN_V3.md §7, owner decision 2026-10-22): their bubbles are bigger,
-- bold and yellow with a keyboard mark, and the chat window puts a coloured [채팅] before their name. All bubbles also
-- stay full size out to the far stands and float above our name + hearts tag. Who joins by chat comes from the server (player attribute BW_ChatMode). Only Roblox
-- chat is decorated: nobody's text is shown anywhere else (§11). These callbacks stop running if Platform Integrated
-- Chat is turned on (mandatory from May 2027, §7), and they need TextChatService (ChatVersion) in the place.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))

local ChatLook = {}

local bubbleConfig: BubbleChatConfiguration? = nil
local raise = 0 -- studs the word rows over heads add to the tag (set before the configuration may be found)

local BUBBLE_COLOR = Color3.fromRGB(255, 214, 64)
local BUBBLE_TEXT_COLOR = Color3.fromRGB(30, 30, 36)
local BUBBLE_FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
local MARK = "⌨ " -- BubbleChatMessageProperties has no icon property, so the mark goes before the (filtered) text
local TAG_COLOR = "#F2A900" -- a deep yellow: the chat window sits over the bright white hall

local function fromChatter(message: TextChatMessage): boolean
	local source = message.TextSource
	local player = source and Players:GetPlayerByUserId(source.UserId)
	return player ~= nil and player:GetAttribute("BW_ChatMode") == true
end

-- The tags over heads got taller (word rows, client Billboards): the bubbles go up as much, so a chat bubble is never
-- hidden behind someone's words (owner 2026-10-25).
function ChatLook.setRaise(studs: number)
	raise = studs
	if bubbleConfig then
		bubbleConfig.VerticalStudsOffset = Config.CHAT_BUBBLE_VERTICAL_OFFSET + studs
	end
end

function ChatLook.start()
	task.spawn(function()
		-- (Studio adds the default configuration to a place when it opens it; a Rojo-built place file may lack it.)
		local bubbles = TextChatService:WaitForChild("BubbleChatConfiguration", 10)
		if bubbles and bubbles:IsA("BubbleChatConfiguration") then
			bubbles.MinimizeDistance = Config.CHAT_BUBBLE_MINIMIZE_DISTANCE
			bubbles.MaxDistance = Config.CHAT_BUBBLE_MAX_DISTANCE
			bubbleConfig = bubbles
			bubbles.VerticalStudsOffset = Config.CHAT_BUBBLE_VERTICAL_OFFSET + raise -- clear of our name + hearts tag
		else
			warn("[BannedWords] no BubbleChatConfiguration: chat bubbles keep Roblox's default distances")
		end
	end)
	-- (Each callback may be set in one place only; this module owns both.)
	TextChatService.OnIncomingMessage = function(message: TextChatMessage): TextChatMessageProperties?
		if not fromChatter(message) then
			return nil
		end
		local properties = Instance.new("TextChatMessageProperties")
		properties.PrefixText = string.format('<b><font color="%s">%s</font></b> %s', TAG_COLOR, Config.TEXT.CHAT_TAG, message.PrefixText)
		return properties
	end
	TextChatService.OnBubbleAdded = function(message: TextChatMessage, _adornee: Instance?): BubbleChatMessageProperties?
		if message.Text == "" or not fromChatter(message) then
			return nil
		end
		local properties = Instance.new("BubbleChatMessageProperties")
		properties.BackgroundColor3 = BUBBLE_COLOR
		properties.TextColor3 = BUBBLE_TEXT_COLOR
		properties.FontFace = BUBBLE_FONT
		properties.TextSize = Config.CHAT_BUBBLE_TEXT_SIZE
		properties.Text = MARK .. message.Text
		if message.Translation ~= "" then
			properties.Translation = MARK .. message.Translation -- viewers who see it translated get the mark too
		end
		return properties
	end
end

return ChatLook
