	if not (p and p.alive) then
		return false
	end
	if answered then
		p.afkMisses = 0
		return false
	end
	if busy(player) then
		return false
	end
	p.afkMisses += 1
	if p.afkMisses >= Config.AFK_MISSES then
		LifeService.eliminate({ player })
		return true
	end
	return false
end

