end
remotes.Parent = shared

require(script.Parent:WaitForChild("VoiceService")).start()
require(script.Parent:WaitForChild("RoundService")).start(remotes)
]====]; s.Parent = server end
local client = Instance.new("LocalScript"); client.Name = "BannedWordsClient"
client.Source = [====[-- 금칙어 게임 Korean client entry point: HUD, word bubbles and transcript forwarding.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local remotes = ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Remotes")
local Hud = require(script:WaitForChild("Hud"))
local Billboards = require(script:WaitForChild("Billboards"))
local Speech = require(script:WaitForChild("Speech"))
local ShowCamera = require(script:WaitForChild("ShowCamera"))
local FlatVoice = require(script:WaitForChild("FlatVoice"))

local player = Players.LocalPlayer

local PHASE_TITLE = {
	Lobby = "대기 중",
	Countdown = "곧 시작",
	Assign = "금칙어 배정",
	Talk = "대화 중",
	Result = "결과",
}

local state = { phase = "Lobby", endsAt = 0, participants = {}, alive = {}, message = "" }
local lastWords: { [string]: string } = {}

local function isAlive(userId: number): boolean
	return table.find(state.alive, userId) ~= nil
end

local function setResetAllowed(allowed: boolean)
	pcall(function()
		StarterGui:SetCore("ResetButtonCallback", allowed)
	end)
end

-- Keep seated participants from jumping out of their chair during a round.
local function applySeatLock()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local locked = (state.phase == "Assign" or state.phase == "Talk") and isAlive(player.UserId)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not locked)
	setResetAllowed(not locked)
end

Hud.build()
FlatVoice.start()
Speech.onStatus(Hud.setVoice)
task.spawn(Speech.start, player:WaitForChild("PlayerGui"))

Speech.onText(function(text)
	if state.phase == "Talk" and isAlive(player.UserId) then
		remotes.Transcript:FireServer(text)
	end
end)

remotes.RoundState.OnClientEvent:Connect(function(newState)
	local previous = state.phase
	state = newState
	Hud.setStatus(PHASE_TITLE[state.phase] .. " · " .. state.message)
	Hud.setAlive(#state.alive, #state.participants)
	if state.phase == "Lobby" or (state.phase == "Countdown" and previous == "Result") then
		Billboards.clear()
	end
	if state.phase == "Talk" and previous ~= "Talk" then
		Hud.toast("대화 시작!", "info")
	end
	if state.phase == "Assign" or state.phase == "Talk" then
		Billboards.show(lastWords, state.alive)
	end
	ShowCamera.set(state.phase == "Assign" or state.phase == "Talk")
	applySeatLock()
end)

remotes.Words.OnClientEvent:Connect(function(words)
	lastWords = words
	Billboards.show(words, state.participants)
end)

remotes.Eliminated.OnClientEvent:Connect(function(info)
	Billboards.remove(info.userId)
	if info.reason == "said" then
		local who = if info.userId == player.UserId then "내가" else info.name .. "님이"
		Hud.toast(string.format("삐! %s 금칙어 \"%s\"를 말했어요", who, info.word), "elim")
	end
end)

remotes.Suspect.OnClientEvent:Connect(function(info)
	Hud.toast(string.format("아슬아슬! %s", info.name), "near")
end)

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	applySeatLock()
	ShowCamera.reapply()
	if state.phase == "Assign" or state.phase == "Talk" then
		Billboards.show(lastWords, state.alive)
	end
end)

RunService.Heartbeat:Connect(function()
	local remaining = state.endsAt - workspace:GetServerTimeNow()
	Hud.setTimer(if state.phase ~= "Lobby" and remaining > 0 then remaining else nil)
end)
]====]
do local s = Instance.new("ModuleScript"); s.Name = "Hud"; s.Source = [====[--!strict
-- Top-centre round status, voice connection banner and centre toasts (elimination / near miss).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Hud = {}

local BOLD = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
local REGULAR = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Regular)
local WHITE = Color3.fromRGB(240, 240, 245)
local GREY = Color3.fromRGB(170, 175, 185)
local RED = Color3.fromRGB(255, 110, 110)
local AMBER = Color3.fromRGB(255, 200, 90)
local GREEN = Color3.fromRGB(120, 220, 140)

local gui: ScreenGui
local statusL: TextLabel
local timerL: TextLabel
local aliveL: TextLabel
local voiceL: TextLabel
local toastL: TextLabel

local function label(parent: Instance, font: Font, size: number, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.FontFace = font
	l.TextColor3 = color
	l.TextScaled = true
	l.TextWrapped = true
	l.Text = ""
	local c = Instance.new("UITextSizeConstraint", l)
	c.MaxTextSize = size
	l.Parent = parent
	return l
end

function Hud.build()
	gui = Instance.new("ScreenGui")
	gui.Name = "BannedWordsHud"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local top = Instance.new("Frame")
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 8)
	top.Size = UDim2.new(0.5, 0, 0, 86)
	top.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
	top.BackgroundTransparency = 0.2
	top.Parent = gui
	Instance.new("UICorner", top).CornerRadius = UDim.new(0, 14)
	local limit = Instance.new("UISizeConstraint", top)
	limit.MinSize = Vector2.new(300, 0)
	limit.MaxSize = Vector2.new(560, 200)

	statusL = label(top, BOLD, 26, WHITE)
	statusL.Position = UDim2.fromScale(0.04, 0.06)
	statusL.Size = UDim2.fromScale(0.92, 0.46)
	timerL = label(top, BOLD, 22, AMBER)
	timerL.Position = UDim2.fromScale(0.04, 0.55)
	timerL.Size = UDim2.fromScale(0.45, 0.38)
	timerL.TextXAlignment = Enum.TextXAlignment.Left
	aliveL = label(top, REGULAR, 20, GREY)
	aliveL.Position = UDim2.fromScale(0.51, 0.55)
	aliveL.Size = UDim2.fromScale(0.45, 0.38)
	aliveL.TextXAlignment = Enum.TextXAlignment.Right

	voiceL = label(gui, BOLD, 20, RED)
	voiceL.AnchorPoint = Vector2.new(0.5, 0)
	voiceL.Position = UDim2.new(0.5, 0, 0, 100)
	voiceL.Size = UDim2.new(0.6, 0, 0, 30)

	toastL = label(gui, BOLD, 48, WHITE)
	toastL.AnchorPoint = Vector2.new(0.5, 0.5)
	toastL.Position = UDim2.fromScale(0.5, 0.42)
	toastL.Size = UDim2.fromScale(0.8, 0.14)
	toastL.TextStrokeTransparency = 0.3
	toastL.TextTransparency = 1
	toastL.TextStrokeTransparency = 1
end

function Hud.setStatus(text: string)
	statusL.Text = text
end

function Hud.setTimer(seconds: number?)
	if not seconds then
		timerL.Text = ""
		return
	end
	local s = math.max(0, math.ceil(seconds))
	timerL.Text = string.format("%d:%02d", s // 60, s % 60)
	timerL.TextColor3 = if s <= 30 then RED else AMBER
end

function Hud.setAlive(alive: number, total: number)
	aliveL.Text = if total > 0 then string.format("생존 %d / %d", alive, total) else ""
end

function Hud.setVoice(status: string)
	if status == "NoVoice" then
		voiceL.Text = "음성 채팅을 쓸 수 없는 계정이에요 (만 13세 이상 + 연령 인증 필요)"
	elseif status == "Disconnected" then
		voiceL.Text = "음성 채팅 연결 필요 · 왼쪽 위 ≡ 메뉴(또는 ESC) → 설정 → 음성 채팅 연결"
	elseif status == "Muted" then
		voiceL.Text = "마이크가 꺼져 있어요"
	else
		voiceL.Text = ""
	end
end

function Hud.toast(text: string, kind: "elim" | "near" | "info")
	toastL.Text = text
	toastL.TextColor3 = if kind == "elim" then RED elseif kind == "near" then AMBER else GREEN
	toastL.TextTransparency = 0
	toastL.TextStrokeTransparency = 0.3
	local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2)
	TweenService:Create(toastL, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end

return Hud
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "Billboards"; s.Source = [====[--!strict
-- Word bubbles above heads: other participants show their forbidden word, the local player sees "???".
local Players = game:GetService("Players")

local Billboards = {}

local FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
local bubbles: { [number]: BillboardGui } = {}

local function bubbleFor(player: Player): BillboardGui?
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local existing = bubbles[player.UserId]
	if existing and existing.Parent == head then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "WordBubble"
	-- Sized in studs (not pixels) so ten bubbles in the 5-stud chair row never overlap on the show camera.
	gui.Size = UDim2.fromScale(4.4, 1.3)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	frame.Parent = gui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
	local stroke = Instance.new("UIStroke", frame)
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(40, 40, 48)
	local label = Instance.new("TextLabel")
	label.Name = "Word"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = FONT
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(30, 30, 36)
	label.Parent = frame
	local pad = Instance.new("UIPadding", label)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	gui.Adornee = head
	gui.Parent = head
	bubbles[player.UserId] = gui
	return gui
end

local function setText(player: Player, text: string, mine: boolean)
	local gui = bubbleFor(player)
	if not gui then
		return
	end
	local label = gui:FindFirstChild("Word", true) :: TextLabel
	label.Text = text
	label.TextColor3 = if mine then Color3.fromRGB(120, 120, 130) else Color3.fromRGB(30, 30, 36)
end

-- words: userId string -> word. Participants missing from the table are the local player (own word hidden).
function Billboards.show(words: { [string]: string }, participantIds: { number })
	local me = Players.LocalPlayer
	for _, userId in participantIds do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			local word = words[tostring(userId)]
			if word then
				setText(player, word, player == me)
			elseif player == me then
				setText(player, "???", true)
			end
		end
	end
end

function Billboards.remove(userId: number)
	local gui = bubbles[userId]
	if gui then
		gui:Destroy()
		bubbles[userId] = nil
	end
end

function Billboards.clear()
	for userId in bubbles do
		Billboards.remove(userId)
	end
end

return Billboards
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "Speech"; s.Source = [====[--!strict
-- Transcribes the local player's own mic. Roblox only runs AudioSpeechToText on clients, so every client
-- transcribes itself and the server judges. Voice starts disconnected (since 2026-01): AudioDeviceInput.Active
-- stays false until the player connects voice from the in-experience settings menu.
local Players = game:GetService("Players")

local Speech = {}

export type Status = "NoVoice" | "Disconnected" | "Muted" | "Listening" | "Speaking"

local input: AudioDeviceInput? = nil
local stt: AudioSpeechToText? = nil
local statusListeners: { (Status) -> () } = {}
local textListeners: { (string) -> () } = {}

function Speech.status(): Status
	if not input then
		return "NoVoice"
	elseif not input.Active then
		return "Disconnected"
	elseif input.Muted then
		return "Muted"
	elseif stt and stt.VoiceDetected then
		return "Speaking"
	end
	return "Listening"
end

local function emitStatus()
	local s = Speech.status()
	for _, fn in statusListeners do
		fn(s)
	end
end

function Speech.onStatus(fn: (Status) -> ())
	table.insert(statusListeners, fn)
	fn(Speech.status())
end

function Speech.onText(fn: (string) -> ())
	table.insert(textListeners, fn)
end

function Speech.start(parent: Instance)
	local player = Players.LocalPlayer
	input = player:WaitForChild("AudioDeviceInput", 30) :: AudioDeviceInput?
	if not input then
		emitStatus()
		return
	end
	local recognizer = Instance.new("AudioSpeechToText")
	recognizer.Enabled = true
	recognizer.Parent = parent
	stt = recognizer
	local wire = Instance.new("Wire")
	wire.SourceInstance = input
	wire.TargetInstance = recognizer
	wire.Parent = recognizer

	recognizer:GetPropertyChangedSignal("Text"):Connect(function()
		local text = recognizer.Text
		if text == "" then
			return
		end
		recognizer.Text = ""
		for _, fn in textListeners do
			fn(text)
		end
	end)
	recognizer:GetPropertyChangedSignal("VoiceDetected"):Connect(emitStatus)
	input:GetPropertyChangedSignal("Active"):Connect(emitStatus)
	input:GetPropertyChangedSignal("Muted"):Connect(emitStatus)
	emitStatus()
end

return Speech
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "ShowCamera"; s.Source = [====[--!strict
-- Fixed panel-show camera: while a round runs, everyone looks at the chair row from over the pool,
-- so every face and forbidden word is on one screen.
local ShowCamera = {}

local DEFAULT_FOV = 70
local active = false

local function point(): BasePart?
	local map = workspace:FindFirstChild("PoolMap")
	return map and map:FindFirstChild("ShowCamera") :: BasePart?
end

function ShowCamera.set(on: boolean)
	local camera = workspace.CurrentCamera
	local marker = point()
	if on and marker then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = marker.CFrame
		camera.FieldOfView = marker:GetAttribute("FieldOfView") or DEFAULT_FOV
	elseif active then
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = DEFAULT_FOV
	end
	active = on and marker ~= nil
end

function ShowCamera.reapply()
	if active then
		ShowCamera.set(true)
	end
end

return ShowCamera
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "FlatVoice"; s.Source = [====[--!strict
-- Everyone hears everyone at the same volume, wherever they are on the map (owner decision 2026-10-17).
-- Default voice (UseAudioApi) wires each AudioDeviceInput into an AudioEmitter inside the character with a
-- quadratic 7-80 stud rolloff; audibility is computed on the listening client, so flattening the curve here is enough.
local Players = game:GetService("Players")

local FlatVoice = {}

local FLAT_CURVE = { [0] = 1, [2000] = 1 }

local function flatten(emitter: Instance)
	if emitter:IsA("AudioEmitter") then
		emitter:SetDistanceAttenuation(FLAT_CURVE)
	end
end

local function watchCharacter(character: Model)
	for _, child in character:GetChildren() do
		flatten(child)
	end
	character.ChildAdded:Connect(flatten)
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
end

function FlatVoice.start()
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
end

return FlatVoice
]====]; s.Parent = client end
