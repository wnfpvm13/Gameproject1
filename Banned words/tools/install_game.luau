do local s = Instance.new("ModuleScript"); s.Name = "Judge"; s.Source = [====[--!strict
-- Forbidden-word judge shared by the live STT test and (later) WordJudgeService.
-- Confirmed = some eojeol starts with the word (or an alias) and the rest is empty or a particle.
-- Suspect = the word only appears once spaces are removed (STT spacing errors) -> "아슬아슬", never an elimination.

local Judge = {}

local PARTICLES: { [string]: boolean } = {}
for _, p in
	{ "", "이", "가", "을", "를", "은", "는", "도", "만", "에", "에서", "로", "으로", "야", "아", "이야", "예요", "이에요", "랑", "이랑", "하고", "의", "께", "한테", "처럼", "보다" }
do
	PARTICLES[p] = true
end

-- STT sometimes writes Sino-Korean numbers as digits ("칠판" -> "7판").
local SINO_DIGITS: { [string]: string } = {
	["0"] = "영", ["1"] = "일", ["2"] = "이", ["3"] = "삼", ["4"] = "사",
	["5"] = "오", ["6"] = "육", ["7"] = "칠", ["8"] = "팔", ["9"] = "구",
}

function Judge.normalize(text: string): string
	local lowered = string.lower(text)
	local digitsRead = string.gsub(lowered, "%d", SINO_DIGITS)
	local spaced = string.gsub(digitsRead, "%p", " ")
	return spaced
end

function Judge.eojeols(text: string): { string }
	local list = {}
	for part in string.gmatch(Judge.normalize(text), "%S+") do
		table.insert(list, part)
	end
	return list
end

local function startsWithParticle(eojeol: string, word: string): boolean
	if string.sub(eojeol, 1, #word) ~= word then
		return false
	end
	return PARTICLES[string.sub(eojeol, #word + 1)] == true
end

function Judge.isConfirmed(word: string, text: string, aliases: { string }?): boolean
	local forms = { word }
	if aliases then
		for _, alias in aliases do
			table.insert(forms, string.lower(alias))
		end
	end
	for _, eojeol in Judge.eojeols(text) do
		for _, form in forms do
			if startsWithParticle(eojeol, form) then
				return true
			end
		end
	end
	return false
end

function Judge.isSuspect(word: string, text: string): boolean
	if Judge.isConfirmed(word, text) then
		return false
	end
	local noSpace = string.gsub(Judge.normalize(text), "%s", "")
	return string.find(noSpace, word, 1, true) ~= nil
end

-- Picks the particle by the last syllable's final consonant: josa("영화관", "을", "를") -> "을".
function Judge.josa(word: string, withFinal: string, withoutFinal: string): string
	local last = 0
	for _, code in utf8.codes(word) do
		last = code
	end
	local hasFinal = last >= 0xAC00 and last <= 0xD7A3 and (last - 0xAC00) % 28 ~= 0
	return if hasFinal then withFinal else withoutFinal
end

-- "CONFIRMED" | "SUSPECT" | "NONE"
function Judge.classify(word: string, text: string, aliases: { string }?): string
	if Judge.isConfirmed(word, text, aliases) then
		return "CONFIRMED"
	elseif Judge.isSuspect(word, text) then
		return "SUSPECT"
	end
	return "NONE"
end

return Judge
]====]; s.Parent = shared end
do local s = Instance.new("ModuleScript"); s.Name = "WordBank"; s.Source = [====[--!strict
-- Version 2 word bank (server only, never replicated). Words come from the 2026-10-17 STT probe;
-- 기린 / 시계 / 칠판 were dropped because synthetic speech came back misheard or empty.

export type Entry = { word: string, aliases: { string }, category: string }

local WordBank = {}

local WORDS: { Entry } = {}
local function add(category: string, list: { string })
	for _, word in list do
		table.insert(WORDS, { word = word, aliases = {}, category = category })
	end
end

add("음식", { "치킨", "피자", "떡볶이", "라면", "김밥", "사과", "바나나", "아이스크림", "햄버거", "초콜릿" })
add("동물", { "강아지", "고양이", "토끼", "호랑이", "코끼리", "원숭이", "펭귄", "거북이", "햄스터" })
add("학교", { "숙제", "선생님", "교실", "시험", "연필", "지우개", "급식", "방학", "운동장" })
add("물건", { "컴퓨터", "핸드폰", "의자", "책상", "우산", "냉장고", "텔레비전", "안경", "가방" })
add("장소", { "수영장", "놀이터", "병원", "편의점", "도서관", "바다", "공원", "영화관", "학원", "지하철" })
add("날씨", { "무지개", "눈사람", "장마", "태풍", "여름", "겨울", "봄비", "구름", "번개", "단풍" })

-- Draws `count` distinct words, spreading categories so hints do not overlap.
function WordBank.draw(count: number, rng: Random): { Entry }
	local pool = table.clone(WORDS)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local picked: { Entry } = {}
	local usedCategory: { [string]: number } = {}
	local maxPerCategory = math.ceil(count / 6)
	for _, entry in pool do
		if #picked >= count then
			break
		end
		local used = usedCategory[entry.category] or 0
		if used < maxPerCategory then
			usedCategory[entry.category] = used + 1
			table.insert(picked, entry)
		end
	end
	return picked
end

return WordBank
]====]; s.Parent = server end
do local s = Instance.new("ModuleScript"); s.Name = "SeatService"; s.Source = [====[--!strict
-- Chairs around the pool: seat participants, keep them seated during a round, and launch the loser into the pool.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("BannedWords"):WaitForChild("Config"))

local SeatService = {}

local DEFAULT_JUMP_HEIGHT = 7.2

local assigned: { [Seat]: Humanoid } = {}
local locked = false

local function poolMap(): Folder
	return workspace:WaitForChild("PoolMap") :: Folder
end

function SeatService.getSeats(): { Seat }
	local seats = {}
	for _, chair in poolMap():WaitForChild("Chairs"):GetChildren() do
		local seat = chair:FindFirstChildWhichIsA("Seat")
		if seat then
			table.insert(seats, seat)
		end
	end
	-- Middle chairs first, so a small group still sits in the centre of the show camera.
	local middle = (#seats + 1) / 2
	local function rank(seat: Seat): number
		local index = seat:GetAttribute("SeatIndex") or 0
		return math.abs(index - middle) * 2 + (if index < middle then 0 else 1)
	end
	table.sort(seats, function(a, b)
		return rank(a) < rank(b)
	end)
	return seats
end

function SeatService.poolCenter(): Vector3
	local marker = poolMap():FindFirstChild("PoolCenter") :: BasePart?
	return if marker then marker.Position else Vector3.new(0, -1, 0)
end

local function sit(seat: Seat, humanoid: Humanoid)
	local character = humanoid.Parent :: Model
	character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
	seat:Sit(humanoid)
end

-- Only the assigned humanoid may occupy a chair; anyone else is ejected, and a locked participant is re-seated.
local function watch(seat: Seat)
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = seat.Occupant
		local owner = assigned[seat]
		if occupant and occupant ~= owner then
			occupant.Sit = false
		elseif not occupant and owner and locked and owner.Health > 0 then
			task.defer(function()
				if assigned[seat] == owner and locked and owner.Parent then
					sit(seat, owner)
				end
			end)
		end
	end)
end

function SeatService.init()
	for _, seat in SeatService.getSeats() do
		seat.Disabled = true
		watch(seat)
	end
end

-- Returns the seat per player (players beyond the chair count are left out by the caller).
function SeatService.seatPlayers(players: { Player }): { [Player]: Seat }
	local seats = SeatService.getSeats()
	local result: { [Player]: Seat } = {}
	for i, player in players do
		local seat = seats[i]
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if seat and humanoid and humanoid.Health > 0 then
			assigned[seat] = humanoid
			seat.Disabled = false
			humanoid.UseJumpPower = false
			humanoid.JumpHeight = 0
			sit(seat, humanoid)
			result[player] = seat
		end
	end
	locked = true
	return result
end

function SeatService.releaseAll()
	locked = false
	for seat, humanoid in assigned do
		if humanoid.Parent then
			humanoid.JumpHeight = DEFAULT_JUMP_HEIGHT
			humanoid.Sit = false
		end
		seat.Disabled = true
	end
	table.clear(assigned)
end

-- Throws the player from their chair in an arc into the pool, then kills them.
function SeatService.launch(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not (character and humanoid and root) then
		return
	end
	for seat, owner in assigned do
		if owner == humanoid then
			assigned[seat] = nil
			seat.Disabled = true
			-- The seat weld must be gone before the impulse, or the chair absorbs most of it.
			local weld = seat:FindFirstChild("SeatWeld")
			if weld then
				weld:Destroy()
			end
		end
	end
	humanoid.Sit = false
	humanoid.PlatformStand = true
	root:SetNetworkOwner(nil)

	task.spawn(function()
		RunService.Heartbeat:Wait()
		-- Straight ahead from the chair row into the pool, so the show camera sees the whole flight.
		local start = root.Position
		local center = SeatService.poolCenter()
		local target = Vector3.new(start.X + math.random(-3, 3), center.Y, center.Z + math.random(-4, 4))
		local t = Config.LAUNCH_FLIGHT_TIME
		local g = workspace.Gravity
		local horizontal = Vector3.new(target.X - start.X, 0, target.Z - start.Z) / t
		local vertical = (target.Y - start.Y + 0.5 * g * t * t) / t
		root.AssemblyLinearVelocity = horizontal + Vector3.new(0, vertical, 0)
		root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8))
		task.wait(Config.DEATH_DELAY)
		if humanoid.Parent then
			humanoid.Health = 0
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	for seat, humanoid in assigned do
		if humanoid.Parent == player.Character then
			assigned[seat] = nil
			seat.Disabled = true
		end
	end
end)

return SeatService
]====]; s.Parent = server end
do local s = Instance.new("ModuleScript"); s.Name = "RoundService"; s.Source = [====[--!strict
-- Round state machine: Lobby -> Countdown -> Assign -> Talk -> Result -> Lobby.
-- Transcripts come from each client's own AudioSpeechToText (the server cannot process audio) and are judged here.
-- During Talk, question cards force quiet players to speak; eliminated players stay in as "ghosts" whose speech
-- still counts toward assists (the last other speaker before an elimination scores).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("BannedWords")
local Config = require(shared:WaitForChild("Config"))
local Judge = require(shared:WaitForChild("Judge"))
local WordBank = require(script.Parent:WaitForChild("WordBank"))
local SeatService = require(script.Parent:WaitForChild("SeatService"))
local Prompts = require(script.Parent:WaitForChild("Prompts"))

local RoundService = {}

type Participant = {
	player: Player,
	word: string,
	aliases: { string },
	alive: boolean,
	lastSpokeAt: number,
	strikes: number,
	lastAnswer: string?,
}
type Card = { player: Player, answered: boolean }

local remotes: Folder
local phase = "Lobby"
local phaseEndsAt = 0
local message = ""
local participants: { [Player]: Participant } = {}
local startedWith = 0
local roundId = 0
local lastTranscript: { [Player]: { at: number, text: string } } = {}
local speechLog: { { player: Player, at: number } } = {}
local roundAssists: { [Player]: number } = {}
local activeCard: Card? = nil
local rng = Random.new()

local function remote(name: string): RemoteEvent
	return remotes:FindFirstChild(name) :: RemoteEvent
end

local function aliveList(): { Player }
	local list = {}
	for player, p in participants do
		if p.alive then
			table.insert(list, player)
		end
	end
	return list
end

local function broadcastState()
	local ids, alive = {}, {}
	for player, p in participants do
		table.insert(ids, player.UserId)
		if p.alive then
			table.insert(alive, player.UserId)
		end
	end
	remote("RoundState"):FireAllClients({
		phase = phase,
		endsAt = phaseEndsAt,
		message = message,
		participants = ids,
		alive = alive,
	})
end

local function setPhase(name: string, duration: number, text: string)
	phase = name
	phaseEndsAt = workspace:GetServerTimeNow() + duration
	message = text
	broadcastState()
end

-- Each client gets every participant's word except its own (own word never leaves the server).
local function sendWords(target: Player)
	local words = {}
	for player, p in participants do
		if player ~= target then
			words[tostring(player.UserId)] = p.word
		end
	end
	remote("Words"):FireClient(target, words)
end

local function addScore(player: Player, amount: number)
	local stats = player:FindFirstChild("leaderstats")
	local value = stats and stats:FindFirstChild("점수") :: IntValue?
	if value then
		value.Value += amount
	end
end

-- The most recent other participant (alive or ghost) who spoke within the assist window.
local function assistFor(victim: Player): Player?
	local now = os.clock()
	for i = #speechLog, 1, -1 do
		local entry = speechLog[i]
		if now - entry.at > Config.ASSIST_WINDOW then
			break
		end
		if entry.player ~= victim and participants[entry.player] then
			return entry.player
		end
	end
	return nil
end

local function eliminate(player: Player, reason: string)
	local p = participants[player]
	if not p or not p.alive then
		return
	end
	p.alive = false
	local helper = if reason == "said" then assistFor(player) else nil
	if helper then
		roundAssists[helper] = (roundAssists[helper] or 0) + Config.SCORE_ASSIST
		addScore(helper, Config.SCORE_ASSIST)
	end
	remote("Eliminated"):FireAllClients({
		userId = player.UserId,
		name = player.DisplayName,
		word = p.word,
		reason = reason,
		assistName = if helper then helper.DisplayName else nil,
	})
	if reason == "said" or reason == "silent" then
		SeatService.launch(player)
	end
	broadcastState()
end

local function isValidAnswer(p: Participant, text: string): boolean
	return #Judge.eojeols(text) >= 2 and text ~= p.lastAnswer
end

local function onTranscript(player: Player, text: any)
	if phase ~= "Talk" or typeof(text) ~= "string" then
		return
	end
	local p = participants[player]
	if not p then
		return
	end
	text = string.sub(text, 1, Config.TRANSCRIPT_MAX_LEN)
	local now = os.clock()
	local last = lastTranscript[player]
	if last and now - last.at < Config.TRANSCRIPT_MIN_INTERVAL then
		return
	end
	if last and last.text == text and now - last.at < Config.DUPLICATE_WINDOW then
		return
	end
	lastTranscript[player] = { at = now, text = text }
	table.insert(speechLog, { player = player, at = now })
	if #speechLog > 64 then
		table.remove(speechLog, 1)
	end
	p.lastSpokeAt = now
	if not p.alive then
		return -- ghosts only feed the assist log
	end

	local verdict = Judge.classify(p.word, text, p.aliases)
	if verdict == "CONFIRMED" then
		eliminate(player, "said")
		return
	elseif verdict == "SUSPECT" then
		remote("Suspect"):FireAllClients({ userId = player.UserId, name = player.DisplayName })
	end

	local card = activeCard
	if card and card.player == player and not card.answered and isValidAnswer(p, text) then
		card.answered = true
		p.lastAnswer = text
		remote("CardResult"):FireAllClients({ userId = player.UserId, name = player.DisplayName, outcome = "ok" })
	end
end

local function roundOver(): boolean
	local alive = #aliveList()
	return alive == 0 or (startedWith >= 2 and alive <= 1)
end

local function talking(myRound: number): boolean
	return phase == "Talk" and roundId == myRound and not roundOver()
end

-- Question cards: the quietest alive player gets a question and must answer in two or more words.
local function runCards(myRound: number)
	local lastTarget: Player? = nil
	while talking(myRound) do
		local interval = math.clamp(Config.TALK_TIME / math.max(#aliveList() * 2, 1), Config.QUESTION_MIN_INTERVAL, Config.QUESTION_MAX_INTERVAL)
		task.wait(interval)
		if not talking(myRound) then
			return
		end
		local alive = aliveList()
		table.sort(alive, function(a, b)
			return participants[a].lastSpokeAt < participants[b].lastSpokeAt
		end)
		local target = alive[1]
		if target == lastTarget and #alive > 1 then
			target = alive[2]
		end
		lastTarget = target
		local card: Card = { player = target, answered = false }
		activeCard = card
		remote("QuestionCard"):FireAllClients({
			userId = target.UserId,
			name = target.DisplayName,
			question = Prompts.question(rng),
			deadline = workspace:GetServerTimeNow() + Config.QUESTION_ANSWER_TIME,
		})
		local started = os.clock()
		while os.clock() - started < Config.QUESTION_ANSWER_TIME and not card.answered and talking(myRound) do
			local p = participants[target]
			if not (p and p.alive) then
				break
			end
			task.wait(0.1)
		end
		activeCard = nil
		local p = participants[target]
		if p and p.alive and not card.answered and talking(myRound) then
			p.strikes += 1
			local out = p.strikes >= Config.QUESTION_STRIKES
			remote("CardResult"):FireAllClients({ userId = target.UserId, name = target.DisplayName, outcome = if out then "out" else "warn" })
			if out then
				eliminate(target, "silent")
			end
		end
	end
end

local function waitPhase(shouldStop: (() -> boolean)?)
	while workspace:GetServerTimeNow() < phaseEndsAt do
		if shouldStop and shouldStop() then
			return
		end
		task.wait(0.2)
	end
end

local function eligiblePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			table.insert(list, player)
		end
	end
	return list
end

local function runRound()
	-- Countdown (cancelled if players drop below the minimum).
	setPhase("Countdown", Config.LOBBY_COUNTDOWN, "곧 시작해요")
	waitPhase(function()
		return #eligiblePlayers() < Config.MIN_PLAYERS
	end)
	local players = eligiblePlayers()
	if #players < Config.MIN_PLAYERS then
		return
	end

	-- Assign seats and words.
	roundId += 1
	for i = #players, 2, -1 do
		local j = rng:NextInteger(1, i)
		players[i], players[j] = players[j], players[i]
	end
	while #players > Config.MAX_PLAYERS do
		table.remove(players)
	end
	local seated = SeatService.seatPlayers(players)
	local seatedPlayers = {}
	for _, player in players do
		if seated[player] then
			table.insert(seatedPlayers, player)
		end
	end
	local entries = WordBank.draw(#seatedPlayers, rng)
	table.clear(participants)
	table.clear(lastTranscript)
	table.clear(speechLog)
	table.clear(roundAssists)
	for i, player in seatedPlayers do
		local entry = entries[i]
		participants[player] = {
			player = player,
			word = entry.word,
			aliases = entry.aliases,
			alive = true,
			lastSpokeAt = 0,
			strikes = 0,
		}
		local humanoid = (player.Character :: Model):FindFirstChildOfClass("Humanoid") :: Humanoid
		humanoid.Died:Once(function()
			eliminate(player, "died")
		end)
	end
	startedWith = #seatedPlayers
	setPhase("Assign", Config.ASSIGN_TIME, "내 금칙어는 나만 몰라요! 다른 사람이 말하게 만드세요")
	for _, player in Players:GetPlayers() do
		sendWords(player)
	end
	waitPhase()

	-- Talk (question cards run alongside).
	local now = os.clock()
	for _, p in participants do
		p.lastSpokeAt = now + rng:NextNumber() -- random tie-break for the first card
	end
	setPhase("Talk", Config.TALK_TIME, "대화 주제: " .. Prompts.topic(rng))
	task.spawn(runCards, roundId)
	waitPhase(roundOver)

	-- Result: survivors score, the round's best assister is named.
	local winners = {}
	for player, p in participants do
		if p.alive then
			table.insert(winners, player.DisplayName)
			addScore(player, Config.SCORE_SURVIVE)
		end
	end
	local result = if #winners == 0 then "모두 탈락! 무승부" else table.concat(winners, ", ") .. " 승리!"
	local best, bestScore = nil, 0
	for player, score in roundAssists do
		if score > bestScore then
			best, bestScore = player, score
		end
	end
	if best then
		result ..= string.format(" · 유도왕 %s (%d점)", best.DisplayName, bestScore)
	end
	activeCard = nil
	SeatService.releaseAll()
	setPhase("Result", Config.RESULT_TIME, result)
	local reveal = {}
	for player, p in participants do
		reveal[tostring(player.UserId)] = p.word
	end
	remote("Words"):FireAllClients(reveal)
	waitPhase()
	table.clear(participants)
end

local function setupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local score = Instance.new("IntValue")
	score.Name = "점수"
	score.Parent = stats
	stats.Parent = player
end

function RoundService.start(remoteFolder: Folder)
	remotes = remoteFolder
	SeatService.init()
	remote("Transcript").OnServerEvent:Connect(onTranscript)

	for _, player in Players:GetPlayers() do
		setupLeaderstats(player)
	end
	Players.PlayerAdded:Connect(function(player)
		setupLeaderstats(player)
		task.defer(function()
			broadcastState()
			if phase == "Assign" or phase == "Talk" then
				sendWords(player)
			end
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		if participants[player] then
			eliminate(player, "left")
			participants[player] = nil
		end
		lastTranscript[player] = nil
		roundAssists[player] = nil
	end)

	task.spawn(function()
		while true do
			local needed = Config.MIN_PLAYERS - #eligiblePlayers()
			if needed > 0 then
				setPhase("Lobby", 0, string.format("플레이어 %d명 더 필요해요", needed))
				repeat
					task.wait(1)
				until #eligiblePlayers() >= Config.MIN_PLAYERS
			end
			runRound()
		end
	end)
end

return RoundService
