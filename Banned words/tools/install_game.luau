do local s = Instance.new("ModuleScript"); s.Name = "BellButton"; s.Source = [====[--!strict
-- The big bell button on screen (docs/DESIGN_V3.md §5.1; bundle 6b). Owner 2026-10-25: always on the right side of
-- the screen while I play, drawn as the sticker bell (Config.IMAGES.BELL); in 총잡이 결투 it is the gun
-- (Config.IMAGES.GUN) and a press fires. While my seat bell is open the picture is bright and breathes, and a press
-- asks the server to ring it — at the touch or click itself (bundle 8b: Activated fires on release, a phone would
-- always be a tap late against the E key in the timing games; Activated is kept for gamepads, but not for the same
-- press). While it is not open the picture rests a little faded and a press only wiggles it (no ding: it must not
-- sound like a real ring). Until the picture has loaded, a "🔔" stands in for it. Owner 2026-10-25 (bundle 9c): while
-- a press would lose (총잡이 결투's "ready…", 무궁화's red light) the bell stays open but does not invite a press: it
-- rests faded and still.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Style = require(script.Parent:WaitForChild("Style"))

local BellButton = {}

local SIZE = 116 -- pixels
local RESTING = 0.35 -- the picture's transparency while the bell is not open
local BREATH = 1.08 -- how big it grows while it waits for a press

local button: ImageButton
local breath: UIScale
local breathing: Tween? = nil
local live = false
local inviting = false

local function wiggle()
	button.Rotation = -16
	TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 })
		:Play()
end

-- onRing(): my bell is open, ring it (the server decides).
function BellButton.build(onRing: () -> ())
	button = Instance.new("ImageButton")
	button.Name = "BellButton"
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, -18, 0.6, 0)
	button.Size = UDim2.fromOffset(SIZE, SIZE)
	button.BackgroundTransparency = 1
	button.Image = Config.IMAGES.BELL
	button.ScaleType = Enum.ScaleType.Fit
	button.ImageTransparency = RESTING -- (closed until the first window opens)
	button.Visible = false
	button.ZIndex = 4
	breath = Instance.new("UIScale")
	breath.Parent = button
	local standIn = Instance.new("TextLabel")
	standIn.Name = "StandIn"
	standIn.BackgroundTransparency = 1
	standIn.Size = UDim2.fromScale(1, 1)
	standIn.Text = "🔔"
	standIn.TextScaled = true
	standIn.Visible = not button.IsLoaded
	standIn.Parent = button
	button:GetPropertyChangedSignal("IsLoaded"):Connect(function()
		standIn.Visible = not button.IsLoaded
	end)
	-- The key on a keyboard (the seat bell's prompt draws nothing, review 2026-10-25): a small sticker "E".
	local key = Instance.new("TextLabel")
	key.Name = "Key"
	key.AnchorPoint = Vector2.new(1, 1)
	key.Position = UDim2.fromScale(1, 1)
	key.Size = UDim2.fromOffset(30, 30)
	key.BackgroundColor3 = Style.PAPER
	key.FontFace = Style.BOLD
	key.TextSize = 20
	key.TextColor3 = Style.INK
	key.Text = "E"
	key.ZIndex = 5
	Style.round(key, 8)
	key.Parent = button
	local function showKey()
		local last = UserInputService:GetLastInputType()
		local pad = string.find(last.Name, "Gamepad") ~= nil
		key.Text = if pad then "X" else "E"
		key.Visible = pad or (UserInputService.KeyboardEnabled and last ~= Enum.UserInputType.Touch)
	end
	showKey()
	UserInputService.LastInputTypeChanged:Connect(showKey)
	local function press()
		wiggle()
		if live then
			onRing()
		end
	end
	local pointerDown = false -- a click or touch pressed on its way down; its Activated (on the way up) is the same press
	button.InputBegan:Connect(function(input: InputObject)
		local kind = input.UserInputType
		if (kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch)
			and input.UserInputState == Enum.UserInputState.Begin then
			pointerDown = true
			press()
		end
	end)
	button.Activated:Connect(function()
		if pointerDown then
			pointerDown = false
		else
			press() -- (a gamepad's press)
		end
	end)
	button.Parent = Style.gui()
end

-- `visible`: I play (seated, on the ground); `canRing`: my seat bell is open and I have not rung it yet; `invite`: a
-- press now is welcome (false while it would lose: then the open bell looks like a closed one, but a press still rings).
function BellButton.set(visible: boolean, canRing: boolean, invite: boolean)
	button.Visible = visible
	local look = canRing and invite
	if canRing == live and look == inviting then
		return
	end
	live = canRing
	inviting = look
	button.ImageTransparency = if look then 0 else RESTING
	if breathing then
		breathing:Cancel()
		breathing = nil
	end
	breath.Scale = 1
	if look then
		local tween = TweenService:Create(breath, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Scale = BREATH })
		tween:Play()
		breathing = tween
	end
end

-- The picture: the bell, or the gun in 총잡이 결투 (a press fires).
function BellButton.setIcon(icon: "bell" | "gun")
	button.Image = if icon == "gun" then Config.IMAGES.GUN else Config.IMAGES.BELL
end

return BellButton
]====]; s.Parent = n7 end
do local s = Instance.new("ModuleScript"); s.Name = "Hud"; s.Source = [====[--!strict
-- Status board at the top centre: phase + message, timer, my lives (hearts) and survivors. Kept short (64 px) so the
-- chair row under it stays visible.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Config"))
local Hearts = require(ReplicatedStorage:WaitForChild("BannedWords"):WaitForChild("Hearts"))
local Style = require(script.Parent:WaitForChild("Style"))

local Hud = {}

local PHASE_TITLE = {
	Lobby = "대기 중",
	Countdown = "곧 시작",
	Assign = "자리 배정",
	Play = "본 경기", -- not "게임": a word-bank word, and players read this aloud
	Final = "결승",
	Result = "결과",
}

local statusL: TextLabel
local timerL: TextLabel
local aliveL: TextLabel
local livesL: TextLabel

function Hud.build()
	local top = Style.panel(Style.gui(), Style.PAPER, Style.PAPER_ALPHA, 14)
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 8)
	top.Size = UDim2.new(0.5, 0, 0, 64)
	-- (at most the screen less 250 px each side where Roblox's player list sits open at the top right — a small PC window,
	-- review 2026-10-25; a phone keeps it folded, so the board keeps its width there)
	local limit = Instance.new("UISizeConstraint")
	limit.MinSize = Vector2.new(320, 0)
	limit.Parent = top
	local function fit()
		local camera = workspace.CurrentCamera
		local phone = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		local width = if not camera then 580 elseif phone then camera.ViewportSize.X * 0.6 else camera.ViewportSize.X - 500
		limit.MaxSize = Vector2.new(math.clamp(width, 320, 580), 200)
	end
	fit()
	local watched: Camera? = nil
	local function watch()
		local camera = workspace.CurrentCamera
		if camera and camera ~= watched then
			watched = camera
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
			fit()
		end
	end
	watch()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watch)

	statusL = Style.label(top, Style.BOLD, 22, Style.INK)
	statusL.Position = UDim2.fromScale(0.04, 0.06)
	statusL.Size = UDim2.fromScale(0.92, 0.46)
	timerL = Style.label(top, Style.BOLD, 22, Style.INK)
	timerL.Position = UDim2.fromScale(0.04, 0.55)
	timerL.Size = UDim2.fromScale(0.28, 0.38)
	timerL.TextXAlignment = Enum.TextXAlignment.Left
	livesL = Style.label(top, Style.BOLD, 22, Style.INK)
	livesL.Position = UDim2.fromScale(0.32, 0.55)
	livesL.Size = UDim2.fromScale(0.36, 0.38)
	livesL.RichText = true
	aliveL = Style.label(top, Style.REGULAR, 20, Style.FAINT)
	aliveL.Position = UDim2.fromScale(0.68, 0.55)
	aliveL.Size = UDim2.fromScale(0.28, 0.38)
	aliveL.TextXAlignment = Enum.TextXAlignment.Right
end

-- The message alone, or the phase's name when there is none (review 2026-10-25: "본 경기 · 본 경기 시작!", "결승 ·
-- 결승 퀴즈 · …" said the same thing twice).
function Hud.setStatus(phase: string, message: string)
	statusL.Text = if message ~= "" then message else PHASE_TITLE[phase] or phase
end

function Hud.setTimer(seconds: number?)
	if not seconds then
		timerL.Text = ""
		return
	end
	local s = math.max(0, math.ceil(seconds))
	timerL.Text = string.format("%d:%02d", s // 60, s % 60)
	timerL.TextColor3 = if s <= 30 then Style.RED_TEXT else Style.INK
end

-- The main game's count instead of a clock ("미션 3/6", owner 2026-10-24).
function Hud.setCount(game: number, games: number)
	timerL.Text = string.format(Config.TEXT.GAME_COUNT, math.max(1, game), games)
	timerL.TextColor3 = Style.INK
end

function Hud.setAlive(alive: number, total: number)
	aliveL.Text = if total > 0 then string.format("생존 %d / %d", alive, total) else ""
end

-- nil hides it (not playing this round); `role` shows instead of the hearts (the presenter).
function Hud.setMyLives(lives: number?, max: number, role: string?)
	livesL.Text = if role then role elseif lives then "내 목숨 " .. Hearts.text(lives, max) else ""
end

return Hud
]====]; s.Parent = n7 end
