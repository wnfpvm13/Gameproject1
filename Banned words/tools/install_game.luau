local client = Instance.new("LocalScript"); client.Name = "BannedWordsClient"
client.Source = [====[-- 금칙어 게임 Korean client entry point: HUD, word bubbles and transcript forwarding.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local shared = ReplicatedStorage:WaitForChild("BannedWords")
local remotes = shared:WaitForChild("Remotes")
local Config = require(shared:WaitForChild("Config"))
local Judge = require(shared:WaitForChild("Judge"))
local Hud = require(script:WaitForChild("Hud"))
local Fx = require(script:WaitForChild("Fx"))
local Billboards = require(script:WaitForChild("Billboards"))
local Speech = require(script:WaitForChild("Speech"))
local ShowCamera = require(script:WaitForChild("ShowCamera"))
local FlatVoice = require(script:WaitForChild("FlatVoice"))

local player = Players.LocalPlayer

local PHASE_TITLE = {
	Lobby = "대기 중",
	Countdown = "곧 시작",
	Assign = "금칙어 배정",
	Talk = "대화 중",
	Result = "결과",
}

local state = { phase = "Lobby", endsAt = 0, participants = {}, alive = {}, message = "" }
local lastWords: { [string]: string } = {}

local function isAlive(userId: number): boolean
	return table.find(state.alive, userId) ~= nil
end

local function isParticipant(userId: number): boolean
	return table.find(state.participants, userId) ~= nil
end

local function setResetAllowed(allowed: boolean)
	pcall(function()
		StarterGui:SetCore("ResetButtonCallback", allowed)
	end)
end

-- Keep seated participants from jumping out of their chair during a round.
local function applySeatLock()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local locked = (state.phase == "Assign" or state.phase == "Talk") and isAlive(player.UserId)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not locked)
	setResetAllowed(not locked)
end

-- Voice readiness: connect voice, say anything once (mic test), then you can take a seat next round.
local micTested = false
local readySent: boolean? = nil

local function inMyRound(): boolean
	return (state.phase == "Assign" or state.phase == "Talk") and isParticipant(player.UserId)
end

local function updateReady()
	local status = Speech.status()
	local voiceOk = status == "Listening" or status == "Speaking"
	local isReady = micTested and voiceOk
	if isReady ~= readySent then
		readySent = isReady
		remotes.Ready:FireServer(isReady)
	end
	if inMyRound() then
		Hud.setMicTest("", true)
	elseif status == "NoVoice" then
		Hud.setMicTest("음성 채팅을 쓸 수 없는 계정이라 관전만 할 수 있어요", false)
	elseif status == "Disconnected" then
		Hud.setMicTest("음성을 연결하면 다음 판부터 참가할 수 있어요", false)
	elseif status == "Muted" then
		Hud.setMicTest("마이크를 켜 주세요", false)
	elseif not micTested then
		Hud.setMicTest("마이크 테스트 · 아무 말이나 해 보세요", false)
	else
		local count = state.readyCount
		Hud.setMicTest(if count then string.format("준비 완료! (준비된 사람 %d명)", count) else "준비 완료!", true)
	end
end

Hud.build()
Hud.buildVote(function(choice)
	remotes.Vote:FireServer(choice)
end)
Fx.init()
FlatVoice.start()
Speech.onStatus(function(status)
	Hud.setVoice(status)
	updateReady()
end)
task.spawn(Speech.start, player:WaitForChild("PlayerGui"))

-- Only alive participants (panelists and the guest) are judged; eliminated players and spectators just watch.
Speech.onText(function(text)
	if not micTested then
		micTested = true
		Hud.toast("마이크 확인 완료!", "info")
		updateReady()
	end
	if state.phase == "Talk" and isParticipant(player.UserId) and isAlive(player.UserId) then
		remotes.Transcript:FireServer(text)
	end
end)

remotes.RoundState.OnClientEvent:Connect(function(newState)
	local previous = state.phase
	state = newState
	Hud.setStatus(PHASE_TITLE[state.phase] .. " · " .. state.message)
	Hud.setAlive(state.panelAlive, state.panelTotal)
	Hud.setVote(state.phase == "Countdown", state.votes, state.readyCount)
	updateReady()
	if state.phase == "Lobby" or (state.phase == "Countdown" and previous == "Result") then
		Billboards.clear()
	end
	if state.phase == "Talk" and previous ~= "Talk" then
		Hud.toast("대화 시작!", "info")
	end
	local inRound = state.phase == "Assign" or state.phase == "Talk"
	if inRound then
		Billboards.show(lastWords, state.alive, state.guestId)
	end
	ShowCamera.set(inRound)

	local me = player.UserId
	local role = ""
	if inRound and me == state.guestId then
		role = "게스트 · 대화하며 패널의 금칙어를 말해 보세요. 날릴수록 점수! (단어 나열은 금지)"
	elseif inRound and isParticipant(me) and not isAlive(me) then
		role = "탈락 · 관전 중이에요 (내 목소리는 관전자끼리만 들려요)"
	elseif inRound and not isParticipant(me) then
		role = "관전 중 · 다음 판에 참가해요 (내 목소리는 관전자끼리만 들려요)"
	elseif inRound and state.mode == "talkshow" then
		role = "패널 · 힌트로 게스트가 남의 금칙어를 말하게! 직접 말하면 반칙"
	end
	Hud.setRole(role)
	if state.phase ~= "Talk" then
		Hud.hideCard()
	end
	applySeatLock()
end)

remotes.Words.OnClientEvent:Connect(function(words)
	lastWords = words
	Billboards.show(words, state.participants, state.guestId)
end)

remotes.Eliminated.OnClientEvent:Connect(function(info)
	local who = if info.userId == player.UserId then "내가" else info.name .. "님이"
	local whom = if info.userId == player.UserId then "내가" else info.name .. "님"
	local launched = info.reason == "said" or info.reason == "silent" or info.reason == "guest" or info.reason == "foul"
	if launched then
		Billboards.alarm(info.userId)
		Fx.elimination(Players:GetPlayerByUserId(info.userId))
		local text
		if info.reason == "said" then
			text = string.format("삐! %s 금칙어 \"%s\"%s 말했어요", who, info.word, Judge.josa(info.word, "을", "를"))
		elseif info.reason == "guest" then
			text = string.format("삐! 게스트 %s님이 \"%s\"%s 말해서 %s 날아가요", info.guestName or "", info.word, Judge.josa(info.word, "을", "를"), whom)
		elseif info.reason == "foul" then
			local said = info.saidWord or ""
			text = string.format("반칙! %s 남의 금칙어 \"%s\"%s 직접 말했어요", who, said, Judge.josa(said, "을", "를"))
		else
			text = string.format("삐! %s 질문에 대답하지 않았어요 (금칙어 \"%s\")", who, info.word)
		end
		if info.assistName then
			text ..= string.format("\n유도: %s +%d점", info.assistName, Config.SCORE_ASSIST)
		end
		Hud.toast(text, "elim")
	else
		Billboards.remove(info.userId)
	end
end)

remotes.Suspect.OnClientEvent:Connect(function(info)
	Hud.toast(string.format("아슬아슬! %s", info.name), "near")
end)

remotes.QuestionCard.OnClientEvent:Connect(function(info)
	Hud.showCard(info.name, info.userId == player.UserId, info.question, info.deadline)
end)

remotes.CardResult.OnClientEvent:Connect(function(info)
	Hud.hideCard()
	local who = if info.userId == player.UserId then "나" else info.name
	if info.outcome == "warn" then
		Hud.toast(string.format("경고! %s · 한 번 더 대답 안 하면 탈락", who), "near")
	elseif info.outcome == "unheard" then
		Hud.toast(string.format("%s · 목소리는 들렸는데 인식이 안 됐어요. 이번엔 넘어가요", who), "near")
	end
end)

remotes.Notice.OnClientEvent:Connect(function(info)
	Hud.toast(info.text, "near")
end)

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	applySeatLock()
	ShowCamera.reapply()
	if state.phase == "Assign" or state.phase == "Talk" then
		Billboards.show(lastWords, state.alive, state.guestId)
	end
end)

local lastPing = 0
RunService.Heartbeat:Connect(function()
	local now = workspace:GetServerTimeNow()
	local remaining = state.endsAt - now
	Hud.setTimer(if state.phase ~= "Lobby" and remaining > 0 then remaining else nil)
	Hud.tickCard(now, Config.QUESTION_ANSWER_TIME)
	-- Tell the server the mic hears speech, so a card missed by the recognizer is not counted as silence.
	if state.phase == "Talk" and isAlive(player.UserId) and Speech.isSpeaking() and now - lastPing >= Config.VOICE_PING_INTERVAL then
		lastPing = now
		remotes.VoicePing:FireServer()
	end
end)

-- Ask for the current state now that every handler is connected (late joiners miss earlier broadcasts).
remotes.Sync:FireServer()
]====]
do local s = Instance.new("ModuleScript"); s.Name = "Hud"; s.Source = [====[--!strict
-- Top-centre round status, voice connection banner and centre toasts (elimination / near miss).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("BannedWords"):WaitForChild("Config"))

local Hud = {}

local BOLD = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
local REGULAR = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Regular)
local WHITE = Color3.fromRGB(240, 240, 245)
local GREY = Color3.fromRGB(170, 175, 185)
local RED = Color3.fromRGB(255, 110, 110)
local AMBER = Color3.fromRGB(255, 200, 90)
local GREEN = Color3.fromRGB(120, 220, 140)

local gui: ScreenGui
local statusL: TextLabel
local timerL: TextLabel
local aliveL: TextLabel
local voiceL: TextLabel
local toastL: TextLabel
local ghostL: TextLabel
local card: Frame
local cardTitleL: TextLabel
local cardQuestionL: TextLabel
local cardBar: Frame
local cardDeadline = 0

local function label(parent: Instance, font: Font, size: number, color: Color3): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.FontFace = font
	l.TextColor3 = color
	l.TextScaled = true
	l.TextWrapped = true
	l.Text = ""
	local c = Instance.new("UITextSizeConstraint", l)
	c.MaxTextSize = size
	l.Parent = parent
	return l
end

function Hud.build()
	gui = Instance.new("ScreenGui")
	gui.Name = "BannedWordsHud"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local top = Instance.new("Frame")
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 8)
	top.Size = UDim2.new(0.5, 0, 0, 86)
	top.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
	top.BackgroundTransparency = 0.2
	top.Parent = gui
	Instance.new("UICorner", top).CornerRadius = UDim.new(0, 14)
	local limit = Instance.new("UISizeConstraint", top)
	limit.MinSize = Vector2.new(300, 0)
	limit.MaxSize = Vector2.new(560, 200)

	statusL = label(top, BOLD, 26, WHITE)
	statusL.Position = UDim2.fromScale(0.04, 0.06)
	statusL.Size = UDim2.fromScale(0.92, 0.46)
	timerL = label(top, BOLD, 22, AMBER)
	timerL.Position = UDim2.fromScale(0.04, 0.55)
	timerL.Size = UDim2.fromScale(0.45, 0.38)
	timerL.TextXAlignment = Enum.TextXAlignment.Left
	aliveL = label(top, REGULAR, 20, GREY)
	aliveL.Position = UDim2.fromScale(0.51, 0.55)
	aliveL.Size = UDim2.fromScale(0.45, 0.38)
	aliveL.TextXAlignment = Enum.TextXAlignment.Right

	voiceL = label(gui, BOLD, 20, RED)
	voiceL.AnchorPoint = Vector2.new(0.5, 0)
	voiceL.Position = UDim2.new(0.5, 0, 0, 100)
	voiceL.Size = UDim2.new(0.6, 0, 0, 30)

	toastL = label(gui, BOLD, 48, WHITE)
	toastL.AnchorPoint = Vector2.new(0.5, 0.5)
	toastL.Position = UDim2.fromScale(0.5, 0.42)
	toastL.Size = UDim2.fromScale(0.8, 0.14)
	toastL.TextStrokeTransparency = 0.3
	toastL.TextTransparency = 1
	toastL.TextStrokeTransparency = 1

	ghostL = label(gui, BOLD, 20, Color3.fromRGB(170, 200, 255))
	ghostL.AnchorPoint = Vector2.new(0.5, 0)
	ghostL.Position = UDim2.new(0.5, 0, 0, 132)
	ghostL.Size = UDim2.new(0.6, 0, 0, 28)

	-- Question card: bottom centre, with a draining time bar.
	card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.new(0.5, 0, 1, -24)
	card.Size = UDim2.new(0.55, 0, 0, 110)
	card.BackgroundColor3 = Color3.fromRGB(255, 248, 225)
	card.Visible = false
	card.Parent = gui
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 16)
	local cardLimit = Instance.new("UISizeConstraint", card)
	cardLimit.MinSize = Vector2.new(320, 0)
	cardLimit.MaxSize = Vector2.new(640, 200)
	cardTitleL = label(card, BOLD, 22, Color3.fromRGB(200, 90, 40))
	cardTitleL.Position = UDim2.fromScale(0.04, 0.08)
	cardTitleL.Size = UDim2.fromScale(0.92, 0.3)
	cardQuestionL = label(card, BOLD, 30, Color3.fromRGB(40, 40, 50))
	cardQuestionL.Position = UDim2.fromScale(0.04, 0.38)
	cardQuestionL.Size = UDim2.fromScale(0.92, 0.38)
	local barBack = Instance.new("Frame")
	barBack.Position = UDim2.fromScale(0.04, 0.82)
	barBack.Size = UDim2.fromScale(0.92, 0.08)
	barBack.BackgroundColor3 = Color3.fromRGB(230, 220, 195)
	barBack.Parent = card
	Instance.new("UICorner", barBack).CornerRadius = UDim.new(1, 0)
	cardBar = Instance.new("Frame")
	cardBar.Size = UDim2.fromScale(1, 1)
	cardBar.BackgroundColor3 = Color3.fromRGB(240, 140, 60)
	cardBar.Parent = barBack
	Instance.new("UICorner", cardBar).CornerRadius = UDim.new(1, 0)
end

function Hud.showCard(targetName: string, isMe: boolean, question: string, deadline: number)
	cardTitleL.Text = if isMe then "나에게 질문! 두 마디 이상으로 대답하세요" else targetName .. "님에게 질문!"
	cardQuestionL.Text = question
	cardDeadline = deadline
	card.Visible = true
end

function Hud.hideCard()
	card.Visible = false
end

-- Called every frame: drains the card's time bar.
function Hud.tickCard(now: number, total: number)
	if not card.Visible then
		return
	end
	local left = cardDeadline - now
	if left <= 0 then
		card.Visible = false
		return
	end
	cardBar.Size = UDim2.fromScale(math.clamp(left / total, 0, 1), 1)
end

-- One line under the status board explaining what I should be doing (ghost / guest / panelist).
function Hud.setRole(text: string)
	ghostL.Text = text
end

-- Mode vote during the countdown. Talk show is locked until enough ready players are in the server.
local voteFrame: Frame? = nil
local voteButtons: { [string]: TextButton } = {}
local talkshowAllowed = true
local IDLE_COLOR = Color3.fromRGB(40, 48, 64)
local PICKED_COLOR = Color3.fromRGB(240, 140, 60)
local LOCKED_COLOR = Color3.fromRGB(70, 72, 78)
local VOTE_LABELS = { classic = "클래식", talkshow = string.format("토크쇼 (%d명+)", Config.TALKSHOW_MIN_PLAYERS) }

function Hud.buildVote(onVote: (string) -> ())
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = UDim2.new(0.5, 0, 1, -24)
	frame.Size = UDim2.new(0.5, 0, 0, 64)
	frame.BackgroundTransparency = 1
	frame.Visible = false
	frame.Parent = gui
	local limit = Instance.new("UISizeConstraint", frame)
	limit.MinSize = Vector2.new(300, 0)
	limit.MaxSize = Vector2.new(460, 64)
	for i, choice in { "classic", "talkshow" } do
		local b = Instance.new("TextButton")
		b.Position = UDim2.new((i - 1) * 0.52, 0, 0, 0)
		b.Size = UDim2.new(0.48, 0, 1, 0)
		b.BackgroundColor3 = Color3.fromRGB(40, 48, 64)
		b.FontFace = BOLD
		b.TextColor3 = WHITE
		b.TextScaled = true
		b.Text = VOTE_LABELS[choice]
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 14)
		local c = Instance.new("UITextSizeConstraint", b)
		c.MaxTextSize = 24
		local pad = Instance.new("UIPadding", b)
		pad.PaddingLeft = UDim.new(0, 10)
		pad.PaddingRight = UDim.new(0, 10)
		b.Activated:Connect(function()
			if choice == "talkshow" and not talkshowAllowed then
				return
			end
			onVote(choice)
			for other, button in voteButtons do
				if other == "talkshow" and not talkshowAllowed then
					continue
				end
				button.BackgroundColor3 = if other == choice then PICKED_COLOR else IDLE_COLOR
			end
		end)
		b.Parent = frame
		voteButtons[choice] = b
	end
	voteFrame = frame
end

function Hud.setVote(visible: boolean, counts: { classic: number, talkshow: number }?, readyCount: number?)
	if not voteFrame then
		return
	end
	voteFrame.Visible = visible
	if not visible then
		for _, button in voteButtons do
			button.BackgroundColor3 = IDLE_COLOR
		end
		return
	end
	talkshowAllowed = (readyCount or 0) >= Config.TALKSHOW_MIN_PLAYERS
	if counts then
		voteButtons.classic.Text = string.format("%s · %d표", VOTE_LABELS.classic, counts.classic)
		voteButtons.talkshow.Text = if talkshowAllowed
			then string.format("%s · %d표", VOTE_LABELS.talkshow, counts.talkshow)
			else string.format("토크쇼 · %d명부터", Config.TALKSHOW_MIN_PLAYERS)
	end
	if not talkshowAllowed then
		voteButtons.talkshow.BackgroundColor3 = LOCKED_COLOR
	end
	voteButtons.talkshow.AutoButtonColor = talkshowAllowed
end

-- Mic test in the lobby: what the player should do next to become ready.
local micTestL: TextLabel? = nil

function Hud.setMicTest(text: string, done: boolean)
	if not micTestL then
		local l = label(gui, BOLD, 20, AMBER)
		l.AnchorPoint = Vector2.new(0.5, 0)
		l.Position = UDim2.new(0.5, 0, 0, 164)
		l.Size = UDim2.new(0.6, 0, 0, 28)
		micTestL = l
	end
	local l = micTestL :: TextLabel
	l.Text = text
	l.TextColor3 = if done then GREEN else AMBER
end

function Hud.setStatus(text: string)
	statusL.Text = text
end

function Hud.setTimer(seconds: number?)
	if not seconds then
		timerL.Text = ""
		return
	end
	local s = math.max(0, math.ceil(seconds))
	timerL.Text = string.format("%d:%02d", s // 60, s % 60)
	timerL.TextColor3 = if s <= 30 then RED else AMBER
end

function Hud.setAlive(alive: number, total: number)
	aliveL.Text = if total > 0 then string.format("생존 %d / %d", alive, total) else ""
end

function Hud.setVoice(status: string)
	if status == "NoVoice" then
		voiceL.Text = "음성 채팅을 쓸 수 없는 계정이에요 (만 13세 이상 + 연령 인증 필요)"
	elseif status == "Disconnected" then
		voiceL.Text = "음성 채팅 연결 필요 · 왼쪽 위 ≡ 메뉴(또는 ESC) → 설정 → 음성 채팅 연결"
	elseif status == "Muted" then
		voiceL.Text = "마이크가 꺼져 있어요"
	else
		voiceL.Text = ""
	end
end

function Hud.toast(text: string, kind: "elim" | "near" | "info")
	toastL.Text = text
	toastL.TextColor3 = if kind == "elim" then RED elseif kind == "near" then AMBER else GREEN
	toastL.TextTransparency = 0
	toastL.TextStrokeTransparency = 0.3
	local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2)
	TweenService:Create(toastL, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end

return Hud
]====]; s.Parent = client end
do local s = Instance.new("ModuleScript"); s.Name = "Billboards"; s.Source = [====[--!strict
-- Word bubbles above heads: other participants show their forbidden word, the local player sees "???".
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Billboards = {}

local FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
local bubbles: { [number]: BillboardGui } = {}

local function bubbleFor(player: Player): BillboardGui?
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	if not head then
		return nil
	end
	local existing = bubbles[player.UserId]
	if existing and existing.Parent == head then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "WordBubble"
	-- Sized in studs (not pixels) so ten bubbles in the 5-stud chair row never overlap on the show camera.
	-- Top 62 %: the word card. Bottom 34 %: the player's name (the default name tag is hidden during rounds).
	gui.Size = UDim2.fromScale(4.4, 2.2)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 0.62)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	frame.Parent = gui
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "PlayerName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.fromScale(0, 0.66)
	nameLabel.Size = UDim2.fromScale(1, 0.34)
	nameLabel.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Text = player.DisplayName
	nameLabel.Parent = gui
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 14)
	local stroke = Instance.new("UIStroke", frame)
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(40, 40, 48)
	local label = Instance.new("TextLabel")
	label.Name = "Word"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = FONT
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(30, 30, 36)
	label.Parent = frame
	local pad = Instance.new("UIPadding", label)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	gui.Adornee = head
	gui.Parent = head
	bubbles[player.UserId] = gui
	return gui
end

local function setText(player: Player, text: string, mine: boolean)
	local gui = bubbleFor(player)
	if not gui then
		return
	end
	local label = gui:FindFirstChild("Word", true) :: TextLabel
	label.Text = text
	label.TextColor3 = if mine then Color3.fromRGB(120, 120, 130) else Color3.fromRGB(30, 30, 36)
end

-- words: userId string -> word. A participant missing from the table is the local player (own word hidden),
-- the talk-show guest (labelled "게스트"), or, when I am the guest, a panelist whose word I may not know ("?").
function Billboards.show(words: { [string]: string }, participantIds: { number }, guestId: number?)
	local me = Players.LocalPlayer
	for _, userId in participantIds do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			local word = words[tostring(userId)]
			if userId == guestId then
				setText(player, "게스트", player == me)
			elseif word then
				setText(player, word, player == me)
			elseif player == me then
				setText(player, "???", true)
			else
				setText(player, "?", false)
			end
		end
	end
end

-- Elimination: the bubble turns red and swells (위험한 초대's red name card), then disappears.
function Billboards.alarm(userId: number)
	local gui = bubbles[userId]
	if not gui then
		return
	end
	local frame = gui:FindFirstChildOfClass("Frame") :: Frame
	local label = frame:FindFirstChild("Word") :: TextLabel
	frame.BackgroundColor3 = Color3.fromRGB(230, 40, 40)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	TweenService:Create(gui, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(6.6, 3.3),
	}):Play()
	task.delay(1.6, function()
		if bubbles[userId] == gui then
			Billboards.remove(userId)
		end
	end)
end

function Billboards.remove(userId: number)
	local gui = bubbles[userId]
	if gui then
		-- Give the default name tag back once the bubble (which carried the name) is gone.
		local humanoid = gui.Parent and gui.Parent.Parent and gui.Parent.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end
		gui:Destroy()
		bubbles[userId] = nil
	end
end

function Billboards.clear()
	for userId in bubbles do
		Billboards.remove(userId)
	end
end

return Billboards
