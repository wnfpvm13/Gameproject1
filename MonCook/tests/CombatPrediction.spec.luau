--!strict
local Prediction = require(script.Parent.Parent.src.shared.Utilities.CombatPrediction)
local Registry = require(script.Parent.Parent.src.shared.Config.Registry)
local Motion = require(script.Parent.Parent.src.shared.Utilities.CombatAnimation)
return function(): number
	local count = 0
	local function check(test: () -> ()) test(); count += 1 end
	local function fixture(): any return Prediction.new(Registry.Definitions, 1.5) end
	check(function()
		local p=fixture(); local a=p:Plan(1,"Basic",10,"StarterCleaver")
		assert(a and a.Predicted and a.StartedAt==10 and math.abs(a.WindowStartAt-10.12)<1e-8)
		assert(a.Damage==nil and a.PartPower==nil and a.HitTargets==nil)
		assert(p:Plan(2,"Basic",10.6,"StarterCleaver")==nil) -- awaiting authority
	end)
	check(function()
		local p=fixture(); local a=p:Plan(1,"Basic",0,"StarterCleaver")
		a.Predicted=nil; p:Resolve(1,{Ok=true,Action=a,DodgeReadyAt=0})
		assert(p:Plan(2,"Basic",.5,"StarterCleaver").ComboIndex==2)
	end)
	check(function()
		local p=fixture(); p:Plan(1,"Heavy",0,"StarterCleaver")
		local handled,a=p:Resolve(1,{Ok=false,Error="Busy"});assert(handled and a==nil)
		assert(p:Plan(2,"Basic",.1,"StarterCleaver").ComboIndex==1)
	end)
	check(function()
		local p=fixture();p:Plan(1,"Basic",0,"StarterCleaver");assert(p:Expire(1.5))
		local next=p:Plan(2,"Heavy",1.6,"StarterCleaver")
		assert(not p:Resolve(1,{Ok=false}) and p.Action==next)
	end)
	check(function()
		local p=fixture();local a=p:Plan(1,"Dodge",0,"StarterCleaver")
		assert(a.WindowStartAt==nil and a.EndAt==.24)
		p:Resolve(1,{Ok=true,Action=a,DodgeReadyAt=1.4})
		assert(p:Plan(2,"Dodge",.5,"StarterCleaver")==nil and p:Plan(2,"Dodge",1.4,"StarterCleaver"))
	end)
	check(function()
		local p=fixture();p:Plan(1,"Heavy",0,"StarterCleaver");p:Reset()
		assert(p.Pending==nil and p.Action==nil and p.Combo==0 and p.DodgeReadyAt==0)
	end)
	check(function()
		local heavy=Motion.player("Heavy",0,.40,.42,.20,.38)
		local finish=Motion.player("Basic",3,.19,.20,.20,.20)
		assert(heavy.LeftKnee.Pitch>.5 and heavy.RootJoint.Y<-.15 and finish.RightHip.Pitch<0)
		local dodge=Motion.player("Dodge",0,.12,.24,0,0)
		assert(dodge.RightKnee.Pitch>.8 and dodge.LeftAnkle.Pitch<0)
		local rest=Motion.player("Heavy",0,1.1,.42,.20,.38);assert(next(rest.LeftHip)==nil)
	end)
	return count
end
