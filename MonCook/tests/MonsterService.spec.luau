--!strict
local Service = require(script.Parent.Parent.src.server.Services.MonsterService)
local Registry = require(script.Parent.Parent.src.shared.Config.Registry)
local Math = require(script.Parent.Parent.src.shared.Utilities.HuntingMath)
local function clone(value: any): any
	if type(value) ~= "table" then return value end
	local result = {}; for key, child in value do result[key] = clone(child) end; return result
end
return function(): number
	local count = 0
	local function check(_name: string, test: () -> ()) test(); count += 1 end
	local function fixture(): (any, any, any, any)
		local definitions = clone(Registry.Definitions)
		definitions.Spawn.GreenwoodOutskirts.MaxAlive = 1
		local clock, events = { Now = 0, NextId = 0 }, {}
		local service = Service.new({ Definitions = definitions, Geometry = Math, Now = function() return clock.Now end,
			NewId = function() clock.NextId += 1; return "monster-" .. tostring(clock.NextId) end,
			OnEvent = function(event: any) table.insert(events, event) end })
		service:Tick({}, 0.05)
		return service, clock, events, definitions
	end
	local function player(position: any, id: number?): any
		return { ActorId = id or 1, Position = clone(position), Alive = true, Location = "World" }
	end
	local function hits(events: any, kind: string): number
		local total = 0; for _, event in events do if event.Kind == kind then total += 1 end end; return total
	end
	local function strike(service: any, id: string, attackId: string, actorId: number, damage: number, horn: boolean?, power: number?): any
		return service:ApplyHit(id, actorId, { AttackId = attackId, Damage = damage, Horn = horn, PartPower = power or 0 })
	end
	local function windup(service: any, clock: any, actor: any): any
		service:Tick({ actor }, 0.05)
		clock.Now += 1; service:Tick({ actor }, 0.05)
		clock.Now += 0.05; service:Tick({ actor }, 0.05)
		return service:Get("monster-1")
	end
	check("budget and idle spawn", function()
		local s = fixture(); assert(#s:List() == 1 and s:Get("monster-1").State == "Idle")
		for _ = 1, 50 do s:Tick({}, 0.05) end
		assert(#s:List() == 1)
	end)
	check("snapshot isolation", function()
		local s = fixture(); local m = s:Get("monster-1"); m.BodyHP = 0; m.Position.X = 999
		assert(s:Get("monster-1").BodyHP == 140 and s:Get("monster-1").Position.X ~= 999)
	end)
	check("idle to roam and movement", function()
		local s, clock = fixture(); clock.Now = 1.3; s:Tick({}, 0.05)
		local before = s:Get("monster-1"); assert(before.State == "Roam")
		clock.Now += 0.05; s:Tick({}, 0.05)
		assert(Math.distance(before.Position, s:Get("monster-1").Position) > 0)
		clock.Now = 5; s:Tick({}, 0.05); assert(s:Get("monster-1").State == "Idle")
	end)
	check("alert chase then headbutt telegraph", function()
		local s, clock = fixture(); local m = s:Get("monster-1")
		local p = player(Math.advance(m.Position, m.Facing, 4))
		local state = windup(s, clock, p)
		assert(state.State == "Windup" and state.AttackType == "Headbutt")
	end)
	check("charge cannot start instantly", function()
		local s, clock, events = fixture(); local m = s:Get("monster-1")
		local p = player(Math.advance(m.Position, m.Facing, 14))
		local state = windup(s, clock, p); assert(state.State == "Windup" and state.AttackType == "Charge")
		local position = clone(state.Position); clock.Now += 0.7; s:Tick({ p }, 0.05)
		assert(s:Get("monster-1").State == "Windup" and Math.distance(position, s:Get("monster-1").Position) == 0)
		assert(hits(events, "AttackHit") == 0)
	end)
	check("charge locks direction when target sidesteps", function()
		local s, clock = fixture(); local m = s:Get("monster-1")
		local p = player(Math.advance(m.Position, m.Facing, 14)); local state = windup(s, clock, p)
		p.Position.X += 10; clock.Now += 0.5; s:Tick({ p }, 0.05)
		assert(s:Get("monster-1").Facing.X == state.Facing.X and s:Get("monster-1").Facing.Z == state.Facing.Z)
	end)
	check("charge moves and recovers", function()
		local s, clock = fixture(); local m = s:Get("monster-1"); local p = player(Math.advance(m.Position, m.Facing, 14))
		windup(s, clock, p); clock.Now += 1.3; s:Tick({ p }, 0.05)
		assert(s:Get("monster-1").State == "Attack")
		local before = s:Get("monster-1").Position; clock.Now += 0.05; s:Tick({ p }, 0.05)
		assert(Math.distance(before, s:Get("monster-1").Position) > 0)
		clock.Now += 1; s:Tick({ p }, 0.05); assert(s:Get("monster-1").State == "Recover")
	end)
	check("one headbutt damage per player per attack", function()
		local s, clock, events = fixture(); local m = s:Get("monster-1"); local p = player(Math.advance(m.Position, m.Facing, 4))
		windup(s, clock, p); clock.Now += 0.75; s:Tick({ p }, 0.05)
		clock.Now += 0.12; s:Tick({ p }, 0.05); clock.Now += 0.05; s:Tick({ p }, 0.05)
		assert(hits(events, "AttackHit") == 1)
	end)
	check("dodge position avoids headbutt", function()
		local s, clock, events = fixture(); local m = s:Get("monster-1"); local p = player(Math.advance(m.Position, m.Facing, 4))
		windup(s, clock, p); p.Position.X += 12; clock.Now += 0.75; s:Tick({ p }, 0.05)
		clock.Now += 0.12; s:Tick({ p }, 0.05); assert(hits(events, "AttackHit") == 0)
	end)
	check("dead restaurant and ineligible actors cannot alert", function()
		local s = fixture(); local p = player(s:Get("monster-1").Position)
		p.Alive = false; s:Tick({ p }, 0.05); assert(s:Get("monster-1").State == "Idle")
		p.Alive, p.Location = true, "Restaurant"; s:Tick({ p }, 0.05); assert(s:Get("monster-1").State == "Idle")
		p.Location, p.Eligible = "World", false; s:Tick({ p }, 0.05); assert(s:Get("monster-1").State == "Idle")
	end)
	check("leash returns toward spawn", function()
		local s, clock = fixture(); local m = s:Get("monster-1"); local p = player(Math.advance(m.Position, m.Facing, 4))
		s:Tick({ p }, 0.05); clock.Now = 1; s:Tick({ p }, 0.05)
		s._monsters["monster-1"].Position.X += 100; s:Tick({ p }, 0.05)
		assert(s:Get("monster-1").State == "Roam")
	end)
	check("body damage and contributor", function()
		local s = fixture(); assert(strike(s, "monster-1", "a", 1, 12))
		assert(s:Get("monster-1").BodyHP == 128 and s:Get("monster-1").HornHP == 80)
		assert(#s:Eligible("monster-1") == 1 and s:Eligible("monster-1")[1] == 1)
	end)
	check("part hit records separate damage without instant kill", function()
		local s = fixture(); strike(s, "monster-1", "a", 1, 20, true, 55)
		assert(s:Get("monster-1").BodyHP == 120 and s:Get("monster-1").HornHP == 25)
		assert(s:Get("monster-1").Contributors[1].PartDamage == 55)
	end)
	check("horn breaks exactly once and hitbox state stays disabled", function()
		local s, _, events = fixture(); strike(s, "monster-1", "a", 1, 20, true, 55)
		strike(s, "monster-1", "b", 1, 20, true, 55); strike(s, "monster-1", "c", 1, 12, true, 8)
		assert(hits(events, "PartBroken") == 1 and s:Get("monster-1").HornBroken and s:Get("monster-1").HornHP == 0)
		assert(s:Get("monster-1").Contributors[1].PartDamage == 80)
		assert(s:Get("monster-1").BodyHP > 0 and s:Get("monster-1").State == "Stagger")
	end)
	check("duplicate trusted hit cannot affect body or horn", function()
		local s = fixture(); strike(s, "monster-1", "same", 1, 20, true, 55)
		assert(not strike(s, "monster-1", "same", 1, 20, true, 55))
		assert(s:Get("monster-1").BodyHP == 120 and s:Get("monster-1").HornHP == 25)
	end)
	check("two independent contributors and nonparticipant excluded", function()
		local s = fixture(); strike(s, "monster-1", "a", 1, 12); strike(s, "monster-1", "b", 2, 12)
		local eligible = s:Eligible("monster-1"); assert(#eligible == 2 and eligible[1] == 1 and eligible[2] == 2)
	end)
	check("expired contribution is excluded", function()
		local s, clock = fixture(); strike(s, "monster-1", "a", 1, 12); clock.Now = 91
		assert(#s:Eligible("monster-1") == 0)
		strike(s, "monster-1", "b", 2, 12); assert(s:Eligible("monster-1")[1] == 2)
	end)
	check("part reward recipients fixed at break time", function()
		local s = fixture(); strike(s, "monster-1", "a", 1, 20, true, 80)
		strike(s, "monster-1", "b", 2, 12)
		local reward = s:PendingRewards()[1]; assert(reward.Kind == "PartBroken" and #reward.Members == 1 and reward.Members[1] == 1)
	end)
	check("death once and repeated dead attack rejected", function()
		local s, _, events = fixture(); strike(s, "monster-1", "a", 1, 140)
		assert(s:Get("monster-1").State == "Dead" and hits(events, "Dead") == 1)
		assert(not strike(s, "monster-1", "b", 2, 999)); assert(hits(events, "Dead") == 1)
	end)
	check("simultaneous horn and death produce separate events", function()
		local s = fixture(); strike(s, "monster-1", "a", 1, 140, true, 80)
		local rewards = s:PendingRewards(); assert(#rewards == 2 and rewards[1].EventId ~= rewards[2].EventId)
	end)
	check("reward outbox survives presentation failure and despawn", function()
		local s, clock = fixture(); s.OnEvent = function() error("presentation unavailable") end
		strike(s, "monster-1", "a", 1, 140); clock.Now = 3; s:Tick({}, 0.05)
		local rewards = s:PendingRewards(); assert(#rewards == 1 and s:Get("monster-1") == nil)
		s:AckReward(rewards[1].EventId); assert(#s:PendingRewards() == 0)
	end)
	check("respawn delay then new identity and fresh health", function()
		local s, clock = fixture(); strike(s, "monster-1", "a", 1, 140, true, 80)
		clock.Now = 3; s:Tick({}, 0.05); assert(#s:List() == 0)
		clock.Now = 6.9; s:Tick({}, 0.05); assert(#s:List() == 0)
		clock.Now = 7.1; s:Tick({}, 0.05)
		assert(#s:List() == 1 and s:Get("monster-2").BodyHP == 140 and not s:Get("monster-2").HornBroken)
		assert(#s:Eligible("monster-2") == 0)
	end)
	check("movement callback prevents traversing obstacles", function()
		local s, clock = fixture(); s.Move = function(_id: string, from: any, _to: any): any return from end
		clock.Now = 1.3; s:Tick({}, 0.05); local before = s:Get("monster-1").Position
		clock.Now = 1.4; s:Tick({}, 0.05); assert(Math.distance(before, s:Get("monster-1").Position) == 0)
	end)
	check("invalid values rejected without damage", function()
		local s = fixture(); assert(not pcall(function() strike(s, "monster-1", "a", 1, 0/0) end))
		assert(not pcall(function() s:Tick({}, -1) end)); assert(s:Get("monster-1").BodyHP == 140)
	end)
	return count
end
