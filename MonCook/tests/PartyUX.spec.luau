--!strict
-- Same-server party finder, consent labels, and direct invitation contracts.
-- Native GUI/input and Roblox player presence are verified separately in Studio.
local Party = require(script.Parent.Parent.src.server.Services.PartyService)

local function rejects(callback: () -> ())
	local ok = pcall(callback)
	assert(not ok, "Expected operation to reject")
end

local function fixture(overrides: any?): (any, (number) -> ())
	local nextId, now = 0, 100
	local options: any = {
		MaxMembers = 4,
		InviteTTLSeconds = 30,
		Now = function(): number return now end,
		NewId = function(): string
			nextId += 1
			return string.format("party-ux-%03d", nextId)
		end,
	}
	for key, value in overrides or {} do options[key] = value end
	return Party.new(options), function(value: number) now = value end
end

local function partyWithMembers(service: any): any
	local party = service:Create(1)
	service:JoinPublic(2, party.PartyId)
	service:JoinPublic(3, party.PartyId)
	return party
end

local function fullyReady(service: any): any
	local proposal = service:Propose(1)
	local snapshot = service:Get(1)
	for _, userId in snapshot.MemberUserIds do
		if userId ~= 1 then service:Respond(userId, proposal.ProposalId, true) end
	end
	service:Ready(1, proposal.ProposalId)
	return proposal
end

local function cleared(snapshot: any)
	assert(snapshot.ProposalId == nil and next(snapshot.ReadyStates) == nil)
	assert(snapshot.Status == "Forming")
end

return function(): number
	local passed = 0
	local function check(_name: string, callback: () -> ())
		callback()
		passed += 1
	end
	check("default public party metadata and finder join", function()
		local service = fixture()
		local created = service:Create(1)
		assert(created.Visibility == "Public" and created.Activity == "Free")
		assert(created.TargetId == "Free" and created.Status == "Forming" and created.MaxMembers == 4)
		assert(next(created.ReadyStates) == nil)
		local finder = service:ListPublic()
		assert(#finder == 1 and finder[1].PartyId == created.PartyId)
		local joined = service:JoinPublic(2, finder[1].PartyId)
		assert(#joined.MemberUserIds == 2 and joined.MemberUserIds[2] == 2)
		assert(service:Get(2).PartyId == created.PartyId)
	end)
	check("finder sorts and copies all runtime fields", function()
		local service = fixture()
		local first = service:Create(1, { Activity = "Expedition", TargetId = "TwinOgre" })
		local second = service:Create(2, { Activity = "Restaurant", TargetId = "HostRestaurant" })
		service:Create(3, { Visibility = "Private" })
		local listed = service:ListPublic()
		assert(#listed == 2 and listed[1].PartyId == first.PartyId and listed[2].PartyId == second.PartyId)
		assert(listed[1].Activity == "Expedition" and listed[1].TargetId == "TwinOgre")
		listed[1].Visibility = "Private"
		listed[1].MemberUserIds[1] = 99
		listed[1].ReadyStates[1] = "Stayed"
		local fresh = service:ListPublic()
		assert(fresh[1].Visibility == "Public" and fresh[1].MemberUserIds[1] == 1)
		assert(next(fresh[1].ReadyStates) == nil)
	end)
	check("private parties hide and reject direct ID bypass", function()
		local service = fixture()
		local private = service:Create(1, { Visibility = "Private", Activity = "SharedHunt", TargetId = "Greenwood" })
		assert(#service:ListPublic() == 0)
		rejects(function() service:JoinPublic(2, private.PartyId) end)
		rejects(function() service:Join(2, private.PartyId) end)
		assert(#service:Get(1).MemberUserIds == 1 and service:Get(2) == nil)
		local invitation = service:Invite(1, 2)
		local joined = service:RespondInvite(2, invitation.InviteId, true)
		assert(joined.PartyId == private.PartyId and #joined.MemberUserIds == 2)
		assert(#service:ListPublic() == 0)
	end)
	check("finder join and invited join enforce capacity", function()
		local service = fixture({ MaxMembers = 2 })
		local created = service:Create(1)
		local invitation = service:Invite(1, 3)
		service:JoinPublic(2, created.PartyId)
		rejects(function() service:JoinPublic(3, created.PartyId) end)
		rejects(function() service:RespondInvite(3, invitation.InviteId, true) end)
		assert(service:Get(3) == nil and #service:Get(1).MemberUserIds == 2)
		assert(service:ListPublic()[1].MaxMembers == 2)
	end)
	check("only leader controls visibility activity status or invitations", function()
		local service = fixture()
		local created = service:Create(1)
		service:JoinPublic(2, created.PartyId)
		rejects(function() service:SetVisibility(2, "Private") end)
		rejects(function() service:SetActivity(2, "Expedition", "TwinOgre") end)
		rejects(function() service:SetStatus(2, "Closed") end)
		rejects(function() service:Invite(2, 3) end)
		rejects(function() service:SetVisibility(3, "Private") end)
		assert(service:Get(1).Visibility == "Public" and service:Get(1).Activity == "Free")
	end)
	check("ready labels distinguish selected waiting and staying members", function()
		local service = fixture()
		partyWithMembers(service)
		local proposal = service:Propose(1)
		local pending = service:Get(1)
		assert(pending.Status == "ReadyCheck" and pending.ReadyStates[1] == "Joined")
		assert(pending.ReadyStates[2] == "Waiting" and pending.ReadyStates[3] == "Waiting")
		rejects(function() service:Ready(1, proposal.ProposalId) end)
		service:Respond(2, proposal.ProposalId, true)
		service:Respond(3, proposal.ProposalId, false)
		local responded = service:Get(3)
		assert(responded.ReadyStates[2] == "Joined" and responded.ReadyStates[3] == "Stayed")
		local selected = service:Ready(1, proposal.ProposalId)
		assert(#selected == 2 and selected[1] == 1 and selected[2] == 2)
		responded.ReadyStates[3] = "Joined"
		assert(service:Get(1).ReadyStates[3] == "Stayed")
		service:FinishProposal(1, proposal.ProposalId)
		cleared(service:Get(1))
	end)
	check("visibility changes reset consent and invalidate invitations", function()
		local service = fixture()
		partyWithMembers(service)
		local invitation = service:Invite(1, 4)
		local proposal = service:Propose(1)
		service:Respond(2, proposal.ProposalId, true)
		local changed = service:SetVisibility(1, "Private")
		cleared(changed)
		assert(changed.Visibility == "Private" and #service:ListPublic() == 0)
		rejects(function() service:Respond(3, proposal.ProposalId, true) end)
		rejects(function() service:RespondInvite(4, invitation.InviteId, true) end)
		assert(#service:GetInvites(4) == 0)
		service:SetVisibility(1, "Public")
		assert(#service:ListPublic() == 1)
	end)
	check("activity changes reset consent and stale invitations", function()
		local service = fixture()
		partyWithMembers(service)
		local invitation = service:Invite(1, 4)
		local proposal = service:Propose(1)
		local changed = service:SetActivity(1, "Expedition", "TwinOgre")
		assert(changed.Activity == "Expedition" and changed.TargetId == "TwinOgre")
		cleared(changed)
		rejects(function() service:Ready(1, proposal.ProposalId) end)
		rejects(function() service:RespondInvite(4, invitation.InviteId, true) end)
	end)
	check("membership changes clear displayed ready state", function()
		local service = fixture()
		local created = partyWithMembers(service)
		local proposal = service:Propose(1)
		service:JoinPublic(4, created.PartyId)
		cleared(service:Get(1))
		rejects(function() service:Respond(2, proposal.ProposalId, true) end)
		service:Propose(1)
		service:Leave(4)
		cleared(service:Get(1))
	end)
	check("invitation identity expiry and snapshot isolation", function()
		local service, clock = fixture()
		local created = service:Create(1, { Visibility = "Private" })
		local invitation = service:Invite(1, 2)
		assert(invitation.PartyId == created.PartyId and invitation.LeaderUserId == 1)
		assert(invitation.TargetUserId == 2 and invitation.ExpiresAt == 130)
		invitation.TargetUserId = 99
		local listed = service:GetInvites(2)
		assert(#listed == 1 and listed[1].TargetUserId == 2)
		listed[1].ExpiresAt = 999
		listed[1].PartyId = "tampered"
		clock(129)
		assert(#service:GetInvites(2) == 1 and service:GetInvites(2)[1].ExpiresAt == 130)
		clock(130)
		assert(#service:GetInvites(2) == 0)
		rejects(function() service:RespondInvite(2, invitation.InviteId, true) end)
		assert(service:Get(2) == nil)
	end)
	check("invitation list sorting duplicates and expiry replacement", function()
		local service, clock = fixture()
		service:Create(1)
		service:Create(3)
		local first, second = service:Invite(1, 2), service:Invite(3, 2)
		local invites = service:GetInvites(2)
		assert(#invites == 2 and invites[1].InviteId == first.InviteId and invites[2].InviteId == second.InviteId)
		rejects(function() service:Invite(1, 2) end)
		clock(130)
		local replacement = service:Invite(1, 2)
		assert(replacement.InviteId ~= first.InviteId and replacement.ExpiresAt == 160)
		assert(#service:GetInvites(2) == 1)
	end)
	check("invitation target authority and strict accept intent", function()
		local service = fixture()
		service:Create(1, { Visibility = "Private" })
		local invitation = service:Invite(1, 2)
		rejects(function() service:RespondInvite(3, invitation.InviteId, true) end)
		rejects(function() service:RespondInvite(1, invitation.InviteId, false) end)
		rejects(function() service:RespondInvite(2, invitation.InviteId, "accept") end)
		rejects(function() service:Invite(1, 1) end)
		rejects(function() service:Invite(1, 0) end)
		assert(#service:GetInvites(2) == 1)
		assert(service:RespondInvite(2, invitation.InviteId, false) == nil)
		assert(#service:GetInvites(2) == 0 and service:Get(2) == nil)
		rejects(function() service:RespondInvite(2, invitation.InviteId, true) end)
	end)
	check("successful invitation consumes other invitations and forbids replay", function()
		local service = fixture()
		local first = service:Create(1, { Visibility = "Private" })
		service:Create(3, { Visibility = "Private" })
		local accepted, stale = service:Invite(1, 2), service:Invite(3, 2)
		local joined = service:RespondInvite(2, accepted.InviteId, true)
		assert(joined.PartyId == first.PartyId and #service:GetInvites(2) == 0)
		rejects(function() service:RespondInvite(2, accepted.InviteId, true) end)
		rejects(function() service:RespondInvite(2, stale.InviteId, true) end)
		rejects(function() service:Invite(3, 2) end)
		assert(#service:Get(1).MemberUserIds == 2)
	end)
	check("public joining consumes target invitations", function()
		local service = fixture()
		local public = service:Create(1)
		service:Create(3, { Visibility = "Private" })
		local invitation = service:Invite(3, 2)
		service:JoinPublic(2, public.PartyId)
		assert(#service:GetInvites(2) == 0)
		rejects(function() service:RespondInvite(2, invitation.InviteId, true) end)
	end)
	check("leader departure invalidates prior leader invitations", function()
		local service = fixture()
		local created = service:Create(1)
		service:JoinPublic(2, created.PartyId)
		local invitation = service:Invite(1, 3)
		service:Leave(1)
		assert(service:Get(2).LeaderUserId == 2 and #service:GetInvites(3) == 0)
		rejects(function() service:RespondInvite(3, invitation.InviteId, true) end)
		local replacement = service:Invite(2, 3)
		assert(replacement.LeaderUserId == 2)
		service:RespondInvite(3, replacement.InviteId, true)
		assert(service:Get(3).LeaderUserId == 2)
	end)
	check("active party locks joining mutations and invites but permits disconnect", function()
		local service = fixture()
		local created = partyWithMembers(service)
		local invitation = service:Invite(1, 4)
		local proposal = fullyReady(service)
		service:SetStatus(1, "InActivity")
		assert(service:Get(1).Status == "InActivity" and service:Get(1).ProposalId == nil)
		rejects(function() service:JoinPublic(4, created.PartyId) end)
		rejects(function() service:Join(4, created.PartyId) end)
		rejects(function() service:RespondInvite(4, invitation.InviteId, true) end)
		rejects(function() service:Invite(1, 4) end)
		rejects(function() service:Propose(1) end)
		rejects(function() service:SetVisibility(1, "Private") end)
		rejects(function() service:SetActivity(1, "Restaurant", "HostRestaurant") end)
		rejects(function() service:Ready(1, proposal.ProposalId) end)
		service:Leave(1)
		local remaining = service:Get(2)
		assert(remaining.Status == "InActivity" and remaining.LeaderUserId == 2)
		assert(#remaining.MemberUserIds == 2 and next(remaining.ReadyStates) == nil)
	end)
	check("closed parties disappear and reject all new engagement", function()
		local service = fixture()
		local created = service:Create(1)
		local invitation = service:Invite(1, 2)
		service:Propose(1)
		local closed = service:SetStatus(1, "Closed")
		assert(closed.Status == "Closed" and closed.ProposalId == nil and next(closed.ReadyStates) == nil)
		assert(#service:ListPublic() == 0 and #service:GetInvites(2) == 0)
		rejects(function() service:JoinPublic(2, created.PartyId) end)
		rejects(function() service:Join(2, created.PartyId) end)
		rejects(function() service:Invite(1, 2) end)
		rejects(function() service:Propose(1) end)
		rejects(function() service:SetVisibility(1, "Private") end)
		rejects(function() service:SetActivity(1, "Free", "Free") end)
		rejects(function() service:RespondInvite(2, invitation.InviteId, true) end)
		service:Leave(1)
		assert(service:Get(1) == nil)
	end)
	check("status and settings validate without corrupting existing state", function()
		local service = fixture()
		service:Create(1)
		rejects(function() service:SetVisibility(1, "Hidden") end)
		rejects(function() service:SetActivity(1, "Raid", "Dragon") end)
		rejects(function() service:SetActivity(1, "Expedition", "") end)
		rejects(function() service:SetActivity(1, "Expedition", string.rep("x", 129)) end)
		rejects(function() service:SetStatus(1, "Teleporting") end)
		rejects(function() service:SetStatus(1, "ReadyCheck") end)
		cleared(service:Get(1))
		service:Propose(1)
		local ready = service:SetStatus(1, "ReadyCheck")
		assert(ready.Status == "ReadyCheck")
		service:SetStatus(1, "Forming")
		cleared(service:Get(1))
		rejects(function() service:Create(2, { Visibility = "Hidden" }) end)
		rejects(function() service:Create(2, { Activity = "Raid" }) end)
		rejects(function() service:Create(2, { Visibility = false }) end)
		rejects(function() service:Create(2, { Activity = false }) end)
		rejects(function() service:Create(2, { TargetId = false }) end)
		rejects(function() service:Create(2, { Status = "InActivity" }) end)
		assert(service:Get(2) == nil)
	end)
	check("injected activity target validator constrains creation and changes", function()
		local service = fixture({
			ValidActivityTarget = function(activity: string, target: string): boolean
				return (activity == "Free" and target == "Free")
					or (activity == "Expedition" and target == "TwinOgre")
			end,
		})
		service:Create(1)
		rejects(function() service:SetActivity(1, "Expedition", "UnconfiguredBoss") end)
		rejects(function() service:Create(2, { Activity = "Restaurant", TargetId = "HostRestaurant" }) end)
		assert(service:Get(1).Activity == "Free" and service:Get(2) == nil)
		local changed = service:SetActivity(1, "Expedition", "TwinOgre")
		assert(changed.Activity == "Expedition" and changed.TargetId == "TwinOgre")
	end)
	return passed
end
