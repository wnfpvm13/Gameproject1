{
  "name": "TrainBrawl",
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "TrainBrawl": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "TrainBrawl": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "GameSettingsAvatar": "R15",
        "CharacterUseJumpPower": false,
        "EnableMouseLockOption": false,
        "DevComputerMovementMode": "KeyboardMouse",
        "CameraMinZoomDistance": 4
      },
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "TrainBrawlClient": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true
    }
  }
}
